		e = "MAC Address adalah alamat fisik yang tertanam di setiap NIC." },
	{ topik = "perangkat", lv = 2, q = "Perangkat yang lebih pintar dari hub karena mengirim data hanya ke komputer tujuan disebut ...", jawab = { "Switch" },
		e = "Switch mengirim data hanya ke port tujuan, sedangkan hub ke semua port." },
	{ topik = "internet", lv = 1, q = "Sistem penerjemah nama domain menjadi IP Address disingkat ... (3 huruf)", jawab = { "DNS" },
		e = "DNS = Domain Name System." },
	{ topik = "internet", lv = 2, q = "Jaringan cikal bakal internet (tahun 1969) bernama ...", jawab = { "ARPANET" },
		e = "ARPANET dibuat oleh Departemen Pertahanan Amerika Serikat." },
	{ topik = "internet", lv = 1, q = "Perusahaan penyedia layanan internet disingkat ... (3 huruf)", jawab = { "ISP" },
		e = "ISP = Internet Service Provider." },
	{ topik = "internet", lv = 2, q = "Potongan-potongan kecil data yang dikirim lewat internet disebut ...", jawab = { "Paket", "Packet", "Paket data" },
		e = "Data dipecah menjadi paket, dikirim, lalu disusun kembali di tujuan." },
	{ topik = "internet", lv = 2, q = "Versi AMAN dari protokol HTTP adalah ...", jawab = { "HTTPS" },
		e = "HTTPS = HTTP Secure, datanya dienkripsi dan ditandai ikon gembok." },
	{ topik = "koneksi", lv = 2, q = "Nama jaringan WiFi yang muncul di HP disebut ... (4 huruf)", jawab = { "SSID" },
		e = "SSID = Service Set Identifier, yaitu nama jaringan WiFi." },
	{ topik = "koneksi", lv = 2, q = "Kabel yang mengirim data menggunakan CAHAYA disebut fiber ...", jawab = { "Optic", "Optik" },
		e = "Fiber optic (serat optik) sangat cepat dan bisa menjangkau jarak jauh." },
	{ topik = "koneksi", lv = 1, q = "Fitur HP untuk membagikan internet ke perangkat lain disebut ...", jawab = { "Hotspot", "Tethering" },
		e = "Dengan hotspot/tethering, HP berfungsi seperti router WiFi kecil." },
	{ topik = "keamanan", lv = 1, q = "Proses mengubah data menjadi kode acak agar tidak terbaca disebut ...", jawab = { "Enkripsi", "Encryption" },
		e = "Enkripsi melindungi data. Untuk membacanya kembali diperlukan kunci." },
	{ topik = "keamanan", lv = 2, q = "Proses mengembalikan kode acak menjadi data asli disebut ...", jawab = { "Dekripsi", "Decryption" },
		e = "Dekripsi adalah kebalikan dari enkripsi." },
	{ topik = "keamanan", lv = 1, q = "Penipuan dengan link palsu untuk mencuri data disebut ...", jawab = { "Phishing" },
		e = "Phishing memancing korban agar memberikan data pribadi." },
	{ topik = "keamanan", lv = 2, q = "Kode rahasia sekali pakai yang dikirim lewat SMS disingkat ... (3 huruf)", jawab = { "OTP" },
		e = "OTP = One Time Password. Jangan pernah berikan kepada siapa pun!" },
}

-- Kata-kata untuk teka-teki Caesar Cipher (hanya huruf A-Z)
Questions.CipherWords = {
	{ kata = "ROUTER", topik = "perangkat", petunjuk = "perangkat pemilih rute data" },
	{ kata = "MODEM", topik = "perangkat", petunjuk = "pengubah sinyal digital <-> analog" },
	{ kata = "SWITCH", topik = "perangkat", petunjuk = "pusat jaringan yang mengirim data ke tujuan" },
	{ kata = "HUB", topik = "perangkat", petunjuk = "perangkat yang meneruskan data ke semua port" },
	{ kata = "WIFI", topik = "koneksi", petunjuk = "koneksi nirkabel dengan gelombang radio" },
	{ kata = "KABEL", topik = "koneksi", petunjuk = "media jaringan berwujud fisik" },
	{ kata = "BLUETOOTH", topik = "koneksi", petunjuk = "nirkabel jarak dekat" },
	{ kata = "SERVER", topik = "konsep", petunjuk = "komputer yang melayani" },
	{ kata = "CLIENT", topik = "konsep", petunjuk = "komputer yang meminta layanan" },
	{ kata = "WAN", topik = "konsep", petunjuk = "jaringan antarnegara" },
	{ kata = "PAKET", topik = "internet", petunjuk = "potongan kecil data" },
	{ kata = "BROWSER", topik = "internet", petunjuk = "aplikasi untuk membuka web" },
	{ kata = "DOMAIN", topik = "internet", petunjuk = "nama alamat website" },
	{ kata = "MESH", topik = "topologi", petunjuk = "topologi yang semua komputernya saling terhubung" },
	{ kata = "RING", topik = "topologi", petunjuk = "topologi berbentuk cincin" },
	{ kata = "TREE", topik = "topologi", petunjuk = "topologi bertingkat seperti pohon" },
	{ kata = "VIRUS", topik = "keamanan", petunjuk = "program jahat yang menular" },
	{ kata = "CLOUD", topik = "keamanan", petunjuk = "penyimpanan data di internet" },
	{ kata = "SANDI", topik = "keamanan", petunjuk = "nama lain password" },
	{ kata = "FIREWALL", topik = "keamanan", petunjuk = "penyaring lalu lintas data berbahaya" },
}

-- Menyamakan jawaban ketikan: huruf kecil, tanpa spasi & tanda baca
function Questions.Normalize(text)
	return (string.gsub(string.lower(tostring(text or "")), "[^%w]", ""))
end

-- Enkripsi Caesar: geser setiap huruf A-Z sebanyak shift
function Questions.Caesar(word, shift)
	return (string.gsub(string.upper(word), "%a", function(ch)
		local code = string.byte(ch) - 65
		return string.char((code + shift) % 26 + 65)
	end))
end

local function sortByLevel(list)
	local rank = {}
	for i, q in ipairs(list) do
		rank[q] = (q.lv or 1) * 1000 + i
	end
	table.sort(list, function(a, b)
		return rank[a] < rank[b]
	end)
	return list
end

-- Soal untuk mode Pecahkan Sandi: campuran soal isian & teka-teki Caesar Cipher.
-- Hasil sudah siap pakai: { text, kind = "ISIAN", answers, display, explanation, topic, level }
function Questions.PickIsian(topicId, count)
	local isianPool, cipherPool = {}, {}
	for _, q in ipairs(Questions.Isian) do
		if topicId == "campuran" or q.topik == topicId then
			table.insert(isianPool, q)
		end
	end
	for _, w in ipairs(Questions.CipherWords) do
		if topicId == "campuran" or w.topik == topicId then
			table.insert(cipherPool, w)
		end
	end
	shuffle(isianPool)
	shuffle(cipherPool)

	local cipherCount = math.min(#cipherPool, math.max(1, math.floor(count * 0.4)))
	local picked = {}
	for i = 1, cipherCount do
		local w = cipherPool[i]
		local shift = math.random(1, 3)
		local encrypted = Questions.Caesar(w.kata, shift)
		table.insert(picked, {
			lv = shift == 1 and 2 or 3,
			topic = w.topik,
			kind = "ISIAN",
			isCipher = true,
			text = "Pecahkan sandi Caesar ini! Setiap huruf sudah digeser MAJU " .. shift .. " huruf.\n"
				.. encrypted .. "\nPetunjuk: " .. w.petunjuk,
			cipherText = encrypted,
			answers = { Questions.Normalize(w.kata) },
			display = w.kata,
			explanation = "Geser setiap huruf MUNDUR " .. shift .. ": " .. encrypted .. " -> " .. w.kata .. ". Contoh: "
				.. string.sub(encrypted, 1, 1) .. " -> " .. string.sub(w.kata, 1, 1) .. ".",
		})
	end
	for i = 1, math.min(#isianPool, count - #picked) do
		local q = isianPool[i]
		local answers = {}
		for _, a in ipairs(q.jawab) do
			table.insert(answers, Questions.Normalize(a))
		end
		table.insert(picked, {
			lv = q.lv or 1,
			topic = q.topik,
			kind = "ISIAN",
			text = q.q,
			answers = answers,
			display = q.jawab[1],
			explanation = q.e or "",
		})
	end
	return sortByLevel(picked)
end

function Questions.CheckIsian(prepared, text)
	local given = Questions.Normalize(text)
	if given == "" then
		return false
	end
	for _, answer in ipairs(prepared.answers) do
		if given == answer then
			return true
		end
	end
	return false
end

return Questions
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="6">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Script" referent="7">
      <Properties>
        <string name="Name">QuizServer</string>
        <token name="RunContext">0</token>
        <string name="Source"><![CDATA[--[[
	NET QUEST - Server utama
	Alur: Siswa daftar (nama + absen) -> Alun-alun -> PETUALANGAN 4 GAME -> Juara & hadiah -> ...

	Petualangan = keempat game dimainkan berurutan, poinnya DIJUMLAHKAN menjadi POIN TOTAL:
	  1. Lari & Pilih       (Arena utara)      berdiri di kotak jawaban, kotak salah jatuh ke kolam
	  2. Kuis Kilat         (Panggung timur)   tekan tombol jawaban secepat mungkin
	  3. Lintasan Firewall  (Menara selatan)   balapan obby di langit, pilih pintu jawaban
	  4. Pecahkan Sandi     (Lab barat)        ketik jawaban & pecahkan Caesar Cipher
	Siswa yang ikut keempat game mendapat BONUS TAMAT.

	Hadiah: poin total menjadi POIN RANK (tersimpan). Poin Rank membuka gelar & PET.
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local Core = require(script:WaitForChild("Core"))
local MapBuilder = require(script:WaitForChild("MapBuilder"))
local Roster = require(script:WaitForChild("Roster"))
local ModesFolder = script:WaitForChild("Modes")

local Config, PlayerData, PetCatalog = Core.Config, Core.PlayerData, Core.PetCatalog
local ModeModules = {
	kotak = require(ModesFolder:WaitForChild("Kotak")),
	kilat = require(ModesFolder:WaitForChild("Kilat")),
	firewall = require(ModesFolder:WaitForChild("Firewall")),
	sandi = require(ModesFolder:WaitForChild("Sandi")),
}

Core.SetupRemotes()
local arena = MapBuilder.Build()
Core.arena = arena
arena:ConnectPit()
arena:StartDecorations()
Roster.Init(Core)

local remotes = Core.remotes
local settings, flags = Core.settings, Core.flags

local function settingsPayload()
	return {
		type = "Settings",
		topic = settings.topic,
		topicName = Config.GetTopic(settings.topic).name,
		mode = settings.mode,
		modeName = Config.GetMode(settings.mode).name,
		count = settings.count,
		time = settings.time,
		auto = settings.auto,
	}
end

local function broadcastSettings()
	Core.broadcast(settingsPayload())
end

---------------------------------------------------------------------
-- GURU
---------------------------------------------------------------------
local function isTeacher(player)
	if RunService:IsStudio() and Config.StudioEveryoneTeacher then
		return true
	end
	if table.find(Config.TeacherUserIds, player.UserId) then
		return true
	end
	for _, name in ipairs(Config.TeacherNames) do
		if string.lower(name) == string.lower(player.Name) then
			return true
		end
	end
	if game.CreatorType == Enum.CreatorType.User and player.UserId == game.CreatorId then
		return true
	end
	if game.CreatorType == Enum.CreatorType.Group then
		local ok, rank = pcall(function()
			return player:GetRankInGroup(game.CreatorId)
		end)
		if ok and rank >= Config.GroupTeacherMinRank then
			return true
		end
	end
	return false
end

---------------------------------------------------------------------
-- PET
---------------------------------------------------------------------
local function applyPet(player)
	local data = PlayerData.Get(player)
	local petId = data.pet
	if petId ~= "" and not PetCatalog.IsUnlocked(petId, data.xp) then
		petId = PetCatalog.Best(data.xp).id
		PlayerData.SetPet(player, petId)
	end
	player:SetAttribute("PoinRank", data.xp)
	player:SetAttribute("Pet", petId)
end

remotes.EquipPet.OnServerEvent:Connect(function(player, petId)
	local data = PlayerData.Get(player)
	if type(petId) == "string" and PetCatalog.IsUnlocked(petId, data.xp) then
		PlayerData.SetPet(player, petId)
		player:SetAttribute("Pet", petId)
	elseif petId == "" then
		PlayerData.SetPet(player, "")
		player:SetAttribute("Pet", "") -- sembunyikan pet
	end
end)

---------------------------------------------------------------------
-- PEMAIN MASUK / KELUAR
---------------------------------------------------------------------
local function onCharacter(player, character)
	character:WaitForChild("Humanoid", 10)
	character:WaitForChild("Head", 10)
	Roster.ApplyMovement(player)
	Roster.ApplyTag(player)
end

local function onPlayerAdded(player)
	player:SetAttribute("IsTeacher", isTeacher(player))
	Core.stats[player] = Core.newStats()

	local leaderstats = Instance.new("Folder")
	leaderstats.Name = "leaderstats"
	for _, name in ipairs({ "Absen", "Poin", "Benar", "Poin Rank" }) do
		local value = Instance.new("IntValue")
		value.Name = name
		value.Parent = leaderstats
	end
	leaderstats.Parent = player

	player.CharacterAdded:Connect(function(character)
		onCharacter(player, character)
	end)
	if player.Character then
		task.spawn(onCharacter, player, player.Character)
	end

	PlayerData.Load(player)
	applyPet(player)
	Core.updateLeaderstats(player)
	Roster.SendProfile(player)
	if player.Character then
		Roster.ApplyTag(player)
	end
end

Players.PlayerAdded:Connect(onPlayerAdded)
for _, player in ipairs(Players:GetPlayers()) do
	task.spawn(onPlayerAdded, player)
end

Players.PlayerRemoving:Connect(function(player)
	Core.stats[player] = nil
	Core.session[player] = nil
	PlayerData.Release(player)
end)

game:BindToClose(function()
	PlayerData.SaveAll()
end)

remotes.ClientReady.OnServerEvent:Connect(function(player)
	Core.send(player, settingsPayload())
	Roster.SendProfile(player)
	if Core.adventure then
		Core.send(player, Core.adventurePayload())
	end
	if Core.snapshot then
		Core.send(player, Core.snapshot)
	end
	Core.sendStats(player)
end)

-- Jaring pengaman: pemain yang terjatuh terlalu jauh dikembalikan
task.spawn(function()
	while true do
		task.wait(1)
		for _, player in ipairs(Players:GetPlayers()) do
			local root = Core.rootOf(player)
			if root and root.Position.Y < -40 then
				local module = Core.currentMode and ModeModules[Core.currentMode.id]
				local inZone = module and Core.currentMode.id ~= "firewall"
				Core.teleport(player, inZone and module.StartCFrame(arena) or arena:GetLobbyCFrame())
			end
		end
	end
end)

-- Papan peringkat di alun-alun selalu menampilkan POIN TOTAL terbaru selama petualangan
task.spawn(function()
	while true do
		task.wait(2)
		if Core.adventure and Core.phase ~= "RoundEnd" then
			local rows = {}
			for _, player in ipairs(Core.participants()) do
				table.insert(rows, { name = Core.displayName(player), score = Core.stats[player].score })
			end
			table.sort(rows, function(a, b)
				return a.score > b.score
			end)
			arena:SetLeaderboard("POIN TOTAL • GAME " .. Core.adventure.index .. "/" .. #Core.adventure.modes, rows)
		end
	end
end)

---------------------------------------------------------------------
-- PERINTAH GURU
---------------------------------------------------------------------
remotes.TeacherCommand.OnServerEvent:Connect(function(player, command, value)
	if not player:GetAttribute("IsTeacher") then
		return
	end
	if command == "start" then
		if Core.phase == "Lobby" then
			flags.start = true
		end
	elseif command == "lock" then
		if Core.phase == "Question" or Core.phase == "Race" then
			flags.lock = true
		end
	elseif command == "stop" then
		if Core.phase ~= "Lobby" then
			flags.stop = true
		end
	elseif command == "topic" then
		if type(value) == "string" and Config.GetTopic(value).id == value then
			settings.topic = value
		end
	elseif command == "mode" then
		if type(value) == "string" and Config.GetMode(value).id == value then
			settings.mode = value
		end
	elseif command == "count" then
		if type(value) == "number" and value >= 3 and value <= 30 then
			settings.count = math.floor(value)
		end
	elseif command == "time" then
		if type(value) == "number" and value >= 5 and value <= 60 then
			settings.time = math.floor(value)
		end
	elseif command == "auto" then
		settings.auto = value == true
	elseif command == "recap" then
		Roster.PrintRecap("diminta guru")
	end
	broadcastSettings()
end)

---------------------------------------------------------------------
-- BANTUAN (50:50 / petunjuk huruf) & JAWABAN
---------------------------------------------------------------------
remotes.UseHint.OnServerInvoke = function(player)
	local st = Core.stats[player]
	if not st or not Core.isRegistered(player) then
		return nil, "Daftar dulu ya!"
	end
	if not Core.hintProvider then
		return nil, "Bantuan hanya bisa dipakai saat soal berlangsung."
	end
	if st.hints <= 0 then
		return nil, "Bantuan habis. Jawab benar " .. Config.HintEveryStreak .. "x berturut-turut untuk dapat lagi."
	end
	local result, err = Core.hintProvider(player, st)
	if not result then
		return nil, err
	end
	st.hints -= 1
	return result, st.hints
end

remotes.Answer.OnServerEvent:Connect(function(player, questionId, pad)
	if Core.answerHandler and type(questionId) == "number" and type(pad) == "number" then
		Core.answerHandler(player, questionId, pad)
	end
end)

remotes.SubmitText.OnServerInvoke = function(player, questionId, text)
	if not Core.textHandler or type(questionId) ~= "number" or type(text) ~= "string" then
		return { ok = false, message = "Belum ada soal isian sekarang." }
	end
	return Core.textHandler(player, questionId, text)
end

---------------------------------------------------------------------
-- LOBI
---------------------------------------------------------------------
local function registeredCount()
	return #Core.participants()
end

local function waitInLobby()
	Core.phase = "Lobby"
	Core.current = nil
	Core.currentMode = nil
	Core.adventure = nil
	flags.stop, flags.lock = false, false
	arena:ResetPads(true)
	arena:SetStageQuestion(nil)
	while true do
		if flags.start then
			break
		end
		local enough = registeredCount() >= Config.MinPlayers
		if settings.auto and enough then
			local endsAt = Core.now() + Config.IntermissionTime
			Core.broadcast({ type = "Intermission", endsAt = endsAt }, true)
			local cancelled = false
			while Core.now() < endsAt and not flags.start do
				if not settings.auto or registeredCount() < Config.MinPlayers then
					cancelled = true
					break
				end
				Core.idleScreen("Berikutnya: " .. Config.GetMode(settings.mode).name .. " • Topik: " .. Config.GetTopic(settings.topic).name
					.. ". Sambil menunggu, baca Zona Materi dan lihat Taman Pet!", tostring(math.ceil(endsAt - Core.now())))
				task.wait(0.25)
			end
			if not cancelled then
				break
			end
		else
			Core.broadcast({ type = "Waiting", reason = enough and "teacher" or "players" }, true)
			Core.idleScreen(enough and "Menunggu guru menekan tombol MULAI..." or "Menunggu siswa mendaftar...")
			repeat
				task.wait(0.25)
			until flags.start or (settings.auto and registeredCount() >= Config.MinPlayers)
		end
	end
	flags.start = false
end

---------------------------------------------------------------------
-- SATU GAME
---------------------------------------------------------------------
local function ranked(list)
	table.sort(list, function(a, b)
		if a.score ~= b.score then
			return a.score > b.score
		end
		return (a.correct or 0) > (b.correct or 0)
	end)
	return list
end

-- Memainkan satu game. Mengembalikan jumlah soal yang dimainkan, atau nil jika dihentikan guru.
local function playGame(mode, index, total)
	local module = ModeModules[mode.id]
	Core.currentMode = mode
	if Core.adventure then
		Core.adventure.index = index
		Core.broadcast(Core.adventurePayload())
	end

	Core.phase = "Intro"
	if mode.id == "firewall" then
		arena:SetCourseBarrier(true)
	end
	for _, player in ipairs(Core.participants()) do
		Core.teleport(player, module.StartCFrame(arena))
	end
	local list = module.Prepare(Core)
	local before = {}
	for player, st in pairs(Core.stats) do
		before[player] = { score = st.score, correct = st.correct, answered = st.answered, attempted = st.attempted }
	end

	Core.broadcast({
		type = "ModeIntro",
		modeId = mode.id,
		modeName = mode.name,
		desc = mode.desc,
		color = mode.color,
		topicName = Config.GetTopic(settings.topic).name,
		total = #list,
		gameIndex = index,
		gameTotal = total,
		endsAt = Core.now() + Config.ModeIntroTime,
	}, true)
	Core.idleScreen((total > 1 and ("GAME " .. index .. " DARI " .. total .. ": ") or "") .. string.upper(mode.name) .. ". " .. mode.desc, "")

	local played = 0
	if Core.waitFor(Config.ModeIntroTime) then
		played = module.Run(Core, list)
	end
	Core.answerHandler, Core.textHandler, Core.hintProvider, Core.current = nil, nil, nil, nil
	if flags.stop then
		return nil
	end

	-- catat poin game ini untuk setiap siswa
	local rows = {}
	for _, player in ipairs(Core.participants()) do
		local st = Core.stats[player]
		local b = before[player] or { score = 0, correct = 0, answered = 0, attempted = 0 }
		local g = { score = st.score - b.score, correct = st.correct - b.correct, answered = st.answered - b.answered,
			attempted = st.attempted - b.attempted }
		st.games = st.games or {}
		st.games[mode.id] = g
		if g.answered > 0 then
			table.insert(rows, { player = player, name = Core.displayName(player), userId = player.UserId, score = g.score, correct = g.correct,
				total = g.answered })
		end
	end
	return played, ranked(rows)
end

-- Jeda singkat setelah satu game di Petualangan: hasil game ini + poin total sementara
local function showGameBreak(mode, index, total, gameRows)
	local totals = {}
	for _, player in ipairs(Core.participants()) do
		local st = Core.stats[player]
		if st.answered > 0 then
			table.insert(totals, { name = Core.displayName(player), userId = player.UserId, score = st.score, correct = st.correct, total = st.answered })
		end
	end
	ranked(totals)
	local nextMode = Config.GetMode(Config.AdventureOrder[index + 1])
	local publicGame, publicTotal = {}, {}
	for i = 1, math.min(8, #gameRows) do
		local r = gameRows[i]
		publicGame[i] = { name = r.name, userId = r.userId, score = r.score, correct = r.correct, total = r.total }
	end
	for i = 1, math.min(8, #totals) do
		publicTotal[i] = totals[i]
	end
	Core.phase = "Break"
	Core.broadcast({
		type = "GameEnd",
		gameIndex = index,
		gameTotal = total,
		modeName = mode.name,
		color = mode.color,
		gameRanking = publicGame,
		totalRanking = publicTotal,
		nextName = nextMode.name,
		endsAt = Core.now() + Config.GameBreakTime,
	}, true)
	for _, player in ipairs(Core.participants()) do
		local st = Core.stats[player]
		local g = st.games and st.games[mode.id]
		if g then
			Core.send(player, { type = "GameScore", gameScore = g.score, correct = g.correct, answered = g.answered, totalScore = st.score })
		end
	end
	Core.idleScreen("Hasil Game " .. index .. " • Berikutnya: " .. nextMode.name, "")
	arena:SetHallOfFame(publicTotal, "POIN TOTAL • GAME " .. index .. "/" .. total)
	return Core.waitFor(Config.GameBreakTime)
end

---------------------------------------------------------------------
-- AKHIR SESI: juara, rapor, hadiah pet, rekap
---------------------------------------------------------------------
local function topicLabel(topicId)
	return Config.GetTopic(topicId).name
end

local function finishSession(modes, totalQuestions)
	Core.phase = "RoundEnd"

	-- bonus tamat untuk yang ikut menjawab di semua game
	if #modes > 1 then
		for _, player in ipairs(Core.participants()) do
			local st = Core.stats[player]
			local all = true
			for _, mode in ipairs(modes) do
				local g = st.games and st.games[mode.id]
				if not g or g.attempted == 0 then
					all = false
				end
			end
			if all then
				st.completedAll = true
				Core.addBonus(player, Config.CompletionBonus, "Bonus tamat: kamu menyelesaikan keempat game!")
			end
		end
	end

	local ranking = {}
	for _, player in ipairs(Core.participants()) do
		local st = Core.stats[player]
		if st.answered > 0 then
			table.insert(ranking, { player = player, st = st, score = st.score, correct = st.correct })
		end
	end
	ranked(ranking)

	local publicRanking = {}
	for i, entry in ipairs(ranking) do
		table.insert(publicRanking, {
			name = Core.displayName(entry.player),
			userId = entry.player.UserId,
			score = entry.st.score,
			correct = entry.st.correct,
			total = entry.st.answered,
		})
		if i >= 10 then
			break
		end
	end
	local title = #modes > 1 and "Petualangan 4 Game" or modes[1].name
	Core.broadcast({ type = "RoundEnd", ranking = publicRanking, totalQuestions = totalQuestions, modeName = title }, true)
	arena:SetHallOfFame(publicRanking, "JUARA • " .. string.upper(title))

	for position, entry in ipairs(ranking) do
		local player, st = entry.player, entry.st
		local weak, strong
		for topicId, topicStat in pairs(st.topics) do
			local ratio = topicStat.correct / topicStat.total
			if not weak or ratio < weak.ratio then
				weak = { id = topicId, ratio = ratio, correct = topicStat.correct, total = topicStat.total }
			end
			if not strong or ratio > strong.ratio then
				strong = { id = topicId, ratio = ratio, correct = topicStat.correct, total = topicStat.total }
			end
		end
		local games = {}
		for _, mode in ipairs(modes) do
			local g = st.games and st.games[mode.id]
			table.insert(games, { name = mode.name, color = mode.color, score = g and g.score or 0, correct = g and g.correct or 0,
				answered = g and g.answered or 0 })
		end
		Core.getSession(player).rounds += 1
		local oldXp = PlayerData.Get(player).xp
		local data, rankUp = PlayerData.AddRoundResult(player, st.score, st.correct, st.answered, position == 1)
		local rank, nextRank = PlayerData.GetRank(data.xp)
		local newPets = {}
		for _, pet in ipairs(PetCatalog.NewlyUnlocked(oldXp, data.xp)) do
			table.insert(newPets, { id = pet.id, name = pet.name, rarity = pet.rarity })
		end
		if #newPets > 0 then
			PlayerData.SetPet(player, newPets[#newPets].id) -- langsung pakai pet terbaru
		end
		applyPet(player)
		local nextPet = PetCatalog.Next(data.xp)
		Core.send(player, {
			type = "Summary",
			position = position,
			players = #ranking,
			score = st.score,
			correct = st.correct,
			answered = st.answered,
			bestStreak = st.bestStreak,
			games = games,
			completedAll = st.completedAll == true,
			completionBonus = Config.CompletionBonus,
			weakTopic = weak and weak.ratio < 1 and topicLabel(weak.id) or nil,
			weakId = weak and weak.ratio < 1 and weak.id or nil,
			weakText = weak and (weak.correct .. "/" .. weak.total) or nil,
			strongTopic = strong and strong.ratio > 0 and topicLabel(strong.id) or nil,
			strongText = strong and (strong.correct .. "/" .. strong.total) or nil,
			xp = data.xp,
			title = rank.name,
			titleColor = rank.color,
			nextTitle = nextRank and nextRank.name or nil,
			nextXp = nextRank and nextRank.xp or nil,
			rankUp = rankUp,
			newPets = newPets,
			nextPetName = nextPet and nextPet.name or nil,
			nextPetXp = nextPet and nextPet.xp or nil,
		})
		Core.updateLeaderstats(player)
		Roster.ApplyTag(player)
	end
	Roster.PrintRecap(title .. " • " .. Config.GetTopic(settings.topic).name)

	-- semua kembali ke alun-alun, 3 besar naik podium
	for _, player in ipairs(Players:GetPlayers()) do
		Core.teleport(player, arena:GetLobbyCFrame())
	end
	for rank = 1, math.min(3, #ranking) do
		Core.teleport(ranking[rank].player, arena:GetPodiumCFrame(rank))
	end
	arena:CelebratePodium()
	Core.idleScreen(#ranking > 0 and ("Juara " .. title .. ": " .. Core.displayName(ranking[1].player) .. " dengan "
		.. ranking[1].st.score .. " poin!") or "Selesai!")
	Core.waitFor(Config.RoundEndTime)
end

---------------------------------------------------------------------
-- SESI (Petualangan 4 game atau satu game saja)
---------------------------------------------------------------------
local function chooseModes()
	if settings.mode == "petualangan" then
		local list = {}
		for _, id in ipairs(Config.AdventureOrder) do
			table.insert(list, Config.GetMode(id))
		end
		return list
	end
	return { Config.GetMode(settings.mode) }
end

function Core.adventurePayload()
	local adv = Core.adventure
	local names = {}
	for i, mode in ipairs(adv.modes) do
		names[i] = { name = mode.name, color = mode.color }
	end
	return { type = "Adventure", index = adv.index, games = names }
end

local function runSession()
	local modes = chooseModes()
	Core.resetRoundStats()
	Core.adventure = { modes = modes, index = 1 }
	broadcastSettings()

	local totalQuestions = 0
	for index, mode in ipairs(modes) do
		local played, rows = playGame(mode, index, #modes)
		if not played then
			break
		end
		totalQuestions += played
		if index < #modes and not showGameBreak(mode, index, #modes, rows) then
			break
		end
	end

	if flags.stop then
		Core.broadcast({ type = "Stopped" })
		arena:ResetCourse()
		for _, player in ipairs(Players:GetPlayers()) do
			Core.teleport(player, arena:GetLobbyCFrame())
		end
		return
	end
	finishSession(modes, totalQuestions)
end

-- LOOP UTAMA
task.wait(2)
while true do
	waitInLobby()
	runSession()
	arena:ResetPads(true)
	arena:SetStageQuestion(nil)
	Core.currentMode = nil
	Core.adventure = nil
	Core.broadcast({ type = "AdventureEnd" })
end
]]></string>
      </Properties>
      <Item class="ModuleScript" referent="8">
        <Properties>
          <string name="Name">Core</string>
          <string name="Source"><![CDATA[--[[
	Core: state & fungsi bersama yang dipakai semua mode permainan
	(pengiriman pesan ke client, skor, teleport, daftar peserta, dll).
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("QuizShared")

local Core = {}
Core.Config = require(Shared:WaitForChild("Config"))
Core.Questions = require(Shared:WaitForChild("Questions"))
Core.PetCatalog = require(Shared:WaitForChild("PetCatalog"))
Core.PlayerData = require(script.Parent:WaitForChild("PlayerData"))

local Config = Core.Config

Core.arena = nil
Core.remotes = {}
Core.settings = {
	topic = "campuran",
	count = Config.QuestionsPerRound,
	time = Config.QuestionTime,
	auto = Config.AutoStart,
	mode = Config.DefaultMode,
}
Core.phase = "Lobby" -- Lobby / Intro / Question / Reveal / Race / RoundEnd
Core.flags = { start = false, lock = false, stop = false }
Core.stats = {} -- [Player] = statistik ronde
Core.session = {} -- [Player] = statistik sepanjang sesi (untuk rekap guru)
Core.snapshot = nil -- pesan fase terakhir, dikirim ke pemain yang baru masuk
Core.current = nil -- soal yang sedang aktif
Core.hintProvider = nil -- fungsi bantuan untuk mode yang sedang berjalan
Core.answerHandler = nil -- penerima jawaban tombol (Kuis Kilat)
Core.textHandler = nil -- penerima jawaban ketikan (Pecahkan Sandi)
Core.currentMode = nil
Core.adventure = nil -- { modes = {...}, index = n } selama Petualangan berlangsung

local questionCounter = 0

function Core.now()
	return workspace:GetServerTimeNow()
end

function Core.SetupRemotes()
	local folder = Instance.new("Folder")
	folder.Name = "QuizRemotes"
	for _, name in ipairs({ "QuizEvent", "TeacherCommand", "ClientReady", "Answer", "EquipPet" }) do
		local remote = Instance.new("RemoteEvent")
		remote.Name = name
		remote.Parent = folder
		Core.remotes[name] = remote
	end
	for _, name in ipairs({ "UseHint", "Register", "SubmitText", "GetRoster" }) do
		local remote = Instance.new("RemoteFunction")
		remote.Name = name
		remote.Parent = folder
		Core.remotes[name] = remote
	end
	folder.Parent = ReplicatedStorage
end

function Core.broadcast(payload, keepAsSnapshot)
	if keepAsSnapshot then
		Core.snapshot = payload
	end
	Core.remotes.QuizEvent:FireAllClients(payload)
end

function Core.send(player, payload)
	Core.remotes.QuizEvent:FireClient(player, payload)
end

-- Tunggu beberapa detik. Berhenti lebih awal jika guru menekan "Hentikan" (hasil false)
-- atau jika fungsi done() bernilai true (hasil true).
function Core.waitFor(seconds, done)
	local endsAt = os.clock() + seconds
	while os.clock() < endsAt do
		if Core.flags.stop then
			return false
		end
		if done and done() then
			return true
		end
		task.wait(0.1)
	end
	return true
end

function Core.nextQuestionId()
	questionCounter += 1
	return questionCounter
end

---------------------------------------------------------------------
-- PESERTA
---------------------------------------------------------------------
function Core.isRegistered(player)
	return player:GetAttribute("Registered") == true
end

-- Siswa terdaftar yang ikut menjawab. Jika startAt diberikan, hanya yang sudah
-- terdaftar sebelum soal dimulai.
function Core.participants(startAt)
	local list = {}
	for _, player in ipairs(Players:GetPlayers()) do
		local st = Core.stats[player]
		if st and Core.isRegistered(player) and (not startAt or st.activeFrom <= startAt) then
			table.insert(list, player)
		end
	end
	return list
end

function Core.displayName(player)
	local name = player:GetAttribute("Nama")
	local absen = player:GetAttribute("Absen")
	if name and absen then
		return string.format("%02d. %s", absen, name)
	end
	return player.DisplayName
end

function Core.teleport(player, cframe)
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if root then
		root.AssemblyLinearVelocity = Vector3.zero
		character:PivotTo(cframe)
	end
end

function Core.rootOf(player)
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if root and humanoid and humanoid.Health > 0 then
		return root
	end
	return nil
end

---------------------------------------------------------------------
-- STATISTIK & SKOR
---------------------------------------------------------------------
function Core.newStats()
	return {
		score = 0,
		streak = 0,
		bestStreak = 0,
		correct = 0,
		answered = 0,
		attempted = 0, -- soal yang benar-benar dicoba (tidak termasuk yang dilewatkan)
		hints = Config.StartingHints,
		topics = {},
		choice = nil,
		choiceTime = nil,
		hintKey = nil,
		activeFrom = Core.now(),
	}
end

function Core.getSession(player)
	local s = Core.session[player]
	if not s then
		s = { correct = 0, answered = 0, score = 0, rounds = 0 }
		Core.session[player] = s
	end
	return s
end

function Core.updateLeaderstats(player)
	local st = Core.stats[player]
	local folder = player:FindFirstChild("leaderstats")
	if not st or not folder then
		return
	end
	folder.Poin.Value = st.score
	folder.Benar.Value = st.correct
	folder.Absen.Value = player:GetAttribute("Absen") or 0
	folder["Poin Rank"].Value = Core.PlayerData.Get(player).xp
end

function Core.sendStats(player)
	local st = Core.stats[player]
	if st then
		Core.send(player, { type = "Stats", score = st.score, streak = st.streak, hints = st.hints })
	end
end

function Core.resetRoundStats()
	for _, player in ipairs(Players:GetPlayers()) do
		Core.stats[player] = Core.newStats()
		Core.stats[player].activeFrom = 0
		Core.updateLeaderstats(player)
		Core.sendStats(player)
	end
end

local function mergeInto(target, extra)
	if extra then
		for key, value in pairs(extra) do
			target[key] = value
		end
	end
	return target
end

--[[
	Mencatat satu jawaban siswa dan mengirim hasilnya ke siswa tersebut.
	opts:
	  speed     (0..1) seberapa cepat menjawab (1 = sangat cepat)
	  speedMax  bonus kecepatan maksimal (default Config.MaxSpeedBonus)
	  boss      true jika soal bos (poin dikali)
	  penalty   pengurang poin (misal salah ketik di Pecahkan Sandi)
	  answered  false jika siswa tidak menjawab sama sekali
	  silent    true = tidak mengirim pesan Result
	  extra     tabel tambahan yang ikut dikirim ke client
]]
function Core.award(player, topicId, isCorrect, opts)
	opts = opts or {}
	local st = Core.stats[player]
	if not st then
		return 0
	end
	local session = Core.getSession(player)
	st.answered += 1
	session.answered += 1
	if opts.answered ~= false then
		st.attempted += 1
	end
	local topicStat = st.topics[topicId]
	if not topicStat then
		topicStat = { correct = 0, total = 0 }
		st.topics[topicId] = topicStat
	end
	topicStat.total += 1

	local gained, earnedHint = 0, false
	if isCorrect then
		st.correct += 1
		session.correct += 1
		topicStat.correct += 1
		st.streak += 1
		st.bestStreak = math.max(st.bestStreak, st.streak)
		local speed = math.clamp(opts.speed or 0, 0, 1)
		gained = Config.BasePoints
			+ math.floor((opts.speedMax or Config.MaxSpeedBonus) * speed)
			+ math.min(Config.StreakBonus * (st.streak - 1), Config.MaxStreakBonus)
			- (opts.penalty or 0)
		gained = math.max(gained, 20)
		if opts.boss then
			gained *= Config.BossMultiplier
		end
		st.score += gained
		session.score += gained
		if st.streak % Config.HintEveryStreak == 0 and st.hints < Config.MaxHints then
			st.hints += 1
			earnedHint = true
		end
	else
		st.streak = 0
	end
	Core.updateLeaderstats(player)
	if not opts.silent then
		Core.send(player, mergeInto({
			type = "Result",
			correct = isCorrect,
			answered = opts.answered ~= false,
			gained = gained,
			score = st.score,
			streak = st.streak,
			hints = st.hints,
			earnedHint = earnedHint,
			isBoss = opts.boss == true,
		}, opts.extra))
	end
	return gained
end

function Core.addBonus(player, amount, reason)
	local st = Core.stats[player]
	if not st then
		return
	end
	st.score += amount
	Core.getSession(player).score += amount
	Core.updateLeaderstats(player)
	Core.send(player, { type = "Bonus", amount = amount, reason = reason, score = st.score })
end

---------------------------------------------------------------------
-- SOAL & TAMPILAN
---------------------------------------------------------------------
function Core.correctOption(prepared)
	for _, option in ipairs(prepared.options or {}) do
		if option.pad == prepared.correctPad then
			return option
		end
	end
	return nil
end

-- Bantuan 50:50 untuk soal pilihan ganda: menghapus 2 jawaban salah
function Core.fiftyFifty(prepared, st)
	if prepared.kind ~= "PG" then
		return nil, "Bantuan 50:50 hanya untuk soal pilihan ganda."
	end
	if st.hintKey == prepared.id then
		return nil, "Bantuan sudah dipakai di soal ini."
	end
	st.hintKey = prepared.id
	local wrong = {}
	for _, option in ipairs(prepared.options) do
		if option.pad ~= prepared.correctPad then
			table.insert(wrong, option.pad)
		end
	end
	table.remove(wrong, math.random(1, #wrong))
	return { type = "5050", pads = wrong }
end

function Core.questionPayload(prepared, index, total, isBoss, endsAt, duration, extra)
	local topic = Config.GetTopic(prepared.topic)
	return mergeInto({
		type = "Question",
		id = prepared.id,
		index = index,
		total = total,
		text = prepared.text,
		kind = prepared.kind,
		options = prepared.options or {},
		endsAt = endsAt,
		duration = duration,
		topicName = topic.name,
		topicColor = topic.color,
		isBoss = isBoss,
		mode = Core.currentMode and Core.currentMode.id or "kotak",
	}, extra)
end

function Core.revealPayload(prepared, counts, extra)
	local option = Core.correctOption(prepared)
	return mergeInto({
		type = "Reveal",
		correctPad = prepared.correctPad,
		correctLetter = option and option.letter or "",
		correctText = option and option.text or prepared.display or "",
		explanation = prepared.explanation,
		counts = counts or {},
		explainEndsAt = Core.now() + Config.RevealTime + Config.ExplanationTime,
	}, extra)
end

function Core.screenQuestion(prepared, index, total, isBoss, info)
	local topic = Config.GetTopic(prepared.topic)
	Core.arena:SetScreen({
		topic = topic.name,
		number = isBoss and ("SOAL BOS  " .. index .. "/" .. total) or ("SOAL " .. index .. "/" .. total),
		question = prepared.text,
		info = info,
		accent = isBoss and Color3.fromRGB(255, 70, 70) or topic.color,
	})
end

function Core.screenReveal(prepared)
	local option = Core.correctOption(prepared)
	local answer
	if option then
		answer = (prepared.kind == "PG" and (option.letter .. ". ") or "") .. option.text
	else
		answer = prepared.display or ""
	end
	Core.arena:SetScreen({ timer = "0", info = "✔ Jawaban: " .. answer .. "\n" .. (prepared.explanation or "") })
end

function Core.idleScreen(info, timer)
	Core.arena:SetScreen({
		topic = Config.GameSubtitle,
		number = "",
		timer = timer or "",
		question = Config.GameTitle,
		info = info,
		accent = Color3.fromRGB(70, 160, 255),
	})
end

return Core
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="9">
        <Properties>
          <string name="Name">MapBuilder</string>
          <string name="Source"><![CDATA[--[[
	MapBuilder: membangun Pulau NET QUEST secara otomatis.

	Peta (dilihat dari atas, utara = -Z):

	                 [1] ARENA LARI & PILIH (utara)
	                          |
	  [4] LAB PECAHKAN SANDI --+-- ALUN-ALUN --+-- [2] PANGGUNG KUIS KILAT (timur)
	      + Jalur Zona Materi   |  (spawn, air mancur, papan peringkat, podium)
	        TAMAN PET (barat daya)
	                 [3] MENARA LINTASAN FIREWALL (selatan, lintasan di langit)

	Dunia disimpan di Workspace > ArenaKuis (+ Terrain pulau). Jika folder itu sudah ada dan
	versinya sama, dunia lama dipakai apa adanya (boleh dihias sendiri di Studio).
	Membangun dunia di mode edit (Command Bar):
	    require(game.ServerScriptService.QuizServer.MapBuilder).Build()

	ASET TOOLBOX (opsional): taruh model di ServerStorage > AsetDunia dengan nama
	Pohon, PohonKelapa, Bangku, Lampu, Batu, Semak. Jika ada, model itu dipakai menggantikan
	hiasan bawaan (pohon/bangku/lampu dari Part).
]]

local Players = game:GetService("Players")
local Lighting = game:GetService("Lighting")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerStorage = game:GetService("ServerStorage")

local Shared = ReplicatedStorage:WaitForChild("QuizShared")
local Config = require(Shared:WaitForChild("Config"))
local Materi = require(Shared:WaitForChild("Materi"))
local PetCatalog = require(Shared:WaitForChild("PetCatalog"))

local MapBuilder = {}

local WORLD_NAME = "ArenaKuis"
local WORLD_VERSION = 3
local WHITE = Color3.new(1, 1, 1)
local INK = Color3.fromRGB(24, 28, 48)
local STONE = Color3.fromRGB(228, 222, 208)
local STONE_DARK = Color3.fromRGB(196, 188, 170)
local WOOD = Color3.fromRGB(166, 120, 80)

-- warna khas tiap zona
local ZONE = {
	arena = Color3.fromRGB(64, 140, 240),
	stage = Color3.fromRGB(245, 180, 40),
	course = Color3.fromRGB(240, 100, 70),
	lab = Color3.fromRGB(60, 180, 130),
	pets = Color3.fromRGB(240, 110, 170),
}

-- ARENA 1 (Lari & Pilih)
local ARENA_Z = -150 -- garis tengah kotak jawaban
local PAD_X = { -33, -11, 11, 33 }
local PAD_SIZE = Vector3.new(22, 2, 22)
local IDLE_PAD_COLOR = Color3.fromRGB(150, 155, 175)

-- ARENA 3 (Lintasan Firewall di langit, mulai di atas menara selatan)
local COURSE = {
	startX = 12,
	y = 90,
	z = 150,
	width = 28,
	sectionLength = 56,
	gates = Config.FirewallGates,
}
COURSE.finishX = COURSE.startX + COURSE.gates * COURSE.sectionLength

local function laneZ(lane)
	return COURSE.z + (lane - 2.5) * 7
end

---------------------------------------------------------------------
-- Helper pembuat Instance
---------------------------------------------------------------------
local function make(className, props, parent)
	local inst = Instance.new(className)
	for key, value in pairs(props) do
		inst[key] = value
	end
	inst.Parent = parent
	return inst
end

local function part(props, parent)
	props.Anchored = true
	props.TopSurface = Enum.SurfaceType.Smooth
	props.BottomSurface = Enum.SurfaceType.Smooth
	if props.Material == nil then
		props.Material = Enum.Material.SmoothPlastic
	end
	return make("Part", props, parent)
end

-- silinder tegak (sumbu Y) dengan tinggi & diameter
local function column(parent, name, position, height, diameter, color, material, extra)
	local props = { Name = name, Shape = Enum.PartType.Cylinder, Size = Vector3.new(height, diameter, diameter),
		CFrame = CFrame.new(position) * CFrame.Angles(0, 0, math.rad(90)), Color = color, Material = material }
	for key, value in pairs(extra or {}) do
		props[key] = value
	end
	return part(props, parent)
end

local function surfaceGui(target, face, pixelsPerStud)
	return make("SurfaceGui", {
		Name = "Gui",
		Face = face,
		SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud,
		PixelsPerStud = pixelsPerStud,
		LightInfluence = 0,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
	}, target)
end

local function label(parent, props)
	local defaults = {
		BackgroundTransparency = 1,
		TextColor3 = WHITE,
		Font = Enum.Font.GothamBold,
		TextScaled = true,
		TextWrapped = true,
		Text = "",
	}
	for key, value in pairs(props) do
		defaults[key] = value
	end
	local maxSize = defaults.MaxTextSize
	defaults.MaxTextSize = nil
	local inst = make("TextLabel", defaults, parent)
	if maxSize then
		make("UITextSizeConstraint", { MaxTextSize = maxSize }, inst)
	end
	return inst
end

local function corner(parent, radius)
	return make("UICorner", { CornerRadius = UDim.new(0, radius) }, parent)
end

local function billboard(parent, text, color, size, offset)
	local gui = make("BillboardGui", { Name = "Label", Size = size or UDim2.fromScale(12, 3), StudsOffset = offset or Vector3.new(0, 4, 0),
		LightInfluence = 0, MaxDistance = 120 }, parent)
	label(gui, { Name = "Teks", Size = UDim2.fromScale(1, 1), Text = text, TextColor3 = color or WHITE,
		Font = Enum.Font.FredokaOne, TextStrokeTransparency = 0.25, TextStrokeColor3 = INK })
	return gui
end

local function confettiEmitter(parent)
	return make("ParticleEmitter", {
		Name = "Konfeti",
		Enabled = false,
		EmissionDirection = Enum.NormalId.Top,
		Rate = 0,
		Lifetime = NumberRange.new(2, 3.5),
		Speed = NumberRange.new(30, 50),
		SpreadAngle = Vector2.new(45, 45),
		Acceleration = Vector3.new(0, -35, 0),
		Drag = 1.5,
		Rotation = NumberRange.new(0, 360),
		RotSpeed = NumberRange.new(-300, 300),
		Size = NumberSequence.new(0.6),
		LightEmission = 0.3,
		Color = ColorSequence.new({
			ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 80, 80)),
			ColorSequenceKeypoint.new(0.25, Color3.fromRGB(255, 220, 60)),
			ColorSequenceKeypoint.new(0.5, Color3.fromRGB(80, 230, 120)),
			ColorSequenceKeypoint.new(0.75, Color3.fromRGB(70, 160, 255)),
			ColorSequenceKeypoint.new(1, Color3.fromRGB(230, 90, 255)),
		}),
	}, parent)
end

---------------------------------------------------------------------
-- ASET TOOLBOX (opsional) + hiasan bawaan
---------------------------------------------------------------------
local assetFolder = ServerStorage:FindFirstChild("AsetDunia")

local function placeAsset(slot, cframe, parent)
	local template = assetFolder and assetFolder:FindFirstChild(slot)
	if not template then
		return false
	end
	local copy = template:Clone()
	if copy:IsA("Model") or copy:IsA("BasePart") then
		copy:PivotTo(cframe)
	end
	copy.Parent = parent
	return true
end

local LEAF_COLORS = { Color3.fromRGB(96, 168, 82), Color3.fromRGB(80, 150, 72), Color3.fromRGB(120, 186, 92) }
local BLOSSOM = Color3.fromRGB(255, 182, 206)

local function tree(parent, position, scale, leafColor)
	scale = scale or 1
	if placeAsset("Pohon", CFrame.new(position) * CFrame.Angles(0, math.random() * math.pi * 2, 0), parent) then
		return
	end
	local h = 8 * scale
	column(parent, "Batang", position + Vector3.new(0, h / 2, 0), h, 1.8 * scale, Color3.fromRGB(128, 92, 64), Enum.Material.Wood)
	local color = leafColor or LEAF_COLORS[math.random(1, #LEAF_COLORS)]
	local blobs = {
		{ Vector3.new(0, h / scale + 1.2, 0), 8 },
		{ Vector3.new(2.4, h / scale - 0.6, 1.2), 5.5 },
		{ Vector3.new(-2.2, h / scale - 0.2, -1.4), 5.5 },
		{ Vector3.new(0.6, h / scale + 3.6, -0.4), 5 },
	}
	for _, b in ipairs(blobs) do
		local size = b[2] * scale
		part({ Name = "Daun", Shape = Enum.PartType.Ball, Size = Vector3.new(size, size, size), Position = position + b[1] * scale,
			Color = color, Material = Enum.Material.SmoothPlastic, CanCollide = false }, parent)
	end
end

local function palm(parent, position, angle)
	if placeAsset("PohonKelapa", CFrame.new(position) * CFrame.Angles(0, angle, 0), parent) then
		return
	end
	local lean = CFrame.new(position) * CFrame.Angles(0, angle, 0)
	local top
	for i = 0, 4 do
		local cf = lean * CFrame.Angles(math.rad(-4 * i), 0, 0) * CFrame.new(0, 2.2 + i * 2.6, -i * 0.5)
		part({ Name = "BatangKelapa", Shape = Enum.PartType.Cylinder, Size = Vector3.new(2.8, 1.5 - i * 0.12, 1.5 - i * 0.12),
			CFrame = cf * CFrame.Angles(0, 0, math.rad(90)), Color = Color3.fromRGB(150, 116, 80), Material = Enum.Material.Wood }, parent)
		top = cf
	end
	for i = 1, 7 do
		local frondAngle = i / 7 * math.pi * 2
		part({ Name = "Pelepah", Size = Vector3.new(1.4, 0.2, 7), CFrame = top * CFrame.new(0, 1.4, 0) * CFrame.Angles(0, frondAngle, 0)
			* CFrame.Angles(math.rad(-25), 0, 0) * CFrame.new(0, 0, -3.2), Color = Color3.fromRGB(80, 160, 70), CanCollide = false }, parent)
	end
end

local function bush(parent, position, scale)
	if placeAsset("Semak", CFrame.new(position), parent) then
		return
	end
	scale = scale or 1
	for i, offset in ipairs({ Vector3.new(0, 1, 0), Vector3.new(1.4, 0.8, 0.6), Vector3.new(-1.2, 0.8, -0.5) }) do
		local size = (i == 1 and 3.2 or 2.4) * scale
		part({ Name = "Semak", Shape = Enum.PartType.Ball, Size = Vector3.new(size, size, size), Position = position + offset * scale,
			Color = LEAF_COLORS[2], CanCollide = false }, parent)
	end
end

local FLOWER_COLORS = { Color3.fromRGB(255, 110, 130), Color3.fromRGB(255, 214, 90), Color3.fromRGB(190, 140, 255), Color3.fromRGB(255, 255, 255) }

local function flowerBed(parent, cframe, length)
	part({ Name = "Bedengan", Size = Vector3.new(length, 0.8, 3), CFrame = cframe * CFrame.new(0, 0.4, 0),
		Color = Color3.fromRGB(120, 92, 70), Material = Enum.Material.Ground }, parent)
	part({ Name = "Hijau", Size = Vector3.new(length - 0.4, 0.5, 2.6), CFrame = cframe * CFrame.new(0, 1, 0),
		Color = LEAF_COLORS[1], CanCollide = false }, parent)
	for i = 1, math.floor(length / 1.6) do
		local x = -length / 2 + i * 1.6 - 0.6
		part({ Name = "Bunga", Shape = Enum.PartType.Ball, Size = Vector3.new(0.9, 0.9, 0.9),
			CFrame = cframe * CFrame.new(x, 1.5, (i % 2 == 0) and 0.55 or -0.55),
			Color = FLOWER_COLORS[(i % #FLOWER_COLORS) + 1], CanCollide = false }, parent)
	end
end

local function bench(parent, cframe)
	if placeAsset("Bangku", cframe, parent) then
		return
	end
	part({ Name = "Dudukan", Size = Vector3.new(6, 0.4, 2), CFrame = cframe * CFrame.new(0, 1.6, 0), Color = WOOD, Material = Enum.Material.Wood }, parent)
	part({ Name = "Sandaran", Size = Vector3.new(6, 1.4, 0.3), CFrame = cframe * CFrame.new(0, 2.8, 0.9), Color = WOOD, Material = Enum.Material.Wood }, parent)
	for _, x in ipairs({ -2.6, 2.6 }) do
		part({ Name = "Kaki", Size = Vector3.new(0.4, 1.6, 1.8), CFrame = cframe * CFrame.new(x, 0.8, 0), Color = Color3.fromRGB(70, 72, 84),
			Material = Enum.Material.Metal }, parent)
	end
end

local function lampPost(parent, position)
	if placeAsset("Lampu", CFrame.new(position), parent) then
		return
	end
	column(parent, "TiangLampu", position + Vector3.new(0, 5, 0), 10, 0.6, Color3.fromRGB(60, 64, 78), Enum.Material.Metal)
	part({ Name = "Topi", Size = Vector3.new(1.8, 0.3, 1.8), Position = position + Vector3.new(0, 11.4, 0), Color = Color3.fromRGB(60, 64, 78),
		Material = Enum.Material.Metal }, parent)
	local bulb = part({ Name = "Bohlam", Shape = Enum.PartType.Ball, Size = Vector3.new(1.4, 1.4, 1.4), Position = position + Vector3.new(0, 10.6, 0),
		Color = Color3.fromRGB(255, 240, 205), Material = Enum.Material.Neon, CanCollide = false }, parent)
	make("PointLight", { Range = 18, Brightness = 0.8, Color = Color3.fromRGB(255, 230, 190) }, bulb)
end

local function rock(parent, position, size)
	if placeAsset("Batu", CFrame.new(position), parent) then
		return
	end
	part({ Name = "Batu", Shape = Enum.PartType.Ball, Size = Vector3.new(size, size, size), Position = position + Vector3.new(0, size * 0.2, 0),
		Color = Color3.fromRGB(150, 150, 158), Material = Enum.Material.Rock }, parent)
end

-- Gapura zona: dua tiang + papan nama bernomor (terbaca dari kedua sisi)
local function arch(parent, cframe, width, number, title, color)
	local folder = make("Folder", { Name = "Gapura" }, parent)
	for _, side in ipairs({ -1, 1 }) do
		part({ Name = "Tiang", Size = Vector3.new(2, 16, 2), CFrame = cframe * CFrame.new(side * width / 2, 8, 0), Color = WHITE }, folder)
		part({ Name = "Kepala", Size = Vector3.new(2.6, 1, 2.6), CFrame = cframe * CFrame.new(side * width / 2, 16.5, 0), Color = color }, folder)
	end
	local sign = part({ Name = "Papan", Size = Vector3.new(width + 2, 4.5, 1), CFrame = cframe * CFrame.new(0, 14.5, 0), Color = color }, folder)
	for _, face in ipairs({ Enum.NormalId.Front, Enum.NormalId.Back }) do
		local gui = surfaceGui(sign, face, 25)
		local bg = make("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = color, BorderSizePixel = 0 }, gui)
		if number then
			local badge = make("Frame", { Size = UDim2.new(0, 84, 0, 84), Position = UDim2.new(0, 14, 0.5, -42),
				BackgroundColor3 = WHITE, BorderSizePixel = 0 }, bg)
			corner(badge, 42)
			label(badge, { Size = UDim2.fromScale(1, 1), Text = tostring(number), Font = Enum.Font.FredokaOne, TextColor3 = color })
		end
		label(bg, { Size = UDim2.new(1, number and -130 or -24, 0.8, 0), Position = UDim2.new(0, number and 112 or 12, 0.1, 0),
			Text = title, Font = Enum.Font.FredokaOne, TextXAlignment = number and Enum.TextXAlignment.Left or Enum.TextXAlignment.Center })
	end
	return folder
end

-- Layar soal (ada di beberapa zona; semua layar menampilkan isi yang sama)
local function questionScreen(parent, name, cframe, size, face, accent)
	local screen = part({ Name = name, Size = size, CFrame = cframe, Color = INK }, parent)
	screen:SetAttribute("LayarKuis", true)
	local gui = surfaceGui(screen, face, 20)
	local frame = make("Frame", { Name = "Isi", Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.fromRGB(20, 26, 52),
		BorderSizePixel = 0 }, gui)
	make("UIStroke", { Thickness = 12, Color = accent, ApplyStrokeMode = Enum.ApplyStrokeMode.Border }, frame)
	local header = make("Frame", { Name = "Header", Size = UDim2.fromScale(1, 0.16), BackgroundColor3 = accent, BorderSizePixel = 0 }, frame)
	label(header, { Name = "Topik", Size = UDim2.fromScale(0.56, 0.72), Position = UDim2.fromScale(0.02, 0.14),
		TextXAlignment = Enum.TextXAlignment.Left, Text = Config.GameSubtitle })
	label(header, { Name = "Nomor", Size = UDim2.fromScale(0.24, 0.72), Position = UDim2.fromScale(0.59, 0.14), Text = "" })
	label(header, { Name = "Waktu", Size = UDim2.fromScale(0.13, 0.86), Position = UDim2.fromScale(0.85, 0.07), Text = "",
		Font = Enum.Font.FredokaOne })
	label(frame, { Name = "Pertanyaan", Size = UDim2.fromScale(0.94, 0.54), Position = UDim2.fromScale(0.03, 0.19),
		Text = Config.GameTitle, Font = Enum.Font.FredokaOne, MaxTextSize = 100 })
	label(frame, { Name = "Info", Size = UDim2.fromScale(0.94, 0.22), Position = UDim2.fromScale(0.03, 0.75),
		Text = "", Font = Enum.Font.GothamMedium, TextColor3 = Color3.fromRGB(196, 214, 255), MaxTextSize = 44 })
	return screen
end

-- Panel jawaban berwarna (papan kotak jawaban & panggung)
local function answerPanel(target, face, pps, index)
	local gui = surfaceGui(target, face, pps)
	local bg = make("Frame", { Name = "Latar", Size = UDim2.fromScale(1, 1), BackgroundColor3 = Config.PadColors[index], BorderSizePixel = 0 }, gui)
	make("UIStroke", { Thickness = 6, Color = WHITE, ApplyStrokeMode = Enum.ApplyStrokeMode.Border }, bg)
	label(bg, { Name = "Huruf", Size = UDim2.fromScale(0.2, 0.9), Position = UDim2.fromScale(0.02, 0.05), Text = Config.PadLetters[index],
		Font = Enum.Font.FredokaOne })
	label(bg, { Name = "Jawaban", Size = UDim2.fromScale(0.74, 0.7), Position = UDim2.fromScale(0.23, 0.08), Text = "", MaxTextSize = 64 })
	label(bg, { Name = "Jumlah", Size = UDim2.fromScale(0.74, 0.2), Position = UDim2.fromScale(0.23, 0.78), Text = "",
		TextXAlignment = Enum.TextXAlignment.Right, Font = Enum.Font.GothamMedium })
	return bg
end

---------------------------------------------------------------------
-- TERRAIN PULAU & PENCAHAYAAN
---------------------------------------------------------------------
local function buildTerrain()
	local terrain = workspace.Terrain
	terrain:FillBlock(CFrame.new(0, -11, 0), Vector3.new(640, 18, 640), Enum.Material.Water)
	terrain:FillCylinder(CFrame.new(0, -7, 0), 12, 236, Enum.Material.Sand)
	terrain:FillCylinder(CFrame.new(0, -6, 0), 12, 220, Enum.Material.Grass)
	-- bukit kecil di sudut-sudut pulau (jauh dari zona permainan)
	for _, hill in ipairs({ { 120, -120, 22 }, { -125, -115, 20 }, { 125, 95, 16 }, { -40, 185, 14 }, { 192, -70, 14 } }) do
		terrain:FillBall(Vector3.new(hill[1], -8, hill[2]), hill[3], Enum.Material.Grass)
	end
	-- kolam di bawah kotak jawaban (Arena 1)
	terrain:FillBlock(CFrame.new(0, -10, ARENA_Z), Vector3.new(96, 20, 28), Enum.Material.Air)
	terrain.WaterColor = Color3.fromRGB(40, 150, 200)
	terrain.WaterTransparency = 0.5
	terrain.WaterWaveSize = 0.12
	terrain.WaterWaveSpeed = 8
	pcall(function()
		terrain.Decoration = true -- rumput bergoyang
	end)
	if not terrain:FindFirstChildOfClass("Clouds") then
		make("Clouds", { Cover = 0.5, Density = 0.55, Color = WHITE }, terrain)
	end
end

local function setupLighting()
	Lighting.ClockTime = Config.ClockTime
	Lighting.Brightness = 2.2
	Lighting.Ambient = Color3.fromRGB(110, 112, 125)
	Lighting.OutdoorAmbient = Color3.fromRGB(150, 152, 165)
	Lighting.EnvironmentDiffuseScale = 0.7
	Lighting.EnvironmentSpecularScale = 0.5
	local function ensure(className, name, props)
		if not Lighting:FindFirstChild(name) then
			local effect = make(className, props, Lighting)
			effect.Name = name
		end
	end
	ensure("BloomEffect", "BloomKuis", { Intensity = 0.3, Size = 24, Threshold = 1.7 })
	ensure("ColorCorrectionEffect", "WarnaKuis", { Saturation = 0.12, Contrast = 0.06, Brightness = 0.02 })
	ensure("SunRaysEffect", "SinarKuis", { Intensity = 0.03, Spread = 0.7 })
	if not Lighting:FindFirstChildOfClass("Atmosphere") then
		make("Atmosphere", { Density = 0.24, Offset = 0.15, Color = Color3.fromRGB(205, 222, 240),
			Decay = Color3.fromRGB(120, 140, 170), Glare = 0.25, Haze = 1 }, Lighting)
	end
end

---------------------------------------------------------------------
-- ALUN-ALUN (spawn, air mancur, papan peringkat, podium)
---------------------------------------------------------------------
local function buildPlaza(world)
	local plaza = make("Folder", { Name = "Alun" }, world)
	column(plaza, "Lantai", Vector3.new(0, -0.45, 0), 1, 88, STONE, Enum.Material.Pavement)
	column(plaza, "Cincin", Vector3.new(0, 0.07, 0), 0.1, 46, STONE_DARK, Enum.Material.Pavement, { CanCollide = false })
	column(plaza, "CincinDalam", Vector3.new(0, 0.09, 0), 0.1, 42, STONE, Enum.Material.Pavement, { CanCollide = false })

	make("SpawnLocation", { Name = "Spawn", Anchored = true, Size = Vector3.new(10, 0.4, 10), Position = Vector3.new(0, 0.25, 30),
		Color = Color3.fromRGB(120, 200, 255), Material = Enum.Material.SmoothPlastic, Neutral = true, Duration = 0,
		TopSurface = Enum.SurfaceType.Smooth, BottomSurface = Enum.SurfaceType.Smooth }, plaza)

	-- air mancur + globe internet
	column(plaza, "Kolam", Vector3.new(0, 1, 0), 2, 20, Color3.fromRGB(240, 236, 228), Enum.Material.Marble)
	column(plaza, "Air", Vector3.new(0, 2.05, 0), 0.3, 17.6, Color3.fromRGB(80, 180, 235), Enum.Material.Glass,
		{ Transparency = 0.25, CanCollide = false })
	column(plaza, "Tiang", Vector3.new(0, 3.5, 0), 5, 3, Color3.fromRGB(240, 236, 228), Enum.Material.Marble)
	column(plaza, "Mangkuk", Vector3.new(0, 6.2, 0), 0.8, 7, Color3.fromRGB(240, 236, 228), Enum.Material.Marble)
	local spray = part({ Name = "Semburan", Size = Vector3.new(1, 1, 1), Position = Vector3.new(0, 7, 0), Transparency = 1,
		CanCollide = false }, plaza)
	make("ParticleEmitter", { Rate = 35, Lifetime = NumberRange.new(1, 1.5), Speed = NumberRange.new(10, 14),
		SpreadAngle = Vector2.new(20, 20), Acceleration = Vector3.new(0, -30, 0), Size = NumberSequence.new(0.45, 0.1),
		Color = ColorSequence.new(Color3.fromRGB(210, 240, 255)), Transparency = NumberSequence.new(0.2, 1),
		EmissionDirection = Enum.NormalId.Top }, spray)
	local globe = part({ Name = "GlobeInternet", Shape = Enum.PartType.Ball, Size = Vector3.new(6, 6, 6),
		Position = Vector3.new(0, 13, 0), Color = Color3.fromRGB(70, 190, 255), Material = Enum.Material.ForceField,
		CanCollide = false }, plaza)
	make("PointLight", { Range = 18, Brightness = 1.5, Color = Color3.fromRGB(70, 190, 255) }, globe)

	-- bangku menghadap air mancur (di diagonal agar jalur utama tetap lega)
	for i = 0, 3 do
		local angle = math.rad(45 + i * 90)
		local position = Vector3.new(math.sin(angle) * 15, 0, math.cos(angle) * 15)
		-- sisi depan bangku = -Z lokal, jadi -Z diarahkan ke air mancur
		bench(plaza, CFrame.lookAt(position, Vector3.new(0, 0, 0)))
	end
	for i = 0, 7 do
		local angle = math.rad(22.5 + i * 45)
		lampPost(plaza, Vector3.new(math.sin(angle) * 40, 0, math.cos(angle) * 40))
	end

	-- PAPAN PERINGKAT + PODIUM (timur laut, menghadap pusat)
	local base = CFrame.lookAt(Vector3.new(27, 0, -27), Vector3.new(0, 0, 0))
	local podium = make("Folder", { Name = "Podium" }, world)
	local board = part({ Name = "PapanPeringkat", Size = Vector3.new(24, 16, 1), CFrame = base * CFrame.new(0, 12, 0), Color = INK }, podium)
	for _, x in ipairs({ -12.6, 12.6 }) do
		part({ Name = "TiangPapan", Size = Vector3.new(1.4, 21, 1.4), CFrame = base * CFrame.new(x, 10.5, 0), Color = WHITE }, podium)
	end
	part({ Name = "AtapPapan", Size = Vector3.new(27, 1, 3), CFrame = base * CFrame.new(0, 21, 0), Color = Color3.fromRGB(255, 196, 60) }, podium)
	local gui = surfaceGui(board, Enum.NormalId.Front, 30)
	local bg = make("Frame", { Name = "Isi", Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.fromRGB(26, 30, 60), BorderSizePixel = 0 }, gui)
	local head = make("Frame", { Size = UDim2.fromScale(1, 0.17), BackgroundColor3 = Color3.fromRGB(255, 196, 60), BorderSizePixel = 0 }, bg)
	label(head, { Name = "Judul", Size = UDim2.fromScale(0.94, 0.8), Position = UDim2.fromScale(0.03, 0.1), Text = "PAPAN PERINGKAT",
		Font = Enum.Font.FredokaOne, TextColor3 = INK })
	local list = make("Frame", { Name = "Daftar", Size = UDim2.fromScale(0.94, 0.78), Position = UDim2.fromScale(0.03, 0.2),
		BackgroundTransparency = 1 }, bg)
	make("UIListLayout", { Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder }, list)
	for i = 1, 8 do
		local row = make("Frame", { Name = "Baris" .. i, LayoutOrder = i, Size = UDim2.new(1, 0, 0.115, -6),
			BackgroundColor3 = i % 2 == 0 and Color3.fromRGB(36, 42, 80) or Color3.fromRGB(44, 52, 96), BorderSizePixel = 0 }, list)
		corner(row, 8)
		label(row, { Name = "Peringkat", Size = UDim2.fromScale(0.1, 0.8), Position = UDim2.fromScale(0.01, 0.1), Text = tostring(i),
			Font = Enum.Font.FredokaOne, TextColor3 = i <= 3 and Color3.fromRGB(255, 205, 70) or WHITE })
		label(row, { Name = "Nama", Size = UDim2.fromScale(0.6, 0.7), Position = UDim2.fromScale(0.13, 0.15), Text = i == 1 and "Belum ada data" or "",
			TextXAlignment = Enum.TextXAlignment.Left, Font = Enum.Font.GothamBold })
		label(row, { Name = "Poin", Size = UDim2.fromScale(0.24, 0.7), Position = UDim2.fromScale(0.74, 0.15), Text = "",
			TextXAlignment = Enum.TextXAlignment.Right, Font = Enum.Font.GothamBlack, TextColor3 = Color3.fromRGB(255, 205, 70) })
	end
	local podiumData = {
		{ x = 0, h = 4.5, color = Color3.fromRGB(255, 205, 60), text = "1" },
		{ x = -7.5, h = 3.2, color = Color3.fromRGB(205, 212, 228), text = "2" },
		{ x = 7.5, h = 2.2, color = Color3.fromRGB(220, 140, 80), text = "3" },
	}
	for rank, data in ipairs(podiumData) do
		local block = part({ Name = "Juara" .. rank, Size = Vector3.new(7, data.h, 7), CFrame = base * CFrame.new(data.x, data.h / 2, -8),
			Color = data.color }, podium)
		confettiEmitter(block)
		label(surfaceGui(block, Enum.NormalId.Front, 30), { Size = UDim2.fromScale(1, 1), Text = data.text,
			Font = Enum.Font.FredokaOne, TextColor3 = INK })
	end

	-- papan PETUALANGAN 4 GAME (barat laut, menghadap pusat)
	local infoBase = CFrame.lookAt(Vector3.new(-27, 0, -27), Vector3.new(0, 0, 0))
	local info = part({ Name = "PapanCaraMain", Size = Vector3.new(18, 12, 0.8), CFrame = infoBase * CFrame.new(0, 9, 0), Color = WHITE }, plaza)
	for _, x in ipairs({ -9.4, 9.4 }) do
		part({ Name = "TiangInfo", Size = Vector3.new(1, 15, 1), CFrame = infoBase * CFrame.new(x, 7.5, 0), Color = WOOD,
			Material = Enum.Material.Wood }, plaza)
	end
	local infoGui = surfaceGui(info, Enum.NormalId.Front, 40)
	local infoBg = make("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.fromRGB(255, 251, 240), BorderSizePixel = 0 }, infoGui)
	label(infoBg, { Size = UDim2.fromScale(0.92, 0.16), Position = UDim2.fromScale(0.04, 0.04), Text = "PETUALANGAN 4 GAME",
		Font = Enum.Font.FredokaOne, TextColor3 = INK })
	local steps = {
		{ "1", "Lari & Pilih", "Arena utara", ZONE.arena },
		{ "2", "Kuis Kilat", "Panggung timur", ZONE.stage },
		{ "3", "Lintasan Firewall", "Menara selatan", ZONE.course },
		{ "4", "Pecahkan Sandi", "Lab barat", ZONE.lab },
	}
	for i, step in ipairs(steps) do
		local row = make("Frame", { Size = UDim2.fromScale(0.92, 0.15), Position = UDim2.fromScale(0.04, 0.06 + i * 0.16),
			BackgroundColor3 = step[4], BorderSizePixel = 0 }, infoBg)
		corner(row, 10)
		label(row, { Size = UDim2.fromScale(0.12, 0.8), Position = UDim2.fromScale(0.02, 0.1), Text = step[1], Font = Enum.Font.FredokaOne })
		label(row, { Size = UDim2.fromScale(0.5, 0.7), Position = UDim2.fromScale(0.15, 0.15), Text = step[2],
			TextXAlignment = Enum.TextXAlignment.Left, Font = Enum.Font.GothamBlack })
		label(row, { Size = UDim2.fromScale(0.32, 0.6), Position = UDim2.fromScale(0.66, 0.2), Text = step[3],
			TextXAlignment = Enum.TextXAlignment.Right, Font = Enum.Font.GothamMedium })
	end
	label(infoBg, { Size = UDim2.fromScale(0.92, 0.1), Position = UDim2.fromScale(0.04, 0.87),
		Text = "Poin dari keempat game dijumlahkan menjadi POIN TOTAL!", Font = Enum.Font.GothamBold, TextColor3 = Color3.fromRGB(90, 96, 120) })

	-- taman bunga tenggara
	local garden = CFrame.lookAt(Vector3.new(26, 0, 26), Vector3.new(0, 0, 0))
	flowerBed(plaza, garden, 12)
	flowerBed(plaza, garden * CFrame.new(0, 0, 4), 9)
end

---------------------------------------------------------------------
-- JALAN SETAPAK
---------------------------------------------------------------------
local function buildPaths(world)
	local paths = make("Folder", { Name = "Jalan" }, world)
	local color = Color3.fromRGB(214, 204, 184)
	local function slab(name, cframe, size)
		part({ Name = name, Size = size, CFrame = cframe, Color = color, Material = Enum.Material.Pavement }, paths)
		for _, side in ipairs({ -1, 1 }) do
			part({ Name = "Tepi", Size = Vector3.new(0.6, 0.7, size.Z), CFrame = cframe * CFrame.new(side * (size.X / 2 + 0.3), 0.05, 0),
				Color = STONE_DARK, Material = Enum.Material.Pavement }, paths)
		end
	end
	slab("JalanUtara", CFrame.new(0, -0.2, -79.5), Vector3.new(12, 0.6, 71))
	slab("JalanTimur", CFrame.new(70, -0.2, 0) * CFrame.Angles(0, math.rad(90), 0), Vector3.new(12, 0.6, 52))
	slab("JalanSelatan", CFrame.new(0, -0.2, 88), Vector3.new(12, 0.6, 88))
	slab("JalanBarat", CFrame.new(-82, -0.2, 0) * CFrame.Angles(0, math.rad(90), 0), Vector3.new(12, 0.6, 76))
	slab("JalanTamanPet", CFrame.new(-57, -0.2, 57) * CFrame.Angles(0, math.rad(-45), 0), Vector3.new(10, 0.6, 72))

	local deco = make("Folder", { Name = "HiasanJalan" }, world)
	for z = -58, -102, -22 do
		tree(deco, Vector3.new(-16, 0, z), 1)
		tree(deco, Vector3.new(16, 0, z - 11), 1)
	end
	for x = 56, 86, 30 do
		tree(deco, Vector3.new(x, 0, -16), 1)
		tree(deco, Vector3.new(x + 12, 0, 16), 1)
	end
	for z = 58, 114, 22 do
		tree(deco, Vector3.new(-16, 0, z), 0.95)
		tree(deco, Vector3.new(16, 0, z + 11), 0.95)
		lampPost(deco, Vector3.new(9, 0, z))
	end
end

---------------------------------------------------------------------
-- [1] ARENA LARI & PILIH (utara)
---------------------------------------------------------------------
local function buildArena(world)
	local arena = make("Folder", { Name = "ArenaLariPilih" }, world)
	local az = ARENA_Z
	part({ Name = "GarisStart", Size = Vector3.new(100, 2, 24), Position = Vector3.new(0, -1, az + 23),
		Color = Color3.fromRGB(150, 170, 220) }, arena)
	for i = 0, 4 do
		part({ Name = "Garis", Size = Vector3.new(100, 0.1, 0.4), Position = Vector3.new(0, 0.03, az + 14 + i * 5),
			Color = Color3.fromRGB(176, 192, 232), CanCollide = false }, arena)
	end
	part({ Name = "GarisNeon", Size = Vector3.new(88, 0.2, 0.6), Position = Vector3.new(0, 0.05, az + 11.3),
		Color = WHITE, Material = Enum.Material.Neon, CanCollide = false }, arena)
	for _, side in ipairs({ -1, 1 }) do
		part({ Name = "SampingKotak", Size = Vector3.new(6, 2, 22), Position = Vector3.new(47 * side, -1, az),
			Color = Color3.fromRGB(120, 130, 170) }, arena)
	end

	-- KOTAK JAWABAN
	local pads = make("Folder", { Name = "KotakJawaban" }, world)
	for i = 1, 4 do
		local pad = part({ Name = "Pad" .. i, Size = PAD_SIZE, Position = Vector3.new(PAD_X[i], -1, az), Color = Config.PadColors[i] }, pads)
		confettiEmitter(pad)
		make("PointLight", { Name = "Cahaya", Range = 18, Brightness = 0, Color = WHITE }, pad)
		local letter = make("BillboardGui", { Name = "Huruf", Size = UDim2.fromScale(7, 7), StudsOffset = Vector3.new(0, 10, 0),
			LightInfluence = 0, MaxDistance = 250 }, pad)
		label(letter, { Name = "Teks", Size = UDim2.fromScale(1, 1), Text = Config.PadLetters[i], Font = Enum.Font.FredokaOne,
			TextStrokeTransparency = 0, TextStrokeColor3 = INK })
		local sign = part({ Name = "Papan" .. i, Size = Vector3.new(21, 6.5, 0.6), Position = Vector3.new(PAD_X[i], 4.3, az - 11.6),
			Color = INK, CanCollide = false }, pads)
		answerPanel(sign, Enum.NormalId.Back, 40, i)
	end
	for i = 1, 3 do
		part({ Name = "Pembatas", Size = Vector3.new(0.5, 0.25, 22), Position = Vector3.new((PAD_X[i] + PAD_X[i + 1]) / 2, 0.1, az),
			Color = WHITE, Material = Enum.Material.Neon, CanCollide = false }, pads)
	end

	-- KOLAM di bawah kotak: kotak salah jatuh = tercebur lalu kembali ke garis start
	local pool = make("Folder", { Name = "Kolam" }, arena)
	part({ Name = "KolamData", Size = Vector3.new(96, 2, 28), Position = Vector3.new(0, -17, az),
		Color = Color3.fromRGB(40, 110, 170) }, world)
	part({ Name = "Air", Size = Vector3.new(96, 10, 28), Position = Vector3.new(0, -11, az), Color = Color3.fromRGB(60, 170, 230),
		Material = Enum.Material.Glass, Transparency = 0.35, CanCollide = false, CanQuery = false }, pool)
	for _, data in ipairs({
		{ Vector3.new(96, 15, 1), Vector3.new(0, -9.5, az - 14.5) },
		{ Vector3.new(1, 15, 28), Vector3.new(-48.5, -9.5, az) },
		{ Vector3.new(1, 15, 28), Vector3.new(48.5, -9.5, az) },
	}) do
		part({ Name = "DindingKolam", Size = data[1], Position = data[2], Color = Color3.fromRGB(210, 220, 230) }, pool)
	end

	-- LAYAR
	questionScreen(arena, "Layar", CFrame.new(0, 25, az - 22), Vector3.new(80, 30, 1), Enum.NormalId.Back, ZONE.arena)
	local title = part({ Name = "JudulGame", Size = Vector3.new(50, 6, 1), Position = Vector3.new(0, 44, az - 22), Color = ZONE.arena }, arena)
	label(surfaceGui(title, Enum.NormalId.Back, 20), { Size = UDim2.fromScale(1, 1), Text = Config.GameTitle, Font = Enum.Font.FredokaOne })
	for _, side in ipairs({ -1, 1 }) do
		part({ Name = "TiangLayar", Size = Vector3.new(3, 48, 3), Position = Vector3.new(41.5 * side, 24, az - 22), Color = WHITE }, arena)
		for tier = 1, 3 do
			part({ Name = "Tribun", Size = Vector3.new(4, tier * 1.6, 44), Position = Vector3.new(side * (56 + (tier - 1) * 4), tier * 0.8, az + 4),
				Color = tier % 2 == 0 and WHITE or Color3.fromRGB(200, 215, 245) }, arena)
		end
	end

	local walls = make("Folder", { Name = "Dinding" }, arena)
	local function invisibleWall(size, pos)
		part({ Name = "Batas", Size = size, Position = pos, Transparency = 1 }, walls)
	end
	invisibleWall(Vector3.new(100, 40, 1), Vector3.new(0, 20, az - 12.5))
	for _, side in ipairs({ -1, 1 }) do
		invisibleWall(Vector3.new(1, 40, 48), Vector3.new(50.5 * side, 20, az + 11))
		part({ Name = "Pagar", Size = Vector3.new(1.4, 3, 48), Position = Vector3.new(51.5 * side, 1.5, az + 11), Color = LEAF_COLORS[2] }, walls)
	end
	arch(arena, CFrame.new(0, 0, az + 38), 30, 1, "LARI & PILIH", ZONE.arena)
end

---------------------------------------------------------------------
-- [2] PANGGUNG KUIS KILAT (timur)
---------------------------------------------------------------------
local function buildStage(world)
	local stage = make("Folder", { Name = "PanggungKilat" }, world)
	part({ Name = "LantaiPenonton", Size = Vector3.new(42, 1, 60), Position = Vector3.new(117, -0.45, 0), Color = STONE,
		Material = Enum.Material.Pavement }, stage)
	for i = 0, 4 do
		part({ Name = "GarisPenonton", Size = Vector3.new(0.4, 0.1, 56), Position = Vector3.new(100 + i * 8, 0.08, 0), Color = STONE_DARK,
			CanCollide = false }, stage)
	end
	part({ Name = "Panggung", Size = Vector3.new(30, 3, 58), Position = Vector3.new(153, 1.5, 0), Color = Color3.fromRGB(70, 56, 96) }, stage)
	part({ Name = "LisPanggung", Size = Vector3.new(0.6, 0.6, 58), Position = Vector3.new(138.3, 2.8, 0), Color = ZONE.stage,
		Material = Enum.Material.Neon, CanCollide = false }, stage)
	part({ Name = "Tangga", Size = Vector3.new(4, 1.5, 22), Position = Vector3.new(136, 0.75, 0), Color = Color3.fromRGB(90, 76, 120) }, stage)
	part({ Name = "DindingBelakang", Size = Vector3.new(2, 44, 62), Position = Vector3.new(169, 22, 0), Color = Color3.fromRGB(44, 38, 66) }, stage)
	questionScreen(stage, "Layar", CFrame.new(167.6, 23, 0) * CFrame.Angles(0, math.rad(90), 0), Vector3.new(46, 22, 0.6),
		Enum.NormalId.Back, ZONE.stage)
	local title = part({ Name = "JudulPanggung", Size = Vector3.new(0.6, 5, 40), Position = Vector3.new(167.6, 38, 0), Color = ZONE.stage }, stage)
	label(surfaceGui(title, Enum.NormalId.Left, 20), { Size = UDim2.fromScale(1, 1), Text = "KUIS KILAT", Font = Enum.Font.FredokaOne, TextColor3 = INK })
	for i = 1, 4 do
		local panel = part({ Name = "PanelJawaban" .. i, Size = Vector3.new(0.6, 7, 10.4), Position = Vector3.new(167.6, 7.5, -16.5 + (i - 1) * 11),
			Color = INK }, stage)
		answerPanel(panel, Enum.NormalId.Left, 30, i)
	end
	for _, side in ipairs({ -1, 1 }) do
		part({ Name = "MenaraLampu", Size = Vector3.new(6, 22, 6), Position = Vector3.new(155, 11, side * 34), Color = Color3.fromRGB(56, 50, 80) }, stage)
		for k = 1, 3 do
			part({ Name = "LampuMenara", Size = Vector3.new(6.2, 0.6, 6.2), Position = Vector3.new(155, 5 + k * 5, side * 34),
				Color = k % 2 == 0 and ZONE.stage or WHITE, Material = Enum.Material.Neon, CanCollide = false }, stage)
		end
		local spot = part({ Name = "Sorot", Size = Vector3.new(2, 2, 2), Position = Vector3.new(150, 23, side * 30), Color = INK }, stage)
		make("SpotLight", { Face = Enum.NormalId.Bottom, Range = 40, Brightness = 2, Angle = 60, Color = Color3.fromRGB(255, 240, 210) }, spot)
	end
	arch(stage, CFrame.new(93, 0, 0) * CFrame.Angles(0, math.rad(-90), 0), 30, 2, "KUIS KILAT", ZONE.stage)
end

---------------------------------------------------------------------
-- [3] MENARA & LINTASAN FIREWALL (selatan, di langit)
---------------------------------------------------------------------
local function buildCourse(world)
	local course = make("Folder", { Name = "LintasanFirewall" }, world)
	local y, zc, width = COURSE.y, COURSE.z, COURSE.width
	local floorColor = Color3.fromRGB(96, 104, 150)
	local towerX = COURSE.startX - 10

	column(course, "LantaiMenara", Vector3.new(towerX, -0.42, zc), 1, 40, STONE, Enum.Material.Pavement)
	column(course, "Menara", Vector3.new(towerX, (y - 1) / 2, zc), y - 1, 18, Color3.fromRGB(236, 232, 224), Enum.Material.SmoothPlastic)
	for k = 1, 5 do
		column(course, "Cincin", Vector3.new(towerX, k * (y / 6), zc), 2.4, 18.6, ZONE.course, Enum.Material.SmoothPlastic)
	end
	local door = part({ Name = "PintuMenara", Size = Vector3.new(6, 9, 1), Position = Vector3.new(towerX, 4.5, zc - 9), Color = ZONE.course }, course)
	label(surfaceGui(door, Enum.NormalId.Front, 30), { Size = UDim2.fromScale(0.9, 0.5), Position = UDim2.fromScale(0.05, 0.25),
		Text = "Naik otomatis saat Game 3 dimulai", Font = Enum.Font.GothamBold })
	arch(course, CFrame.new(0, 0, 128) * CFrame.Angles(0, math.pi, 0), 30, 3, "LINTASAN FIREWALL", ZONE.course)

	local start = part({ Name = "Start", Size = Vector3.new(20, 1, width), Position = Vector3.new(COURSE.startX - 10, y - 0.5, zc),
		Color = Color3.fromRGB(80, 200, 130) }, course)
	billboard(start, "LINTASAN FIREWALL", ZONE.course, UDim2.fromScale(20, 3), Vector3.new(0, 11, 0))
	part({ Name = "Penghalang", Size = Vector3.new(1, 12, width), Position = Vector3.new(COURSE.startX - 0.5, y + 6, zc),
		Color = Color3.fromRGB(255, 80, 80), Material = Enum.Material.ForceField }, course)
	for _, side in ipairs({ -1, 1 }) do
		part({ Name = "PagarStart", Size = Vector3.new(20, 4, 0.6), Position = Vector3.new(COURSE.startX - 10, y + 2, zc + side * (width / 2)),
			Color = WHITE, Material = Enum.Material.Glass, Transparency = 0.6 }, course)
	end
	part({ Name = "PagarStartBelakang", Size = Vector3.new(0.6, 4, width), Position = Vector3.new(COURSE.startX - 20, y + 2, zc),
		Color = WHITE, Material = Enum.Material.Glass, Transparency = 0.6 }, course)

	for gate = 1, COURSE.gates do
		local x0 = COURSE.startX + (gate - 1) * COURSE.sectionLength
		local folder = make("Folder", { Name = "Gerbang" .. gate }, course)
		part({ Name = "Area", Size = Vector3.new(16, 1, width), Position = Vector3.new(x0 + 8, y - 0.5, zc), Color = floorColor }, folder)
		for _, side in ipairs({ -1, 1 }) do
			part({ Name = "TepiNeon", Size = Vector3.new(16, 0.3, 0.6), Position = Vector3.new(x0 + 8, y + 0.1, zc + side * (width / 2 - 0.3)),
				Color = ZONE.course, Material = Enum.Material.Neon, CanCollide = false }, folder)
		end
		local wallColor = Color3.fromRGB(210, 84, 70)
		part({ Name = "Atas", Size = Vector3.new(1, 4, width), Position = Vector3.new(x0 + 16.5, y + 10, zc), Color = wallColor,
			Material = Enum.Material.Brick }, folder)
		for lane = 1, 4 do
			local lz = laneZ(lane)
			for _, dz in ipairs({ -3, 3 }) do
				part({ Name = "Tiang", Size = Vector3.new(1, 8, 1), Position = Vector3.new(x0 + 16.5, y + 4, lz + dz), Color = wallColor,
					Material = Enum.Material.Brick }, folder)
			end
			part({ Name = "Blok" .. lane, Size = Vector3.new(0.6, 8, 5), Position = Vector3.new(x0 + 16.5, y + 4, lz),
				Color = Color3.fromRGB(255, 60, 60), Material = Enum.Material.ForceField, CanCollide = false, Transparency = 1 }, folder)
			local sign = part({ Name = "Tanda" .. lane, Size = Vector3.new(0.3, 3.6, 6.6), Position = Vector3.new(x0 + 15.8, y + 10, lz),
				Color = Config.PadColors[lane] }, folder)
			local gui = surfaceGui(sign, Enum.NormalId.Left, 40)
			label(gui, { Name = "Huruf", Size = UDim2.fromScale(0.25, 1), Text = Config.PadLetters[lane], Font = Enum.Font.FredokaOne })
			label(gui, { Name = "Jawaban", Size = UDim2.fromScale(0.73, 0.9), Position = UDim2.fromScale(0.26, 0.05), Text = "", MaxTextSize = 40 })
			part({ Name = "Jalur" .. lane, Size = Vector3.new(14, 1, 7), Position = Vector3.new(x0 + 24, y - 0.5, lz), Color = floorColor }, folder)
		end
		for i = 0, 4 do
			part({ Name = "SekatJalur", Size = Vector3.new(14, 8, 0.4), Position = Vector3.new(x0 + 24, y + 4, zc - width / 2 + i * 7),
				Color = Color3.fromRGB(210, 235, 255), Material = Enum.Material.Glass, Transparency = 0.6 }, folder)
		end
		local board = part({ Name = "PapanSoal", Size = Vector3.new(0.4, 8, width), Position = Vector3.new(x0 + 15.8, y + 16.5, zc), Color = INK }, folder)
		local boardGui = surfaceGui(board, Enum.NormalId.Left, 25)
		label(boardGui, { Name = "Nomor", Size = UDim2.fromScale(1, 0.2), Text = "GERBANG " .. gate, Font = Enum.Font.FredokaOne,
			TextColor3 = Color3.fromRGB(255, 170, 90) })
		label(boardGui, { Name = "Soal", Size = UDim2.fromScale(0.96, 0.76), Position = UDim2.fromScale(0.02, 0.22), Text = "", MaxTextSize = 44 })
		part({ Name = "Gabung", Size = Vector3.new(5, 1, width), Position = Vector3.new(x0 + 33.5, y - 0.5, zc), Color = floorColor }, folder)
		local zig = (gate % 2 == 0) and 1 or -1
		part({ Name = "Lompat1", Size = Vector3.new(4, 1, 6), Position = Vector3.new(x0 + 42, y + 0.5, zc + zig * 5),
			Color = Color3.fromRGB(255, 200, 80) }, folder)
		part({ Name = "Lompat2", Size = Vector3.new(4, 1, 6), Position = Vector3.new(x0 + 50, y + 1.5, zc - zig * 5),
			Color = Color3.fromRGB(255, 160, 80) }, folder)
	end

	local finish = part({ Name = "Finish", Size = Vector3.new(24, 1, width), Position = Vector3.new(COURSE.finishX + 12, y - 0.5, zc),
		Color = Color3.fromRGB(255, 205, 60) }, course)
	confettiEmitter(finish)
	for _, side in ipairs({ -1, 1 }) do
		part({ Name = "TiangFinish", Size = Vector3.new(1.5, 16, 1.5), Position = Vector3.new(COURSE.finishX + 4, y + 8, zc + side * 12),
			Color = WHITE }, course)
		part({ Name = "PagarFinish", Size = Vector3.new(24, 4, 0.6), Position = Vector3.new(COURSE.finishX + 12, y + 2, zc + side * (width / 2)),
			Color = WHITE, Material = Enum.Material.Glass, Transparency = 0.6 }, course)
	end
	part({ Name = "PagarFinishUjung", Size = Vector3.new(0.6, 4, width), Position = Vector3.new(COURSE.finishX + 24, y + 2, zc),
		Color = WHITE, Material = Enum.Material.Glass, Transparency = 0.6 }, course)
	local banner = part({ Name = "SpandukFinish", Size = Vector3.new(1, 4, 25.5), Position = Vector3.new(COURSE.finishX + 4, y + 14, zc),
		Color = Color3.fromRGB(255, 90, 130) }, course)
	label(surfaceGui(banner, Enum.NormalId.Left, 30), { Size = UDim2.fromScale(1, 1), Text = "FINISH", Font = Enum.Font.FredokaOne })
end

---------------------------------------------------------------------
-- [4] LAB PECAHKAN SANDI + JALUR ZONA MATERI (barat)
---------------------------------------------------------------------
local function buildLab(world)
	local lab = make("Folder", { Name = "LabSandi" }, world)
	part({ Name = "Lantai", Size = Vector3.new(64, 1, 60), Position = Vector3.new(-152, 0.5, 0), Color = Color3.fromRGB(236, 226, 206),
		Material = Enum.Material.WoodPlanks }, lab)
	part({ Name = "Undakan", Size = Vector3.new(3, 0.5, 18), Position = Vector3.new(-118.5, 0.25, 0), Color = STONE_DARK }, lab)
	for _, x in ipairs({ -182, -152, -122 }) do
		for _, z in ipairs({ -28, 28 }) do
			part({ Name = "Pilar", Size = Vector3.new(2, 16, 2), Position = Vector3.new(x, 9, z), Color = WHITE }, lab)
		end
	end
	part({ Name = "Atap", Size = Vector3.new(68, 1.2, 64), Position = Vector3.new(-152, 17.6, 0), Color = ZONE.lab }, lab)
	part({ Name = "LisAtap", Size = Vector3.new(68.4, 0.6, 64.4), Position = Vector3.new(-152, 16.8, 0), Color = WHITE }, lab)
	part({ Name = "DindingPapan", Size = Vector3.new(1, 16, 58), Position = Vector3.new(-184, 9, 0), Color = Color3.fromRGB(246, 240, 226) }, lab)
	questionScreen(lab, "Layar", CFrame.new(-183.2, 10, 0) * CFrame.Angles(0, math.rad(-90), 0), Vector3.new(40, 13, 0.6),
		Enum.NormalId.Back, ZONE.lab)
	-- meja komputer (siswa menghadap papan di barat)
	for _, x in ipairs({ -172, -163 }) do
		for _, z in ipairs({ -19.5, -6.5, 6.5, 19.5 }) do
			part({ Name = "Meja", Size = Vector3.new(3, 0.4, 9), Position = Vector3.new(x, 3.6, z), Color = WOOD, Material = Enum.Material.Wood }, lab)
			for _, dz in ipairs({ -4, 4 }) do
				part({ Name = "KakiMeja", Size = Vector3.new(2.6, 2.4, 0.3), Position = Vector3.new(x, 2.2, z + dz), Color = Color3.fromRGB(80, 84, 96) }, lab)
			end
			for _, dz in ipairs({ -2.2, 2.2 }) do
				part({ Name = "Monitor", Size = Vector3.new(0.3, 1.7, 2.6), Position = Vector3.new(x - 0.8, 4.75, z + dz), Color = INK }, lab)
				part({ Name = "LayarMonitor", Size = Vector3.new(0.05, 1.4, 2.3), Position = Vector3.new(x - 0.62, 4.75, z + dz),
					Color = Color3.fromRGB(110, 230, 170), Material = Enum.Material.Neon, CanCollide = false }, lab)
			end
		end
	end
	arch(lab, CFrame.new(-116, 0, 0) * CFrame.Angles(0, math.rad(90), 0), 30, 4, "PECAHKAN SANDI", ZONE.lab)

	-- JALUR ZONA MATERI: papan materi di kiri-kanan jalan menuju lab
	local boards = make("Folder", { Name = "ZonaMateri" }, world)
	local topics = {}
	for _, topic in ipairs(Config.Topics) do
		if topic.id ~= "campuran" then
			table.insert(topics, topic)
		end
	end
	for index, topic in ipairs(topics) do
		local x = -60 - ((index - 1) % 3) * 20
		local side = index <= 3 and 1 or -1
		local z = side * 15
		local base = CFrame.lookAt(Vector3.new(x, 0, z), Vector3.new(x, 0, 0))
		local board = part({ Name = "Materi_" .. topic.id, Size = Vector3.new(16, 10, 0.5), CFrame = base * CFrame.new(0, 7, 0),
			Color = Color3.fromRGB(255, 252, 244) }, boards)
		board:SetAttribute("TopicId", topic.id)
		local gui = surfaceGui(board, Enum.NormalId.Front, 60)
		local bg = make("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.fromRGB(255, 252, 244), BorderSizePixel = 0 }, gui)
		local titleFrame = make("Frame", { Size = UDim2.fromScale(1, 0.15), BackgroundColor3 = topic.color, BorderSizePixel = 0 }, bg)
		label(titleFrame, { Size = UDim2.fromScale(0.96, 0.8), Position = UDim2.fromScale(0.02, 0.1), Text = string.upper(topic.name),
			Font = Enum.Font.FredokaOne, TextColor3 = INK })
		local body = make("Frame", { Size = UDim2.fromScale(0.94, 0.8), Position = UDim2.fromScale(0.03, 0.18), BackgroundTransparency = 1 }, bg)
		make("UIListLayout", { Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder }, body)
		for order, point in ipairs(Materi[topic.id] or {}) do
			label(body, { Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, TextScaled = false, TextSize = 24,
				Font = Enum.Font.GothamMedium, TextXAlignment = Enum.TextXAlignment.Left, LayoutOrder = order, Text = "• " .. point,
				TextColor3 = Color3.fromRGB(40, 45, 70) })
		end
		make("ProximityPrompt", { Name = "BacaMateri", ActionText = "Baca Materi", ObjectText = topic.name, HoldDuration = 0,
			MaxActivationDistance = 14, RequiresLineOfSight = false, KeyboardKeyCode = Enum.KeyCode.E }, board)
		for _, dx in ipairs({ -8.4, 8.4 }) do
			part({ Name = "TiangPapan", Size = Vector3.new(0.8, 13, 0.8), CFrame = base * CFrame.new(dx, 6.5, 0.2), Color = WOOD,
				Material = Enum.Material.Wood }, boards)
		end
		part({ Name = "AtapPapan", Size = Vector3.new(18, 0.6, 3), CFrame = base * CFrame.new(0, 13, -0.6), Color = topic.color }, boards)
		bush(boards, (base * CFrame.new(0, 0, 3)).Position, 0.9)
	end
	arch(boards, CFrame.new(-50, 0, 0) * CFrame.Angles(0, math.rad(90), 0), 26, nil, "ZONA MATERI", Color3.fromRGB(90, 120, 200))
end

---------------------------------------------------------------------
-- TAMAN PET (barat daya)
---------------------------------------------------------------------
local PET_CENTER = Vector3.new(-110, 0, 110)

local function buildPetGarden(world)
	local garden = make("Folder", { Name = "TamanPet" }, world)
	column(garden, "Lantai", PET_CENTER + Vector3.new(0, -0.42, 0), 1, 76, Color3.fromRGB(196, 228, 170), Enum.Material.SmoothPlastic)
	column(garden, "Jalur", PET_CENTER + Vector3.new(0, 0.1, 0), 0.1, 30, Color3.fromRGB(230, 220, 200), Enum.Material.Pavement,
		{ CanCollide = false })
	-- arah pintu masuk: menghadap alun-alun (timur laut)
	local entrance = math.atan2(-PET_CENTER.X, -PET_CENTER.Z)
	for i = 0, 23 do
		local angle = i / 24 * math.pi * 2
		local diff = math.abs((angle - entrance + math.pi) % (math.pi * 2) - math.pi)
		if diff > math.rad(20) then
			local position = PET_CENTER + Vector3.new(math.sin(angle) * 37, 1.5, math.cos(angle) * 37)
			part({ Name = "Pagar", Size = Vector3.new(9.4, 3, 1.6), CFrame = CFrame.lookAt(position, PET_CENTER + Vector3.new(0, 1.5, 0)),
				Color = LEAF_COLORS[2] }, garden)
		end
	end
	local gateCf = CFrame.new(PET_CENTER + Vector3.new(math.sin(entrance) * 37, 0, math.cos(entrance) * 37))
		* CFrame.Angles(0, entrance, 0)
	arch(garden, gateCf, 18, nil, "TAMAN PET", ZONE.pets)
	tree(garden, PET_CENTER, 1.5, BLOSSOM)
	local info = part({ Name = "PapanInfoPet", Size = Vector3.new(12, 6, 0.5),
		CFrame = CFrame.lookAt(PET_CENTER + Vector3.new(math.sin(entrance) * 9, 4, math.cos(entrance) * 9),
			PET_CENTER + Vector3.new(math.sin(entrance) * 20, 4, math.cos(entrance) * 20)), Color = WHITE }, garden)
	local infoGui = surfaceGui(info, Enum.NormalId.Front, 40)
	local infoBg = make("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.fromRGB(255, 246, 250), BorderSizePixel = 0 }, infoGui)
	label(infoBg, { Size = UDim2.fromScale(0.92, 0.3), Position = UDim2.fromScale(0.04, 0.06), Text = "KOLEKSI PET",
		Font = Enum.Font.FredokaOne, TextColor3 = ZONE.pets })
	label(infoBg, { Size = UDim2.fromScale(0.92, 0.56), Position = UDim2.fromScale(0.04, 0.4),
		Text = "Kumpulkan POIN RANK dari jawaban benar untuk membuka pet. Pakai pet lewat tombol PET di layar.",
		Font = Enum.Font.GothamMedium, TextColor3 = INK })

	local count = #PetCatalog.List
	for index, pet in ipairs(PetCatalog.List) do
		local angle = entrance + math.rad(40) + (index - 1) / (count - 1) * math.rad(280)
		local position = PET_CENTER + Vector3.new(math.sin(angle) * 26, 0, math.cos(angle) * 26)
		local face = CFrame.lookAt(position, PET_CENTER)
		local rarityColor = PetCatalog.Rarities[pet.rarity] or WHITE
		column(garden, "Alas_" .. pet.id, position + Vector3.new(0, 1, 0), 2, 7, WHITE, Enum.Material.Marble)
		column(garden, "CincinAlas", position + Vector3.new(0, 2.05, 0), 0.25, 7.6, rarityColor, Enum.Material.Neon, { CanCollide = false })
		local model = PetCatalog.Build(pet.id)
		model:PivotTo(face * CFrame.new(0, (pet.flying and 4.6 or 3.05), 0))
		model.Parent = garden
		local anchor = part({ Name = "Label_" .. pet.id, Size = Vector3.new(1, 1, 1), Position = position + Vector3.new(0, 8.5, 0),
			Transparency = 1, CanCollide = false, CanQuery = false, CanTouch = false }, garden)
		billboard(anchor, pet.name .. "\n" .. pet.rarity .. " • " .. (pet.xp == 0 and "Gratis" or (pet.xp .. " Poin Rank")), rarityColor,
			UDim2.fromScale(9, 2.6), Vector3.new(0, 0, 0))
	end
end

---------------------------------------------------------------------
-- PEMANDANGAN & BATAS
---------------------------------------------------------------------
local function buildScenery(world)
	local deco = make("Folder", { Name = "Pemandangan" }, world)
	local clusters = {
		{ 75, -75 }, { 95, -55 }, { 60, -105 }, { 100, -95 },
		{ -75, -75 }, { -95, -50 }, { -60, -110 }, { -105, -95 },
		{ 70, 75 }, { 95, 60 }, { 60, 105 }, { 110, 120 },
		{ -165, 60 }, { -60, 160 }, { -170, -60 }, { 175, 40 }, { 40, 185 }, { -20, -195 }, { 160, -110 }, { -150, 140 },
	}
	for i, spot in ipairs(clusters) do
		tree(deco, Vector3.new(spot[1], 0, spot[2]), 0.9 + (i % 4) * 0.15, (i % 6 == 0) and BLOSSOM or nil)
		if i % 2 == 0 then
			bush(deco, Vector3.new(spot[1] + 6, 0, spot[2] - 4), 1)
		end
	end
	for i = 0, 27 do
		local angle = i / 28 * math.pi * 2 + 0.05
		local radius = 214 + (i % 3) * 4
		local x, z = math.sin(angle) * radius, math.cos(angle) * radius
		palm(deco, Vector3.new(x, -1, z), angle + math.pi)
	end
	for i, spot in ipairs({ { 140, -150, 4 }, { -150, -150, 5 }, { 190, 80, 3 }, { -190, 20, 4 }, { 30, -200, 3 }, { -90, 190, 4 } }) do
		rock(deco, Vector3.new(spot[1], -0.5, spot[2]), spot[3] + (i % 2))
	end
	-- batas dunia (tak terlihat). Hanya sampai y = 50 agar tidak menghalangi lintasan langit (y = 90).
	local bounds = make("Folder", { Name = "BatasDunia" }, world)
	for _, data in ipairs({
		{ Vector3.new(1, 60, 560), Vector3.new(-262, 20, 0) },
		{ Vector3.new(1, 60, 560), Vector3.new(262, 20, 0) },
		{ Vector3.new(560, 60, 1), Vector3.new(0, 20, -262) },
		{ Vector3.new(560, 60, 1), Vector3.new(0, 20, 262) },
	}) do
		part({ Name = "Batas", Size = data[1], Position = data[2], Transparency = 1 }, bounds)
	end
end

---------------------------------------------------------------------
-- MEMBANGUN DUNIA
---------------------------------------------------------------------
local function buildWorld()
	local world = make("Folder", { Name = WORLD_NAME }, nil)
	world:SetAttribute("Versi", WORLD_VERSION)
	world:SetAttribute("Gerbang", COURSE.gates)
	buildTerrain()
	buildPlaza(world)
	buildPaths(world)
	buildArena(world)
	buildStage(world)
	buildCourse(world)
	buildLab(world)
	buildPetGarden(world)
	buildScenery(world)
	world.Parent = workspace
	return world
end

local function removeDefaults(world)
	-- Baseplate & SpawnLocation bawaan template Roblox dihapus agar tidak bertabrakan dengan pulau.
	for _, child in ipairs(workspace:GetChildren()) do
		if child ~= world and (child.Name == "Baseplate" or child:IsA("SpawnLocation") or child.Name == "PetunjukAwal") then
			child:Destroy()
		end
	end
end

---------------------------------------------------------------------
-- Objek Arena: dipakai server untuk mengontrol tampilan
---------------------------------------------------------------------
local Arena = {}
Arena.__index = Arena

local function findPath(parent, path)
	local current = parent
	for _, name in ipairs(string.split(path, "/")) do
		current = current and current:FindFirstChild(name)
	end
	return current
end

local REQUIRED = {
	"KotakJawaban/Pad1", "KotakJawaban/Pad2", "KotakJawaban/Pad3", "KotakJawaban/Pad4",
	"KotakJawaban/Papan1", "KotakJawaban/Papan2", "KotakJawaban/Papan3", "KotakJawaban/Papan4",
	"KolamData", "Podium/PapanPeringkat", "Podium/Juara1", "Podium/Juara2", "Podium/Juara3",
	"PanggungKilat/PanelJawaban1", "LintasanFirewall/Penghalang", "LintasanFirewall/Finish",
}

local function isValid(world)
	if world:GetAttribute("Versi") ~= WORLD_VERSION or world:GetAttribute("Gerbang") ~= COURSE.gates then
		warn("[NetQuest] Versi dunia berbeda, dunia dibangun ulang.")
		return false
	end
	for _, path in ipairs(REQUIRED) do
		if not findPath(world, path) then
			warn("[NetQuest] ArenaKuis tidak lengkap (" .. path .. " hilang), dunia dibangun ulang.")
			return false
		end
	end
	return true
end

function Arena.new(folder)
	local self = setmetatable({}, Arena)
	self.Folder = folder
	self.Pads, self.Signs, self.StagePanels = {}, {}, {}
	for i = 1, 4 do
		self.Pads[i] = findPath(folder, "KotakJawaban/Pad" .. i)
		self.Signs[i] = findPath(folder, "KotakJawaban/Papan" .. i .. "/Gui/Latar")
		self.StagePanels[i] = findPath(folder, "PanggungKilat/PanelJawaban" .. i .. "/Gui/Latar")
	end
	self.Pit = folder.KolamData
	self.Screens = {}
	for _, d in ipairs(folder:GetDescendants()) do
		if d:IsA("BasePart") and d:GetAttribute("LayarKuis") then
			local isi = findPath(d, "Gui/Isi")
			if isi then
				table.insert(self.Screens, {
					Topic = findPath(isi, "Header/Topik"),
					Number = findPath(isi, "Header/Nomor"),
					Timer = findPath(isi, "Header/Waktu"),
					Header = isi:FindFirstChild("Header"),
					Question = isi:FindFirstChild("Pertanyaan"),
					Info = isi:FindFirstChild("Info"),
				})
			end
		end
	end
	local board = findPath(folder, "Podium/PapanPeringkat/Gui/Isi")
	self.BoardTitle = board and board:FindFirstChild("Judul", true)
	self.BoardList = board and board:FindFirstChild("Daftar", true)
	self.Podiums = {}
	for i = 1, 3 do
		self.Podiums[i] = findPath(folder, "Podium/Juara" .. i)
	end
	self.Course = findPath(folder, "LintasanFirewall")
	self.CourseInfo = COURSE
	self.ActivePads = {}
	self.PadColors = {}
	return self
end

---------------------------------------------------------------------
-- POSISI
---------------------------------------------------------------------
-- Garis Start Arena 1 (menghadap layar di utara)
function Arena:GetStartCFrame()
	return CFrame.new(math.random(-40, 40), 3.5, ARENA_Z + math.random(15, 31))
end

-- Area penonton Panggung Kuis Kilat (menghadap timur)
function Arena:GetStageCFrame()
	local position = Vector3.new(math.random(102, 128), 3.5, math.random(-22, 22))
	return CFrame.lookAt(position, position + Vector3.new(1, 0, 0))
end

-- Lab Pecahkan Sandi (menghadap papan di barat)
function Arena:GetLabCFrame()
	local position = Vector3.new(math.random(-152, -128), 4.5, math.random(-24, 24))
	return CFrame.lookAt(position, position + Vector3.new(-1, 0, 0))
end

-- Alun-alun, menghadap papan peringkat
function Arena:GetLobbyCFrame()
	local position = Vector3.new(math.random(-10, 14), 3.5, math.random(-6, 18))
	return CFrame.lookAt(position, Vector3.new(27, 3.5, -27))
end

function Arena:GetPodiumCFrame(rank)
	local block = self.Podiums[rank]
	return block.CFrame * CFrame.new(0, block.Size.Y / 2 + 3, 0)
end

---------------------------------------------------------------------
-- LAYAR
---------------------------------------------------------------------
function Arena:SetScreen(data)
	for _, s in ipairs(self.Screens) do
		if data.topic and s.Topic then s.Topic.Text = data.topic end
		if data.number and s.Number then s.Number.Text = data.number end
		if data.timer and s.Timer then s.Timer.Text = data.timer end
		if data.question and s.Question then s.Question.Text = data.question end
		if data.info and s.Info then s.Info.Text = data.info end
		if data.accent and s.Header then
			s.Header.BackgroundColor3 = data.accent
		end
	end
end

---------------------------------------------------------------------
-- KOTAK JAWABAN (Arena 1)
---------------------------------------------------------------------
function Arena:GetPadAt(position)
	for i, pad in ipairs(self.Pads) do
		if self.ActivePads[i] then
			local rel = pad.CFrame:PointToObjectSpace(position)
			local half = pad.Size / 2
			if math.abs(rel.X) <= half.X and math.abs(rel.Z) <= half.Z and rel.Y > -half.Y and rel.Y < 10 then
				return i
			end
		end
	end
	return nil
end

local function setPadSolid(pad, color)
	pad.CanCollide = true
	pad.Transparency = 0
	pad.Material = Enum.Material.SmoothPlastic
	pad.Color = color
	local light = pad:FindFirstChild("Cahaya")
	if light then
		light.Brightness = 0
	end
end

local function optionForPad(prepared, pad)
	for _, option in ipairs(prepared.options or {}) do
		if option.pad == pad then
			return option
		end
	end
	return nil
end

local function fillPanel(panel, option, idleColor)
	if not panel then
		return
	end
	panel.BackgroundColor3 = option and option.color or idleColor
	panel.Huruf.Text = option and option.letter or ""
	panel.Jawaban.Text = option and option.text or "—"
	panel.Jumlah.Text = ""
end

function Arena:SetQuestion(prepared)
	for i = 1, 4 do
		local option = optionForPad(prepared, i)
		self.ActivePads[i] = option ~= nil
		self.PadColors[i] = option and option.color or IDLE_PAD_COLOR
	end
	for i, pad in ipairs(self.Pads) do
		setPadSolid(pad, self.PadColors[i])
		local option = optionForPad(prepared, i)
		fillPanel(self.Signs[i], option, IDLE_PAD_COLOR)
		local letter = pad:FindFirstChild("Huruf")
		if letter then
			letter.Enabled = option ~= nil
			if option then
				letter.Teks.Text = option.letter
				letter.Teks.TextColor3 = option.color:Lerp(WHITE, 0.35)
			end
		end
	end
end

function Arena:Reveal(correctPad, counts)
	for i, pad in ipairs(self.Pads) do
		local sign = self.Signs[i]
		if self.ActivePads[i] and counts then
			sign.Jumlah.Text = tostring(counts[i] or 0) .. " pemain"
		end
		if i == correctPad then
			pad.Material = Enum.Material.Neon
			local light = pad:FindFirstChild("Cahaya")
			if light then
				light.Brightness = 3
			end
			local confetti = pad:FindFirstChild("Konfeti")
			if confetti then
				confetti:Emit(120)
			end
			sign.Jawaban.Text = "✔ " .. sign.Jawaban.Text
		else
			pad.CanCollide = false
			pad.Transparency = 0.8
			pad.Color = Color3.fromRGB(40, 44, 60)
			sign.BackgroundColor3 = Color3.fromRGB(70, 72, 84)
		end
	end
end

function Arena:ResetPads(idle, idleText)
	for i, pad in ipairs(self.Pads) do
		local color = self.PadColors[i] or IDLE_PAD_COLOR
		if idle then
			color = Config.PadColors[i]
			self.ActivePads[i] = false
			local sign = self.Signs[i]
			sign.BackgroundColor3 = color
			sign.Huruf.Text = Config.PadLetters[i]
			sign.Jawaban.Text = idleText or "Menunggu soal..."
			sign.Jumlah.Text = ""
			local letter = pad:FindFirstChild("Huruf")
			if letter then
				letter.Enabled = true
				letter.Teks.Text = Config.PadLetters[i]
				letter.Teks.TextColor3 = WHITE
			end
		end
		setPadSolid(pad, color)
	end
end

---------------------------------------------------------------------
-- PANEL PANGGUNG (Arena 2)
---------------------------------------------------------------------
function Arena:SetStageQuestion(prepared)
	for i, panel in ipairs(self.StagePanels) do
		if panel then
			if prepared then
				fillPanel(panel, optionForPad(prepared, i), Color3.fromRGB(70, 72, 84))
			else
				panel.BackgroundColor3 = Config.PadColors[i]
				panel.Huruf.Text = Config.PadLetters[i]
				panel.Jawaban.Text = ""
				panel.Jumlah.Text = ""
			end
		end
	end
end

function Arena:RevealStage(correctPad, counts)
	for i, panel in ipairs(self.StagePanels) do
		if panel then
			if counts then
				panel.Jumlah.Text = tostring(counts[i] or 0) .. " pemain"
			end
			if i == correctPad then
				panel.Jawaban.Text = "✔ " .. panel.Jawaban.Text
			else
				panel.BackgroundColor3 = Color3.fromRGB(70, 72, 84)
			end
		end
	end
end

---------------------------------------------------------------------
-- PAPAN PERINGKAT & PODIUM
---------------------------------------------------------------------
-- rows = { { name = "...", score = 123 }, ... }
function Arena:SetLeaderboard(title, rows)
	if self.BoardTitle then
		self.BoardTitle.Text = title
	end
	if not self.BoardList then
		return
	end
	for i = 1, 8 do
		local row = self.BoardList:FindFirstChild("Baris" .. i)
		local data = rows[i]
		if row then
			row.Nama.Text = data and data.name or ((i == 1 and #rows == 0) and "Belum ada data" or "")
			row.Poin.Text = data and tostring(data.score) or ""
		end
	end
end

function Arena:SetHallOfFame(ranking, title)
	local rows = {}
	for i = 1, math.min(8, #ranking) do
		rows[i] = { name = ranking[i].name, score = ranking[i].score }
	end
	self:SetLeaderboard(title or "JUARA TERAKHIR", rows)
end

function Arena:CelebratePodium()
	for _, block in ipairs(self.Podiums) do
		local emitter = block:FindFirstChild("Konfeti")
		if emitter then
			emitter:Emit(100)
		end
	end
end

-- Pemain yang tercebur ke kolam dikembalikan ke Garis Start
function Arena:ConnectPit()
	local cooldown = {}
	self.Pit.Touched:Connect(function(hit)
		local character = hit.Parent
		local player = character and Players:GetPlayerFromCharacter(character)
		if not player or cooldown[player] then
			return
		end
		cooldown[player] = true
		local root = character:FindFirstChild("HumanoidRootPart")
		if root then
			root.AssemblyLinearVelocity = Vector3.zero
			character:PivotTo(self:GetStartCFrame())
		end
		task.delay(1, function()
			cooldown[player] = nil
		end)
	end)
end

function Arena:StartDecorations()
	local globe = findPath(self.Folder, "Alun/GlobeInternet")
	if globe then
		local base = globe.CFrame
		local angle = 0
		RunService.Heartbeat:Connect(function(dt)
			angle += dt * 0.6
			globe.CFrame = base * CFrame.new(0, math.sin(angle * 1.5) * 0.6, 0) * CFrame.Angles(0, angle, 0)
		end)
	end
	local barrier = self.Course and self.Course:FindFirstChild("Penghalang")
	if barrier then
		TweenService:Create(barrier, TweenInfo.new(1.2, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true),
			{ Color = Color3.fromRGB(255, 160, 60) }):Play()
	end
end

---------------------------------------------------------------------
-- LINTASAN FIREWALL (Arena 3)
---------------------------------------------------------------------
function Arena:GetCourseStartCFrame()
	local position = Vector3.new(COURSE.startX - math.random(4, 16), COURSE.y + 3.5, COURSE.z + math.random(-11, 11))
	return CFrame.lookAt(position, position + Vector3.new(1, 0, 0))
end

function Arena:GetGateCFrame(gate)
	local x0 = COURSE.startX + (gate - 1) * COURSE.sectionLength
	local position = Vector3.new(x0 + 4, COURSE.y + 3.5, COURSE.z + math.random(-8, 8))
	return CFrame.lookAt(position, position + Vector3.new(1, 0, 0))
end

function Arena:GetMergeCFrame(gate)
	local x0 = COURSE.startX + (gate - 1) * COURSE.sectionLength
	local position = Vector3.new(x0 + 33.5, COURSE.y + 3.5, COURSE.z)
	return CFrame.lookAt(position, position + Vector3.new(1, 0, 0))
end

function Arena:SetCourseBarrier(closed)
	local barrier = self.Course and self.Course:FindFirstChild("Penghalang")
	if barrier then
		barrier.CanCollide = closed
		barrier.Transparency = closed and 0 or 1
	end
end

function Arena:SetupGate(gate, prepared)
	local folder = self.Course and self.Course:FindFirstChild("Gerbang" .. gate)
	if not folder then
		return
	end
	local board = findPath(folder, "PapanSoal/Gui/Soal")
	if board then
		board.Text = prepared and prepared.text or ""
	end
	for lane = 1, 4 do
		local option = prepared and optionForPad(prepared, lane)
		local sign = folder:FindFirstChild("Tanda" .. lane)
		local blocker = folder:FindFirstChild("Blok" .. lane)
		local floor = folder:FindFirstChild("Jalur" .. lane)
		if sign then
			sign.Color = option and option.color or IDLE_PAD_COLOR
			local gui = sign:FindFirstChild("Gui")
			if gui then
				gui.Huruf.Text = option and option.letter or ""
				gui.Jawaban.Text = option and option.text or (prepared and "DIBLOKIR" or "")
			end
		end
		if blocker then
			local blocked = prepared ~= nil and option == nil
			blocker.CanCollide = blocked
			blocker.Transparency = blocked and 0.2 or 1
		end
		if floor then
			-- hanya jalur jawaban benar yang padat; jalur lain tampak sama tetapi tembus
			floor.CanCollide = (prepared == nil) or (prepared.correctPad == lane)
		end
	end
end

function Arena:ResetCourse()
	for gate = 1, COURSE.gates do
		self:SetupGate(gate, nil)
	end
	self:SetCourseBarrier(true)
end

-- zona: "start", "area", "pintu", "jalur", "gabung", "lompat", "finish", atau nil
function Arena:CourseZone(position)
	if position.Y < COURSE.y - 8 or position.Y > COURSE.y + 30 then
		return nil
	end
	if math.abs(position.Z - COURSE.z) > COURSE.width / 2 + 2 then
		return nil
	end
	local dx = position.X - COURSE.startX
	if dx < 0 then
		return 0, "start"
	end
	if position.X >= COURSE.finishX then
		return COURSE.gates + 1, "finish"
	end
	local gate = math.floor(dx / COURSE.sectionLength) + 1
	local offset = dx - (gate - 1) * COURSE.sectionLength
	local zone
	if offset < 16 then
		zone = "area"
	elseif offset < 17 then
		zone = "pintu"
	elseif offset < 31 then
		zone = "jalur"
	elseif offset < 36 then
		zone = "gabung"
	else
		zone = "lompat"
	end
	return gate, zone
end

function Arena:CelebrateFinish()
	local finish = self.Course and self.Course:FindFirstChild("Finish")
	local emitter = finish and finish:FindFirstChild("Konfeti")
	if emitter then
		emitter:Emit(60)
	end
end

---------------------------------------------------------------------
-- FUNGSI UTAMA
---------------------------------------------------------------------
function MapBuilder.Build()
	local folder = workspace:FindFirstChild(WORLD_NAME)
	if folder and not isValid(folder) then
		folder:Destroy()
		folder = nil
		workspace.Terrain:Clear()
	end
	if not folder then
		folder = buildWorld()
	end
	removeDefaults(folder)
	setupLighting()
	local arena = Arena.new(folder)
	arena:ResetCourse()
	arena:ResetPads(true)
	arena:SetStageQuestion(nil)
	return arena
end

MapBuilder.Course = COURSE

return MapBuilder
]]></string>
        </Properties>
      </Item>
      <Item class="Folder" referent="10">
        <Properties>
          <string name="Name">Modes</string>
        </Properties>
        <Item class="ModuleScript" referent="11">
          <Properties>
            <string name="Name">Firewall</string>
            <string name="Source"><![CDATA[--[[
	MODE "LINTASAN FIREWALL"
	Balapan di lintasan langit. Setiap gerbang punya soal dan 4 pintu jawaban.
	- Pintu BENAR: jalurnya kokoh, lanjut ke lompatan & gerbang berikutnya.
	- Pintu SALAH: lantainya tembus, siswa jatuh dan kembali ke depan gerbang (poin gerbang itu hangus).
	Poin hanya didapat jika memilih pintu yang benar pada percobaan PERTAMA.
	Bonus untuk siswa yang paling cepat mencapai FINISH.
]]

local Firewall = {}

function Firewall.StartCFrame(arena)
	return arena:GetCourseStartCFrame()
end

local GATE_SPEED_WINDOW = 20 -- detik: makin cepat melewati gerbang, makin besar bonus

local function gatePayload(Core, prepared, gate, total)
	return Core.questionPayload(prepared, gate, total, false, 0, 0, { type = "Gate" })
end

function Firewall.Prepare(Core)
	local Questions = Core.Questions
	local gates = Core.arena.CourseInfo.gates
	local list = Questions.Pick(Core.settings.topic, gates)
	if #list < gates then
		-- topik terlalu sedikit soalnya: lengkapi dengan soal campuran
		local seen = {}
		for _, q in ipairs(list) do
			seen[q] = true
		end
		for _, q in ipairs(Questions.Pick("campuran", gates * 2)) do
			if #list >= gates then
				break
			end
			if not seen[q] then
				table.insert(list, q)
				seen[q] = true
			end
		end
	end
	return list
end

function Firewall.Run(Core, list)
	local Config, Questions, arena = Core.Config, Core.Questions, Core.arena
	local info = arena.CourseInfo
	local gates = info.gates

	local prepared = {}
	for gate = 1, gates do
		local p = Questions.Prepare(list[gate], Config)
		p.id = Core.nextQuestionId()
		prepared[gate] = p
		arena:SetupGate(gate, p)
	end

	local startAt = Core.now()
	local endsAt = startAt + Config.FirewallTime
	local racers = {}
	for _, player in ipairs(Core.participants()) do
		racers[player] = { gate = 1, failed = {}, arriveAt = startAt, lastZone = "start", lastGate = 0, finished = false }
		Core.teleport(player, arena:GetCourseStartCFrame())
	end

	Core.phase = "Race"
	Core.flags.lock = false
	arena:SetCourseBarrier(false)
	Core.broadcast({ type = "Race", endsAt = endsAt, gates = gates }, true)
	Core.idleScreen("LINTASAN FIREWALL sedang berlangsung di langit! Pilih pintu jawaban yang benar!")
	for player, racer in pairs(racers) do
		Core.send(player, gatePayload(Core, prepared[racer.gate], racer.gate, gates))
	end

	Core.hintProvider = function(player, st)
		local racer = racers[player]
		if not racer or racer.finished or racer.gate > gates then
			return nil, "Bantuan tidak bisa dipakai sekarang."
		end
		local result, err = Core.fiftyFifty(prepared[racer.gate], st)
		if result then
			result.gate = racer.gate
		end
		return result, err
	end

	local finishOrder = {}
	local function allFinished()
		for player, racer in pairs(racers) do
			if player.Parent and not racer.finished then
				return false
			end
		end
		return true
	end

	local function passGate(player, racer, gate)
		local p = prepared[gate]
		local option = Core.correctOption(p)
		local extra = {
			gate = gate,
			correctLetter = option.letter,
			correctText = option.text,
			explanation = p.explanation,
		}
		if not racer.failed[gate] then
			Core.award(player, p.topic, true, {
				speed = 1 - (Core.now() - racer.arriveAt) / GATE_SPEED_WINDOW,
				extra = extra,
			})
		end
		racer.gate = gate + 1
		racer.arriveAt = Core.now()
		if racer.gate <= gates then
			Core.send(player, gatePayload(Core, prepared[racer.gate], racer.gate, gates))
		else
			Core.send(player, { type = "GateDone" })
		end
	end

	while Core.now() < endsAt and not Core.flags.stop and not Core.flags.lock and not allFinished() do
		for player, racer in pairs(racers) do
			local root = player.Parent and Core.rootOf(player)
			if root and not racer.finished then
				local position = root.Position
				if position.Y < info.y - 8 then
					-- JATUH dari lintasan
					if racer.lastZone == "jalur" and racer.lastGate == racer.gate and not racer.failed[racer.gate] then
						racer.failed[racer.gate] = true
						local p = prepared[racer.gate]
						local option = Core.correctOption(p)
						Core.award(player, p.topic, false, { extra = {
							gate = racer.gate,
							correctLetter = option.letter,
							correctText = option.text,
							explanation = p.explanation,
						} })
					end
					if racer.lastZone == "gabung" or racer.lastZone == "lompat" then
						Core.teleport(player, arena:GetMergeCFrame(racer.lastGate))
					elseif racer.gate == 1 and racer.lastZone == "start" then
						Core.teleport(player, arena:GetCourseStartCFrame())
					else
						Core.teleport(player, arena:GetGateCFrame(math.min(racer.gate, gates)))
					end
				else
					local gate, zone = arena:CourseZone(position)
					if zone then
						racer.lastZone, racer.lastGate = zone, gate
						if (zone == "gabung" or zone == "lompat") and gate == racer.gate then
							passGate(player, racer, gate)
						elseif zone == "finish" and racer.gate > gates then
							racer.finished = true
							table.insert(finishOrder, player)
							local place = #finishOrder
							local bonus = (Config.FinishBonus[place] or 0) + Config.FinishAllBonus
							Core.addBonus(player, bonus, "Finish urutan ke-" .. place .. "!")
							arena:CelebrateFinish()
							Core.broadcast({ type = "Finished", name = Core.displayName(player), place = place })
						end
					end
				end
			end
		end
		arena:SetScreen({ timer = tostring(math.max(0, math.ceil(endsAt - Core.now()))) })
		task.wait(0.1)
	end
	Core.hintProvider = nil
	arena:SetCourseBarrier(true)

	if not Core.flags.stop then
		-- gerbang yang belum dilewati dihitung salah (tanpa pesan)
		for player, racer in pairs(racers) do
			if player.Parent then
				for gate = racer.gate, gates do
					Core.award(player, prepared[gate].topic, false, { answered = false, silent = true })
				end
			end
		end
		local names = {}
		for place, player in ipairs(finishOrder) do
			table.insert(names, place .. ". " .. Core.displayName(player))
		end
		Core.broadcast({ type = "RaceEnd", finishers = names })
		Core.waitFor(3)
	end
	arena:ResetCourse()
	return gates
end

return Firewall
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="12">
          <Properties>
            <string name="Name">Kilat</string>
            <string name="Source"><![CDATA[--[[
	MODE "KUIS KILAT"
	Tombol jawaban muncul di layar setiap siswa. Jawab secepat mungkin!
	Jawaban tidak bisa diganti, jadi baca dengan teliti. Bonus kecepatan lebih besar.
]]

local Kilat = {}

function Kilat.StartCFrame(arena)
	return arena:GetStageCFrame()
end

local function ask(Core, q, index, total)
	local Config, arena = Core.Config, Core.arena
	local isBoss = index == total and total >= 5
	local prepared = Core.Questions.Prepare(q, Config)
	prepared.id = Core.nextQuestionId()
	local duration = (prepared.kind == "BS" and math.max(6, Config.KilatTime - 2) or Config.KilatTime) + (isBoss and 3 or 0)

	for _, player in ipairs(Core.participants()) do
		local st = Core.stats[player]
		st.choice, st.choiceTime = nil, nil
	end
	arena:SetStageQuestion(prepared)
	Core.current = prepared
	Core.phase = "Question"
	Core.flags.lock = false
	local startAt = Core.now()
	local endsAt = startAt + duration
	local valid = {}
	for _, option in ipairs(prepared.options) do
		valid[option.pad] = true
	end

	Core.hintProvider = function(_, st)
		if st.choice then
			return nil, "Kamu sudah menjawab soal ini."
		end
		return Core.fiftyFifty(prepared, st)
	end
	Core.answerHandler = function(player, questionId, pad)
		local st = Core.stats[player]
		if questionId ~= prepared.id or not st or st.choice or not valid[pad] or st.activeFrom > startAt then
			return
		end
		st.choice, st.choiceTime = pad, Core.now()
		Core.send(player, { type = "AnswerLocked", pad = pad })
	end

	Core.broadcast(Core.questionPayload(prepared, index, total, isBoss, endsAt, duration, { clickable = true }), true)
	Core.screenQuestion(prepared, index, total, isBoss, "KUIS KILAT: tekan tombol jawaban di layarmu secepat mungkin!")

	local function everyoneAnswered()
		local players = Core.participants(startAt)
		if #players == 0 then
			return false
		end
		for _, player in ipairs(players) do
			if not Core.stats[player].choice then
				return false
			end
		end
		return true
	end

	while Core.now() < endsAt and not Core.flags.lock and not Core.flags.stop and not everyoneAnswered() do
		arena:SetScreen({ timer = tostring(math.max(0, math.ceil(endsAt - Core.now()))) })
		task.wait(0.1)
	end
	Core.answerHandler = nil
	Core.hintProvider = nil
	Core.current = nil
	if Core.flags.stop then
		return false
	end

	Core.phase = "Reveal"
	local counts = { 0, 0, 0, 0 }
	local players = Core.participants(startAt)
	for _, player in ipairs(players) do
		local st = Core.stats[player]
		if st.choice then
			counts[st.choice] += 1
		end
	end
	for _, player in ipairs(players) do
		local st = Core.stats[player]
		Core.award(player, prepared.topic, st.choice == prepared.correctPad, {
			speed = 1 - ((st.choiceTime or endsAt) - startAt) / duration,
			speedMax = Config.KilatSpeedBonus,
			boss = isBoss,
			answered = st.choice ~= nil,
		})
	end
	Core.broadcast(Core.revealPayload(prepared, counts), true)
	arena:RevealStage(prepared.correctPad, counts)
	Core.screenReveal(prepared)

	if not Core.waitFor(Config.RevealTime + Config.ExplanationTime - 2) then
		return false
	end
	return true
end

function Kilat.Prepare(Core)
	return Core.Questions.Pick(Core.settings.topic, Core.settings.count)
end

function Kilat.Run(Core, list)
	for index, q in ipairs(list) do
		if not ask(Core, q, index, #list) then
			break
		end
	end
	return #list
end

return Kilat
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="13">
          <Properties>
            <string name="Name">Kotak</string>
            <string name="Source"><![CDATA[--[[
	MODE "LARI & PILIH"
	Soal muncul di layar besar. Siswa lari dan BERDIRI di kotak jawaban.
	Saat waktu habis, kotak yang salah jatuh ke Lubang Data.
]]

local Kotak = {}

function Kotak.StartCFrame(arena)
	return arena:GetStartCFrame()
end

local function ask(Core, q, index, total)
	local Config, arena, settings = Core.Config, Core.arena, Core.settings
	local isBoss = index == total and total >= 5
	local prepared = Core.Questions.Prepare(q, Config)
	prepared.id = Core.nextQuestionId()
	local duration = (prepared.kind == "BS" and Config.TrueFalseTime or settings.time) + (isBoss and 5 or 0)

	-- semua siswa kembali ke Garis Start agar adil
	for _, player in ipairs(Core.participants()) do
		Core.teleport(player, arena:GetStartCFrame())
		local st = Core.stats[player]
		st.choice, st.choiceTime = nil, nil
	end

	arena:SetQuestion(prepared)
	Core.current = prepared
	Core.phase = "Question"
	Core.flags.lock = false
	Core.hintProvider = function(_, st)
		return Core.fiftyFifty(prepared, st)
	end
	local startAt = Core.now()
	local endsAt = startAt + duration

	Core.broadcast(Core.questionPayload(prepared, index, total, isBoss, endsAt, duration), true)
	Core.screenQuestion(prepared, index, total, isBoss, prepared.kind == "BS"
		and "Pernyataan ini BENAR atau SALAH? Berdiri di kotak jawabanmu!"
		or "Lari dan BERDIRI di kotak jawaban yang benar sebelum waktu habis!")

	-- pantau posisi siswa sampai waktu habis
	while Core.now() < endsAt and not Core.flags.lock and not Core.flags.stop do
		local t = Core.now()
		for _, player in ipairs(Core.participants(startAt)) do
			local st = Core.stats[player]
			local root = Core.rootOf(player)
			local pad = root and arena:GetPadAt(root.Position) or nil
			if pad ~= st.choice then
				st.choice, st.choiceTime = pad, t
			end
		end
		arena:SetScreen({ timer = tostring(math.max(0, math.ceil(endsAt - t))) })
		task.wait(0.1)
	end
	Core.hintProvider = nil
	Core.current = nil
	if Core.flags.stop then
		return false
	end

	-- UNGKAP JAWABAN
	Core.phase = "Reveal"
	local counts = { 0, 0, 0, 0 }
	local players = Core.participants(startAt)
	for _, player in ipairs(players) do
		local st = Core.stats[player]
		if st.choice then
			counts[st.choice] += 1
		end
	end
	for _, player in ipairs(players) do
		local st = Core.stats[player]
		Core.award(player, prepared.topic, st.choice == prepared.correctPad, {
			speed = 1 - ((st.choiceTime or endsAt) - startAt) / duration,
			boss = isBoss,
			answered = st.choice ~= nil,
		})
	end
	Core.broadcast(Core.revealPayload(prepared, counts), true)
	arena:Reveal(prepared.correctPad, counts)
	Core.screenReveal(prepared)

	if not Core.waitFor(Config.RevealTime + Config.ExplanationTime) then
		return false
	end
	arena:ResetPads(false)
	return true
end

function Kotak.Prepare(Core)
	return Core.Questions.Pick(Core.settings.topic, Core.settings.count)
end

function Kotak.Run(Core, list)
	for index, q in ipairs(list) do
		if not ask(Core, q, index, #list) then
			break
		end
	end
	return #list
end

return Kotak
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="14">
          <Properties>
            <string name="Name">Sandi</string>
            <string name="Source"><![CDATA[--[[
	MODE "PECAHKAN SANDI"
	Siswa MENGETIK jawaban: soal isian singkat dan teka-teki Caesar Cipher.
	Ada beberapa kesempatan; setiap salah ketik mengurangi poin.
]]

local Sandi = {}

function Sandi.StartCFrame(arena)
	return arena:GetLabCFrame()
end

-- Petunjuk huruf: memperlihatkan sepertiga huruf pertama jawaban, contoh "R O _ _ _ _"
local function letterHint(display)
	local letters = {}
	for ch in string.gmatch(string.upper(display), "%w") do
		table.insert(letters, ch)
	end
	local reveal = math.max(1, math.ceil(#letters / 3))
	local parts = {}
	for i, ch in ipairs(letters) do
		table.insert(parts, i <= reveal and ch or "_")
	end
	return table.concat(parts, " ")
end

local function ask(Core, prepared, index, total)
	local Config, Questions, arena = Core.Config, Core.Questions, Core.arena
	local isBoss = index == total and total >= 5
	prepared.id = Core.nextQuestionId()
	local duration = Config.SandiTime + (isBoss and 10 or 0)

	for _, player in ipairs(Core.participants()) do
		Core.stats[player].sandi = { attempts = 0, done = false }
	end
	Core.current = prepared
	Core.phase = "Question"
	Core.flags.lock = false
	local startAt = Core.now()
	local endsAt = startAt + duration

	Core.hintProvider = function(_, st)
		if st.hintKey == prepared.id then
			return nil, "Petunjuk sudah dipakai di soal ini."
		end
		if st.sandi and st.sandi.done then
			return nil, "Kamu sudah selesai menjawab soal ini."
		end
		st.hintKey = prepared.id
		return { type = "huruf", text = letterHint(prepared.display) }
	end

	Core.textHandler = function(player, questionId, text)
		local st = Core.stats[player]
		if questionId ~= prepared.id or not st or not st.sandi or st.activeFrom > startAt then
			return { ok = false, message = "Soal ini sudah berakhir." }
		end
		local state = st.sandi
		if state.done then
			return { ok = false, message = "Kamu sudah selesai menjawab soal ini." }
		end
		text = string.sub(tostring(text or ""), 1, 40)
		if Questions.Normalize(text) == "" then
			return { ok = false, message = "Ketik jawabanmu dulu ya!" }
		end
		state.attempts += 1
		if Questions.CheckIsian(prepared, text) then
			state.done = true
			state.solved = true
			local gained = Core.award(player, prepared.topic, true, {
				speed = 1 - (Core.now() - startAt) / duration,
				boss = isBoss,
				penalty = (state.attempts - 1) * Config.SandiRetryPenalty,
			})
			return { ok = true, correct = true, gained = gained }
		end
		local left = Config.SandiAttempts - state.attempts
		if left <= 0 then
			state.done = true
			Core.award(player, prepared.topic, false, {})
			return { ok = true, correct = false, attemptsLeft = 0 }
		end
		return { ok = true, correct = false, attemptsLeft = left }
	end

	Core.broadcast(Core.questionPayload(prepared, index, total, isBoss, endsAt, duration, {
		attempts = Config.SandiAttempts,
		isCipher = prepared.isCipher == true,
		cipherText = prepared.cipherText,
	}), true)
	Core.screenQuestion(prepared, index, total, isBoss, "PECAHKAN SANDI: ketik jawabanmu di kotak yang muncul di layarmu!")

	local function everyoneDone()
		local players = Core.participants(startAt)
		if #players == 0 then
			return false
		end
		for _, player in ipairs(players) do
			if not Core.stats[player].sandi.done then
				return false
			end
		end
		return true
	end

	while Core.now() < endsAt and not Core.flags.lock and not Core.flags.stop and not everyoneDone() do
		arena:SetScreen({ timer = tostring(math.max(0, math.ceil(endsAt - Core.now()))) })
		task.wait(0.1)
	end
	Core.textHandler = nil
	Core.hintProvider = nil
	Core.current = nil
	if Core.flags.stop then
		return false
	end

	Core.phase = "Reveal"
	local solved = 0
	for _, player in ipairs(Core.participants(startAt)) do
		local state = Core.stats[player].sandi
		if state.solved then
			solved += 1
		elseif not state.done then
			-- belum selesai saat waktu habis = salah
			Core.award(player, prepared.topic, false, { answered = state.attempts > 0 })
			state.done = true
		end
	end
	Core.broadcast(Core.revealPayload(prepared, nil, { solved = solved, kind = "ISIAN" }), true)
	Core.screenReveal(prepared)

	return Core.waitFor(Config.RevealTime + Config.ExplanationTime)
end

function Sandi.Prepare(Core)
	return Core.Questions.PickIsian(Core.settings.topic, Core.settings.count)
end

function Sandi.Run(Core, list)
	for index, prepared in ipairs(list) do
		if not ask(Core, prepared, index, #list) then
			break
		end
	end
	return #list
end

return Sandi
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="ModuleScript" referent="15">
        <Properties>
          <string name="Name">PlayerData</string>
          <string name="Source"><![CDATA[--[[
	PlayerData: menyimpan data siswa (nama, absen, kelas), Poin Rank (xp), pet yang dipakai,
	jumlah ronde, dan statistik jawaban (DataStore).
	Jika DataStore tidak tersedia (misal API Services belum diaktifkan), data hanya
	disimpan selama sesi berjalan dan game tetap bisa dimainkan.
]]

local DataStoreService = game:GetService("DataStoreService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage:WaitForChild("QuizShared"):WaitForChild("Config"))

local PlayerData = {}

local cache = {}
local store = nil
local storeAvailable = false

if Config.UseDataStore then
	local ok, result = pcall(function()
		return DataStoreService:GetDataStore(Config.DataStoreName)
	end)
	if ok then
		store = result
		storeAvailable = true
	else
		warn("[NetQuest] DataStore tidak tersedia, XP tidak akan tersimpan permanen: " .. tostring(result))
	end
end

local function defaultData()
	return { xp = 0, rounds = 0, correct = 0, answered = 0, wins = 0, pet = "slime", profile = nil }
end

local function keyFor(player)
	return "siswa_" .. player.UserId
end

function PlayerData.Load(player)
	local data = defaultData()
	if storeAvailable then
		local ok, saved = pcall(function()
			return store:GetAsync(keyFor(player))
		end)
		if ok and type(saved) == "table" then
			for key, value in pairs(saved) do
				data[key] = value
			end
		elseif not ok then
			warn("[NetQuest] Gagal memuat data " .. player.Name .. ": " .. tostring(saved))
			storeAvailable = false -- hindari spam error (misal di Studio tanpa akses API)
		end
	end
	cache[player] = data
	return data
end

function PlayerData.Get(player)
	return cache[player] or defaultData()
end

function PlayerData.Save(player)
	local data = cache[player]
	if not data or not storeAvailable then
		return
	end
	local ok, err = pcall(function()
		store:SetAsync(keyFor(player), data)
	end)
	if not ok then
		warn("[NetQuest] Gagal menyimpan data " .. player.Name .. ": " .. tostring(err))
	end
end

function PlayerData.Release(player)
	PlayerData.Save(player)
	cache[player] = nil
end

function PlayerData.SaveAll()
	for player in pairs(cache) do
		PlayerData.Save(player)
	end
end

function PlayerData.SetProfile(player, profile)
	local data = cache[player]
	if data then
		data.profile = profile
		task.spawn(PlayerData.Save, player)
	end
end

function PlayerData.SetPet(player, petId)
	local data = cache[player]
	if data then
		data.pet = petId
	end
end

-- Mengembalikan gelar sekarang, gelar berikutnya (atau nil), dan indeks gelar
function PlayerData.GetRank(xp)
	local current, index = Config.Ranks[1], 1
	for i, rank in ipairs(Config.Ranks) do
		if xp >= rank.xp then
			current, index = rank, i
		end
	end
	return current, Config.Ranks[index + 1], index
end

-- Menambahkan hasil ronde. Mengembalikan data terbaru & apakah naik gelar.
function PlayerData.AddRoundResult(player, score, correct, answered, isWinner)
	local data = cache[player]
	if not data then
		return defaultData(), false
	end
	local _, _, before = PlayerData.GetRank(data.xp)
	data.xp += score
	data.rounds += 1
	data.correct += correct
	data.answered += answered
	if isWinner then
		data.wins += 1
	end
	local _, _, after = PlayerData.GetRank(data.xp)
	task.spawn(PlayerData.Save, player)
	return data, after > before
end

return PlayerData
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="16">
        <Properties>
          <string name="Name">Roster</string>
          <string name="Source"><![CDATA[--[[
	Roster: pendaftaran siswa (nama lengkap, nomor absen, kelas).
	- Siswa yang belum mendaftar tidak bisa bergerak dan tidak ikut kuis.
	- Nama & kelas disaring dengan filter teks Roblox sebelum ditampilkan ke pemain lain.
	- Data disimpan agar saat masuk lagi formulir sudah terisi otomatis.
	- Rekap nilai lengkap (nama asli) dicetak di Output/Developer Console untuk guru.
]]

local Players = game:GetService("Players")
local TextService = game:GetService("TextService")
local StarterPlayer = game:GetService("StarterPlayer")

local Roster = {}
local Core
local rawClass = {} -- [Player] = kelas asli (hanya di server, untuk cek absen ganda & urutan)

local function trim(text)
	return (string.gsub(text, "^%s*(.-)%s*$", "%1"))
end

local function filterForEveryone(text, player)
	local ok, result = pcall(function()
		local filtered = TextService:FilterStringAsync(text, player.UserId, Enum.TextFilterContext.PublicChat)
		return filtered:GetNonChatStringForBroadcastAsync()
	end)
	if ok then
		return result
	end
	warn("[NetQuest] Filter teks gagal: " .. tostring(result))
	return nil
end

---------------------------------------------------------------------
-- BEKUKAN / LEPAS KARAKTER
---------------------------------------------------------------------
local function canMove(player)
	return Core.isRegistered(player) or player:GetAttribute("SkipDaftar") == true
end

function Roster.ApplyMovement(player)
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not humanoid then
		return
	end
	if canMove(player) then
		humanoid.WalkSpeed = StarterPlayer.CharacterWalkSpeed
		humanoid.JumpPower = StarterPlayer.CharacterJumpPower
		humanoid.JumpHeight = StarterPlayer.CharacterJumpHeight
	else
		humanoid.WalkSpeed = 0
		humanoid.JumpPower = 0
		humanoid.JumpHeight = 0
	end
end

---------------------------------------------------------------------
-- PAPAN NAMA DI ATAS KEPALA
---------------------------------------------------------------------
function Roster.ApplyTag(player)
	local character = player.Character
	local head = character and character:FindFirstChild("Head")
	if not head then
		return
	end
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if humanoid then
		humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
	end
	local old = head:FindFirstChild("GelarTag")
	if old then
		old:Destroy()
	end
	local rank = Core.PlayerData.GetRank(Core.PlayerData.Get(player).xp)
	local tag = Instance.new("BillboardGui")
	tag.Name = "GelarTag"
	tag.Size = UDim2.fromScale(8, 2)
	tag.StudsOffset = Vector3.new(0, 3.2, 0)
	tag.MaxDistance = 90
	tag.LightInfluence = 0

	local nameLabel = Instance.new("TextLabel")
	nameLabel.BackgroundTransparency = 1
	nameLabel.Size = UDim2.fromScale(1, 0.55)
	nameLabel.Font = Enum.Font.GothamBold
	nameLabel.TextScaled = true
	nameLabel.TextColor3 = Color3.new(1, 1, 1)
	nameLabel.TextStrokeTransparency = 0.3
	local titleLabel = nameLabel:Clone()
	titleLabel.Position = UDim2.fromScale(0, 0.55)
	titleLabel.Size = UDim2.fromScale(1, 0.45)
	titleLabel.Font = Enum.Font.FredokaOne
	titleLabel.TextColor3 = rank.color

	if Core.isRegistered(player) then
		local kelas = player:GetAttribute("Kelas")
		nameLabel.Text = Core.displayName(player) .. ((kelas and kelas ~= "") and (" (" .. kelas .. ")") or "")
		titleLabel.Text = rank.name
	elseif player:GetAttribute("IsTeacher") then
		nameLabel.Text = player.DisplayName
		titleLabel.Text = "Guru"
		titleLabel.TextColor3 = Color3.fromRGB(255, 200, 90)
	else
		nameLabel.Text = player.DisplayName
		titleLabel.Text = "Belum mendaftar"
		titleLabel.TextColor3 = Color3.fromRGB(200, 200, 200)
	end
	nameLabel.Parent = tag
	titleLabel.Parent = tag
	tag.Parent = head
end

---------------------------------------------------------------------
-- PENDAFTARAN
---------------------------------------------------------------------
local function normalizeClass(kelas)
	return string.upper((string.gsub(kelas, "%s+", "")))
end

local function register(player, name, absen, kelas)
	if type(name) ~= "string" or type(absen) ~= "string" and type(absen) ~= "number" then
		return false, "Data tidak valid."
	end
	local Config = Core.Config
	name = trim(string.sub(name, 1, 60))
	name = string.gsub(name, "%s+", " ")
	if #name < Config.MinNameLength then
		return false, "Nama terlalu pendek. Tulis nama lengkapmu ya!"
	end
	if #name > Config.MaxNameLength then
		return false, "Nama terlalu panjang (maksimal " .. Config.MaxNameLength .. " huruf)."
	end
	if not string.match(name, "%a") then
		return false, "Nama harus berisi huruf."
	end
	local number = tonumber(absen)
	if not number or number ~= math.floor(number) or number < 1 or number > Config.MaxAbsen then
		return false, "Nomor absen harus angka 1 sampai " .. Config.MaxAbsen .. "."
	end
	if Config.AskClass then
		if type(kelas) ~= "string" then
			return false, "Isi kelasmu dulu (contoh: 7A)."
		end
		kelas = normalizeClass(string.sub(kelas, 1, 12))
		if #kelas < 1 or #kelas > 6 then
			return false, "Tulis kelas dengan singkat, contoh: 7A"
		end
	else
		kelas = ""
	end

	-- nomor absen tidak boleh sama dengan siswa lain di kelas yang sama
	for _, other in ipairs(Players:GetPlayers()) do
		if other ~= player and Core.isRegistered(other) and other:GetAttribute("Absen") == number
			and (rawClass[other] or "") == kelas then
			return false, "Absen " .. number .. (kelas ~= "" and (" kelas " .. kelas) or "")
				.. " sudah dipakai siswa lain. Periksa lagi nomor absenmu!"
		end
	end

	local shownName = filterForEveryone(name, player)
	local shownClass = kelas ~= "" and filterForEveryone(kelas, player) or ""
	if not shownName or not shownClass then
		return false, "Server sedang memeriksa nama. Coba tekan tombol lagi ya."
	end

	player:SetAttribute("Nama", shownName)
	player:SetAttribute("Absen", number)
	player:SetAttribute("Kelas", shownClass)
	rawClass[player] = kelas
	player:SetAttribute("Registered", true)
	Core.PlayerData.SetProfile(player, { nama = name, absen = number, kelas = kelas })

	local st = Core.stats[player]
	if st then
		st.activeFrom = Core.now()
	end
	Roster.ApplyMovement(player)
	Roster.ApplyTag(player)
	Core.updateLeaderstats(player)
	print(string.format("[NetQuest] Siswa terdaftar: %s | Absen %02d | Kelas %s", name, number, kelas))
	return true, "Selamat datang, " .. shownName .. "!"
end

function Roster.SendProfile(player)
	local data = Core.PlayerData.Get(player)
	local profile = data.profile
	Core.send(player, {
		type = "Profile",
		registered = Core.isRegistered(player),
		nama = profile and profile.nama or "",
		absen = profile and profile.absen or "",
		kelas = profile and profile.kelas or "",
		askClass = Core.Config.AskClass,
		maxAbsen = Core.Config.MaxAbsen,
	})
end

-- Daftar siswa untuk Panel Guru (nama yang sudah disaring)
local function rosterList()
	local list = {}
	for _, player in ipairs(Players:GetPlayers()) do
		if Core.isRegistered(player) then
			local st = Core.stats[player]
			local session = Core.getSession(player)
			local data = Core.PlayerData.Get(player)
			table.insert(list, {
				absen = player:GetAttribute("Absen"),
				nama = player:GetAttribute("Nama"),
				kelas = player:GetAttribute("Kelas") or "",
				kelasSort = rawClass[player] or "",
				roundScore = st and st.score or 0,
				correct = session.correct,
				answered = session.answered,
				sessionScore = session.score,
				xp = data.xp,
				title = Core.PlayerData.GetRank(data.xp).name,
			})
		end
	end
	table.sort(list, function(a, b)
		if a.kelasSort ~= b.kelasSort then
			return a.kelasSort < b.kelasSort
		end
		return a.absen < b.absen
	end)
	return list
end

-- Mencetak rekap nilai ke Output / Developer Console (F9 > Server) untuk guru
function Roster.PrintRecap(title)
	print("==================== [NetQuest] REKAP NILAI: " .. title .. " ====================")
	print("Kelas | Absen | Nama | Benar/Soal (sesi ini) | Nilai | Poin Sesi | Poin Rank")
	for _, player in ipairs(Players:GetPlayers()) do
		if Core.isRegistered(player) then
			local profile = Core.PlayerData.Get(player).profile or {}
			local session = Core.getSession(player)
			local nilai = session.answered > 0 and math.floor(session.correct / session.answered * 100 + 0.5) or 0
			print(string.format("%s | %02d | %s | %d/%d | %d | %d | %d", profile.kelas or "-", profile.absen or 0,
				profile.nama or player.Name, session.correct, session.answered, nilai, session.score, Core.PlayerData.Get(player).xp))
		end
	end
	print("=================================================================================")
end

function Roster.Init(core)
	Core = core
	Players.PlayerRemoving:Connect(function(player)
		rawClass[player] = nil
	end)
	Core.remotes.Register.OnServerInvoke = function(player, name, absen, kelas, skipAsTeacher)
		if skipAsTeacher == true then
			if player:GetAttribute("IsTeacher") then
				player:SetAttribute("SkipDaftar", true)
				Roster.ApplyMovement(player)
				Roster.ApplyTag(player)
				return true, "Masuk sebagai guru."
			end
			return false, "Hanya guru yang boleh melewati pendaftaran."
		end
		return register(player, name, absen, kelas)
	end
	Core.remotes.GetRoster.OnServerInvoke = function(player)
		if not player:GetAttribute("IsTeacher") then
			return nil
		end
		return rosterList()
	end
end

return Roster
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="StarterPlayer" referent="17">
    <Properties>
      <string name="Name">StarterPlayer</string>
    </Properties>
    <Item class="StarterPlayerScripts" referent="18">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="LocalScript" referent="19">
        <Properties>
          <string name="Name">QuizClient</string>
          <string name="Source"><![CDATA[--[[
	NET QUEST - Client (tampilan di layar pemain)

	Tata letak (dirancang untuk 1280x720, otomatis mengecil di HP):
	  kiri tengah  : kartu poin + tombol Bantuan, Pet, Materi, Panduan, (Guru)
	  atas tengah  : kartu soal + pilihan jawaban (mode lari) / pengumuman lobi
	  bawah tengah : tombol jawaban besar (Kuis Kilat) / kotak ketik (Pecahkan Sandi) / penjelasan
	  tengah       : kartu pengenalan game, hasil tiap game, hasil akhir, jendela-jendela
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local SoundService = game:GetService("SoundService")
local ProximityPromptService = game:GetService("ProximityPromptService")
local StarterGui = game:GetService("StarterGui")

local player = Players.LocalPlayer
local Shared = ReplicatedStorage:WaitForChild("QuizShared")
local Config = require(Shared:WaitForChild("Config"))
local Materi = require(Shared:WaitForChild("Materi"))
local PetCatalog = require(Shared:WaitForChild("PetCatalog"))
local Ui = require(script:WaitForChild("Ui"))
local Registration = require(script:WaitForChild("Registration"))
local Pets = require(script:WaitForChild("Pets"))
local T, F = Ui.Theme, Ui.Font

local remotesFolder = ReplicatedStorage:WaitForChild("QuizRemotes")
local remotes = {}
for _, name in ipairs({ "QuizEvent", "TeacherCommand", "ClientReady", "Answer", "EquipPet", "UseHint", "Register", "SubmitText", "GetRoster" }) do
	remotes[name] = remotesFolder:WaitForChild(name)
end

---------------------------------------------------------------------
-- STATE
---------------------------------------------------------------------
local state = {
	mode = "idle", -- idle / waiting / intermission / intro / question / explain / race / break / results
	gameMode = nil, -- id game yang sedang dimainkan (kotak/kilat/firewall/sandi)
	gameName = "",
	endsAt = 0,
	duration = 1,
	lastSecond = -1,
	options = {},
	kind = "PG",
	questionId = nil,
	clickable = false,
	locked = false,
	myPad = nil,
	hints = 0,
	hintUsed = false,
	score = 0,
	streak = 0,
	settings = nil,
	hiddenPads = {},
	savedPadColors = {},
	raceEndsAt = 0,
	raceDuration = 1,
	gate = nil,
	explainEndsAt = 0,
	explainDuration = 1,
	sandiDone = false,
	sandiBusy = false,
	adventure = nil, -- { index = n, games = { {name, color}, ... } }
	modeColor = T.Primary,
	nextName = "",
}

local function serverNow()
	return workspace:GetServerTimeNow()
end

-- Daftar pemain bawaan Roblox (pojok kanan atas) menutupi kartu soal, jadi disembunyikan selama game berlangsung.
local function showPlayerList(visible)
	pcall(function()
		StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.PlayerList, visible)
	end)
end

---------------------------------------------------------------------
-- SUARA
---------------------------------------------------------------------
local sounds = {}
for name, id in pairs(Config.Sounds) do
	if id ~= "" then
		sounds[name] = Ui.new("Sound", { Name = "NetQuest_" .. name, SoundId = id, Volume = 0.5, Parent = SoundService })
	end
end
if Config.MusicId ~= "" then
	Ui.new("Sound", { Name = "NetQuest_Musik", SoundId = Config.MusicId, Volume = 0.2, Looped = true, Parent = SoundService }):Play()
end
local function play(name)
	local sound = sounds[name]
	if sound then
		sound:Play()
	end
end

---------------------------------------------------------------------
-- ROOT GUI + skala otomatis
---------------------------------------------------------------------
local gui = Ui.new("ScreenGui", {
	Name = "NetQuestGui",
	ResetOnSpawn = false,
	ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
	Parent = player:WaitForChild("PlayerGui"),
})

local pixelScales = {}
local currentScale = 1
local function addPixelScale(frame)
	local scale = Ui.new("UIScale", { Name = "SkalaLayar", Scale = currentScale, Parent = frame })
	scale:SetAttribute("Dasar", currentScale)
	table.insert(pixelScales, scale)
	return scale
end
local function updatePixelScales()
	local camera = workspace.CurrentCamera
	if not camera then
		return
	end
	local size = camera.ViewportSize
	currentScale = math.clamp(math.min(size.X / 1280, size.Y / 720), 0.55, 1.1)
	for _, scale in ipairs(pixelScales) do
		scale.Scale = currentScale
		scale:SetAttribute("Dasar", currentScale)
	end
end

local flash = Ui.new("Frame", { Name = "Kilat", Size = UDim2.fromScale(1, 1), BackgroundColor3 = T.Good,
	BackgroundTransparency = 1, BorderSizePixel = 0, ZIndex = 0, Parent = gui })
local function flashScreen(color)
	flash.BackgroundColor3 = color
	flash.BackgroundTransparency = 0.7
	Ui.tween(flash, 0.7, { BackgroundTransparency = 1 })
end

local function formatTime(seconds)
	seconds = math.max(0, math.ceil(seconds))
	if seconds >= 60 then
		return string.format("%d:%02d", math.floor(seconds / 60), seconds % 60)
	end
	return tostring(seconds)
end

---------------------------------------------------------------------
-- MODAL (jendela di tengah layar)
---------------------------------------------------------------------
local openModals = {}
local function closeAllModals()
	for _, modal in pairs(openModals) do
		modal.Visible = false
	end
end

-- mengembalikan holder, body, area konten (di bawah judul), label judul
local function makeModal(name, titleText, width, height, accent)
	local holder, body = Ui.card({ Name = name, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(width, height), Visible = false, ZIndex = 5, Parent = gui }, { radius = 22, clip = true })
	addPixelScale(holder)
	local header = Ui.band({ Name = "Kepala", Size = UDim2.new(1, 0, 0, 64), BackgroundColor3 = accent or T.Paper,
		BackgroundTransparency = accent and 0 or 1, ZIndex = 5, Parent = body }, 22)
	header.Penutup.BackgroundTransparency = header.BackgroundTransparency
	local title = Ui.text({ Name = "Judul", Position = UDim2.fromOffset(24, 0), Size = UDim2.new(1, -90, 1, 0), Text = titleText,
		Font = F.Display, TextSize = 26, TextColor3 = accent and T.White or T.Ink, TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 5,
		Parent = header })
	if not accent then
		Ui.new("Frame", { Position = UDim2.new(0, 0, 1, -1), Size = UDim2.new(1, 0, 0, 1), BackgroundColor3 = T.Line, BorderSizePixel = 0,
			ZIndex = 5, Parent = header })
	end
	local close = Ui.button({ AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -16, 0.5, 0), Size = UDim2.fromOffset(40, 40),
		Text = "×", TextSize = 28, Font = F.Bold, Radius = 20, ZIndex = 6 }, function()
		holder.Visible = false
	end, "neutral")
	close.Parent = header
	local content = Ui.new("Frame", { Name = "Konten", Position = UDim2.fromOffset(0, 64), Size = UDim2.new(1, 0, 1, -64),
		BackgroundTransparency = 1, ZIndex = 5, Parent = body })
	openModals[name] = holder
	return holder, body, content, title
end

local function scrollList(parent, props)
	local frame = Ui.new("ScrollingFrame", {
		Position = props.Position or UDim2.new(),
		Size = props.Size or UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 5,
		ScrollBarImageColor3 = T.InkSoft,
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ZIndex = 5,
		Parent = parent,
	})
	Ui.list(frame, Enum.FillDirection.Vertical, props.gap or 8)
	Ui.padding(frame, 2, 10, 10, 2)
	return frame
end

---------------------------------------------------------------------
-- KIRI: KARTU POIN + TOMBOL
---------------------------------------------------------------------
local rail = Ui.new("Frame", { Name = "PanelKiri", AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 16, 0.5, 0),
	Size = UDim2.fromOffset(204, 330), BackgroundTransparency = 1, Parent = gui })
addPixelScale(rail)
Ui.list(rail, Enum.FillDirection.Vertical, 10)

local scoreHolder, scoreCard = Ui.card({ Name = "KartuPoin", Size = UDim2.fromOffset(204, 150), Parent = rail }, { dark = true, radius = 18 })
scoreHolder.LayoutOrder = 1
Ui.padding(scoreCard, 14, 16, 14, 16)
Ui.text({ Size = UDim2.new(1, 0, 0, 16), Text = "POIN TOTAL", Font = F.Black, TextSize = 13, TextColor3 = Color3.fromRGB(160, 170, 210),
	TextXAlignment = Enum.TextXAlignment.Left, Parent = scoreCard })
local scoreLabel = Ui.text({ Position = UDim2.fromOffset(0, 16), Size = UDim2.new(1, 0, 0, 40), Text = "0", Font = F.Display, TextSize = 36,
	TextColor3 = T.Gold, TextXAlignment = Enum.TextXAlignment.Left, Parent = scoreCard })
local streakChip = Ui.chip({ AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, 0, 0, -3), Size = UDim2.fromOffset(0, 20), Text = "STREAK 0",
	TextSize = 11, Visible = false, Parent = scoreCard }, T.Orange)
Ui.new("Frame", { Position = UDim2.fromOffset(0, 66), Size = UDim2.new(1, 0, 0, 1), BackgroundColor3 = Color3.new(1, 1, 1),
	BackgroundTransparency = 0.85, BorderSizePixel = 0, Parent = scoreCard })
local rankLabel = Ui.text({ Position = UDim2.fromOffset(0, 74), Size = UDim2.new(1, 0, 0, 18), Text = "Poin Rank 0", TextSize = 15,
	TextColor3 = T.White, TextXAlignment = Enum.TextXAlignment.Left, Parent = scoreCard })
local petBack, petFill = Ui.bar({ Position = UDim2.fromOffset(0, 98), Size = UDim2.new(1, 0, 0, 8) }, T.Pink, Color3.fromRGB(56, 62, 100))
petBack.Parent = scoreCard
local petProgressText = Ui.text({ Position = UDim2.fromOffset(0, 108), Size = UDim2.new(1, 0, 0, 16), Text = "", Font = F.Medium, TextSize = 12,
	TextColor3 = Color3.fromRGB(176, 184, 220), TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd,
	Parent = scoreCard })

local function useHint() end -- diisi di bawah
local hintButton = Ui.button({ LayoutOrder = 2, Size = UDim2.fromOffset(204, 44), Text = "BANTUAN  ·  0", TextSize = 16 }, function()
	useHint()
end, "dark")
hintButton.Parent = rail

local grid = Ui.new("Frame", { LayoutOrder = 3, Size = UDim2.fromOffset(204, 100), BackgroundTransparency = 1, Parent = rail })
Ui.new("UIGridLayout", { CellSize = UDim2.fromOffset(97, 46), CellPadding = UDim2.fromOffset(10, 8), SortOrder = Enum.SortOrder.LayoutOrder,
	Parent = grid })
local function railButton(order, text, color)
	local button = Ui.button({ LayoutOrder = order, Text = text, TextSize = 15, BackgroundColor3 = color }, nil, "dark")
	button.Parent = grid
	return button
end
local petButton = railButton(1, "PET", Color3.fromRGB(214, 84, 150))
local materiButton = railButton(2, "MATERI", Color3.fromRGB(38, 160, 110))
local helpButton = railButton(3, "PANDUAN", Color3.fromRGB(70, 96, 200))
