-- PANEL GURU
---------------------------------------------------------------------
local rosterHolder, _, rosterContent = makeModal("ModalSiswa", "Daftar Siswa & Nilai", 940, 580)
local rosterColumns = { { "KELAS", 0.09 }, { "ABSEN", 0.08 }, { "NAMA", 0.35 }, { "BENAR/SOAL", 0.15 }, { "NILAI", 0.1 }, { "POIN RANK", 0.23 } }
local function rosterRow(parent, order, values, header)
	local row = Ui.new("Frame", { LayoutOrder = order, Size = UDim2.new(1, -6, 0, 36), BackgroundColor3 = header and T.Ink or (order % 2 == 0
		and T.Paper2 or T.Paper), BorderSizePixel = 0, ZIndex = 5, Parent = parent })
	Ui.corner(row, 8)
	local x = 0
	for i, column in ipairs(rosterColumns) do
		Ui.text({ Position = UDim2.new(x, 10, 0, 0), Size = UDim2.new(column[2], -12, 1, 0), Text = tostring(values[i]),
			Font = header and F.Black or F.Bold, TextSize = header and 12 or 15, TextColor3 = header and T.White or T.Ink,
			TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd, ZIndex = 5, Parent = row })
		x += column[2]
	end
	return row
end
local rosterHeaderHolder = Ui.new("Frame", { Position = UDim2.fromOffset(24, 14), Size = UDim2.new(1, -48, 0, 36), BackgroundTransparency = 1,
	ZIndex = 5, Parent = rosterContent })
local headerValues = {}
for i, column in ipairs(rosterColumns) do
	headerValues[i] = column[1]
end
rosterRow(rosterHeaderHolder, 0, headerValues, true).Size = UDim2.fromScale(1, 1)
local rosterList = scrollList(rosterContent, { Position = UDim2.fromOffset(24, 56), Size = UDim2.new(1, -48, 1, -72), gap = 4 })

local function loadRoster()
	Ui.clear(rosterList)
	local ok, list = pcall(function()
		return remotes.GetRoster:InvokeServer()
	end)
	if not ok or type(list) ~= "table" then
		Ui.text({ Size = UDim2.new(1, 0, 0, 30), Text = "Gagal memuat daftar siswa.", TextColor3 = T.Bad, ZIndex = 5, Parent = rosterList })
		return
	end
	for i, s in ipairs(list) do
		local nilai = s.answered > 0 and math.floor(s.correct / s.answered * 100 + 0.5) or 0
		rosterRow(rosterList, i, { s.kelas, string.format("%02d", s.absen), s.nama, s.correct .. "/" .. s.answered, nilai,
			Ui.number(s.xp) .. " · " .. s.title })
	end
	if #list == 0 then
		Ui.text({ Size = UDim2.new(1, 0, 0, 30), Text = "Belum ada siswa yang mendaftar.", TextColor3 = T.InkSoft, ZIndex = 5, Parent = rosterList })
	end
end
local refreshRoster = Ui.button({ AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -70, 0, -32), Size = UDim2.fromOffset(140, 40),
	Text = "MUAT ULANG", TextSize = 14, ZIndex = 6 }, loadRoster, "primary")
refreshRoster.Parent = rosterContent

local function TeacherCommand(command, value)
	remotes.TeacherCommand:FireServer(command, value)
end

local teacherHolder, teacherRefresh
local function buildTeacherPanel()
	if teacherHolder then
		return
	end
	teacherButton.Visible = true
	local body
	teacherHolder, body = Ui.card({ Name = "PanelGuru", AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 236, 0.5, 0),
		Size = UDim2.fromOffset(320, 604), Visible = false, Parent = gui }, { radius = 20 })
	addPixelScale(teacherHolder)
	Ui.padding(body, 16, 18, 16, 18)
	Ui.list(body, Enum.FillDirection.Vertical, 8)
	Ui.text({ LayoutOrder = 1, Size = UDim2.new(1, 0, 0, 30), Text = "Panel Guru", Font = F.Display, TextSize = 24,
		TextXAlignment = Enum.TextXAlignment.Left, Parent = body })

	local function currentSetting(key, default)
		return state.settings and state.settings[key] or default
	end
	local function row(order, labelText)
		local frame = Ui.new("Frame", { LayoutOrder = order, Size = UDim2.new(1, 0, 0, 40), BackgroundTransparency = 1, Parent = body })
		Ui.text({ Size = UDim2.new(0.34, 0, 1, 0), Text = labelText, Font = F.Bold, TextSize = 14, TextColor3 = T.InkSoft,
			TextXAlignment = Enum.TextXAlignment.Left, Parent = frame })
		return frame
	end
	local function cycleButton(frame, list, key, command)
		local button = Ui.button({ Position = UDim2.new(0.36, 0, 0, 0), Size = UDim2.new(0.64, 0, 1, 0), Text = "", TextSize = 13,
			Font = F.Bold }, function()
			local currentId = currentSetting(key, list[1].id)
			local index = 1
			for i, item in ipairs(list) do
				if item.id == currentId then
					index = i
				end
			end
			TeacherCommand(command, list[index % #list + 1].id)
		end, "neutral")
		button.Parent = frame
		return button
	end
	local function stepper(frame, onMinus, onPlus)
		local minus = Ui.button({ Position = UDim2.new(0.36, 0, 0, 0), Size = UDim2.new(0.18, 0, 1, 0), Text = "–", TextSize = 22 }, onMinus, "neutral")
		minus.Parent = frame
		local value = Ui.text({ Position = UDim2.new(0.56, 0, 0, 0), Size = UDim2.new(0.24, 0, 1, 0), Text = "", Font = F.Display, TextSize = 20,
			Parent = frame })
		local plus = Ui.button({ Position = UDim2.new(0.82, 0, 0, 0), Size = UDim2.new(0.18, 0, 1, 0), Text = "+", TextSize = 22 }, onPlus, "neutral")
		plus.Parent = frame
		return value
	end

	local modeButton = cycleButton(row(2, "Mode"), Config.Modes, "mode", "mode")
	local topicButton = cycleButton(row(3, "Topik"), Config.Topics, "topic", "topic")
	local countValue = stepper(row(4, "Soal/game"), function()
		TeacherCommand("count", math.max(3, currentSetting("count", 5) - 1))
	end, function()
		TeacherCommand("count", math.min(30, currentSetting("count", 5) + 1))
	end)
	local timeValue = stepper(row(5, "Waktu/soal"), function()
		TeacherCommand("time", math.max(5, currentSetting("time", 20) - 5))
	end, function()
		TeacherCommand("time", math.min(60, currentSetting("time", 20) + 5))
	end)
	local autoButton = Ui.button({ LayoutOrder = 6, Size = UDim2.new(1, 0, 0, 40), Text = "", TextSize = 14 }, function()
		TeacherCommand("auto", not currentSetting("auto", true))
	end, "neutral")
	autoButton.Parent = body
	local buttons = {
		{ 7, "MULAI SEKARANG", "success", function() TeacherCommand("start") end },
		{ 8, "KUNCI JAWABAN / AKHIRI BALAPAN", "gold", function() TeacherCommand("lock") end },
		{ 9, "HENTIKAN SESI", "danger", function() TeacherCommand("stop") end },
		{ 10, "DAFTAR SISWA & NILAI", "primary", function()
			closeAllModals()
			rosterHolder.Visible = true
			loadRoster()
		end },
		{ 11, "CETAK REKAP KE OUTPUT", "dark", function()
			TeacherCommand("recap")
			showToast("Rekap dicetak", "Buka Developer Console (F9) > Server untuk menyalin rekap nilai.", T.White, 3.5)
		end },
	}
	for _, info in ipairs(buttons) do
		local button = Ui.button({ LayoutOrder = info[1], Size = UDim2.new(1, 0, 0, 44), Text = info[2], TextSize = 14 }, info[4], info[3])
		button.Parent = body
	end
	Ui.text({ LayoutOrder = 12, Size = UDim2.new(1, 0, 0, 30), Text = "Pengaturan baru berlaku di sesi berikutnya.", Font = F.Medium,
		TextSize = 13, TextColor3 = T.InkSoft, Parent = body })

	teacherButton.Activated:Connect(function()
		teacherHolder.Visible = not teacherHolder.Visible
	end)
	teacherRefresh = function()
		local settings = state.settings
		if not settings then
			return
		end
		modeButton.Text = settings.modeName
		topicButton.Text = settings.topicName
		countValue.Text = tostring(settings.count)
		timeValue.Text = settings.time .. "s"
		autoButton.Text = settings.auto and "Mulai otomatis: ON" or "Mulai otomatis: OFF (manual)"
		autoButton.BackgroundColor3 = settings.auto and Color3.fromRGB(214, 244, 226) or T.Paper2
	end
	teacherRefresh()
	updatePixelScales()
end

local function checkTeacher()
	if player:GetAttribute("IsTeacher") then
		buildTeacherPanel()
	end
end
player:GetAttributeChangedSignal("IsTeacher"):Connect(checkTeacher)
checkTeacher()

---------------------------------------------------------------------
-- BENDA 3D (deteksi posisi & efek bantuan lokal)
---------------------------------------------------------------------
local function arenaChild(path)
	local current = workspace:FindFirstChild("ArenaKuis")
	for _, name in ipairs(string.split(path, "/")) do
		current = current and current:FindFirstChild(name)
	end
	return current
end

local function padUnderMe()
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if not root then
		return nil
	end
	for _, option in ipairs(state.options) do
		local pad = arenaChild("KotakJawaban/Pad" .. option.pad)
		if pad then
			local rel = pad.CFrame:PointToObjectSpace(root.Position)
			local half = pad.Size / 2
			if math.abs(rel.X) <= half.X and math.abs(rel.Z) <= half.Z and rel.Y > -half.Y and rel.Y < 10 then
				return option.pad
			end
		end
	end
	return nil
end

local function restoreLocalPads()
	for index, color in pairs(state.savedPadColors) do
		local pad = arenaChild("KotakJawaban/Pad" .. index)
		if pad then
			pad.Color = color
		end
	end
	state.savedPadColors = {}
end

---------------------------------------------------------------------
-- PEMBARUAN TAMPILAN
---------------------------------------------------------------------
local function hintUsable()
	if state.hintUsed or state.hints <= 0 then
		return false
	end
	if state.mode == "question" then
		return (state.kind == "PG" and not state.locked) or (state.kind == "ISIAN" and not state.sandiDone)
	end
	return state.mode == "race" and state.kind == "PG" and state.gate ~= nil
end

local function updateHud()
	scoreLabel.Text = Ui.number(state.score)
	streakChip.Text = "STREAK " .. state.streak
	streakChip.Visible = state.streak >= 2
	local usable = hintUsable()
	hintButton.Text = (state.kind == "ISIAN" and "PETUNJUK HURUF" or "BANTUAN 50:50") .. "  ·  " .. state.hints
	hintButton.BackgroundColor3 = usable and Color3.fromRGB(140, 92, 246) or T.Night2
	hintButton.TextTransparency = (usable or state.hints > 0) and 0 or 0.45
	updateRankHud()
end

local function hideRoundUi()
	questionHolder.Visible = false
	optionsHolder.Visible = false
	sandiHolder.Visible = false
	explainHolder.Visible = false
	introHolder.Visible = false
	breakHolder.Visible = false
end

local function cardForPad(pad)
	for i, option in ipairs(state.options) do
		if option.pad == pad then
			return cards[i]
		end
	end
	return nil
end

local function setupCards(options, clickable)
	placeOptions(clickable)
	for i, card in ipairs(cards) do
		local option = options[i]
		card.button.Visible = option ~= nil
		card.button.Active = clickable
		card.button.Size = (#options == 2) and UDim2.new(0.4, -6, 1, 0) or UDim2.new(0.25, -8, 1, 0)
		card.you.Visible = false
		card.count.Visible = false
		card.ring.Thickness = 0
		card.face.BackgroundTransparency = 0
		card.shade.BackgroundTransparency = 0
		card.text.TextTransparency = 0
		card.face.Position = UDim2.new()
		if option then
			card.face.BackgroundColor3 = option.color
			card.shade.BackgroundColor3 = Ui.darker(option.color)
			card.letter.Text = option.letter
			card.letter.TextColor3 = option.color
			card.text.Text = option.text
		end
	end
end

local function dimCard(card)
	card.face.BackgroundTransparency = 0.55
	card.shade.BackgroundTransparency = 0.7
	card.text.TextTransparency = 0.35
end

local function showBanner(title, sub)
	bannerHolder.Visible = true
	bannerTitle.Text = title
	bannerSub.Text = sub or ""
end

local function lobbySubtitle()
	local s = state.settings
	if not s then
		return "Baca Zona Materi dan kunjungi Taman Pet sambil menunggu."
	end
	return s.modeName .. "  ·  " .. s.topicName .. "  ·  Baca Zona Materi sambil menunggu"
end

local function showQuestionCard(msg, counterText)
	questionHolder.Visible = true
	local adv = state.adventure
	local step = (adv and #adv.games > 1) and ("GAME " .. adv.index .. "/" .. #adv.games .. "  ·  ") or ""
	modeChip.Text = step .. string.upper(state.gameName or "")
	modeChip.BackgroundColor3 = state.modeColor
	topicLabel.Text = msg.topicName or ""
	counterLabel.Text = counterText
	counterLabel.Visible = not msg.isBoss
	bossChip.Visible = msg.isBoss == true
	setQuestionText(msg.text)
	choiceHint.Text = ""
	timerFill.BackgroundColor3 = state.modeColor
	Ui.pop(questionHolder, 0.92)
end

local handlers = {}

function handlers.Settings(msg)
	state.settings = msg
	if teacherRefresh then
		teacherRefresh()
	end
	if state.mode == "intermission" or state.mode == "waiting" then
		bannerSub.Text = lobbySubtitle()
	end
end

function handlers.Profile(msg)
	Registration.OnProfile(msg)
end

function handlers.Adventure(msg)
	state.adventure = { index = msg.index, games = msg.games }
end

function handlers.AdventureEnd()
	state.adventure = nil
end

function handlers.Waiting(msg)
	state.mode = "waiting"
	showPlayerList(true)
	hideRoundUi()
	showBanner(msg.reason == "teacher" and "Menunggu guru memulai" or "Menunggu siswa mendaftar", lobbySubtitle())
end

function handlers.Intermission(msg)
	state.mode = "intermission"
	showPlayerList(true)
	state.endsAt = msg.endsAt
	hideRoundUi()
	showBanner("Petualangan segera dimulai", lobbySubtitle())
end

function handlers.ModeIntro(msg)
	state.mode = "intro"
	state.gameMode = msg.modeId
	state.gameName = msg.modeName
	state.modeColor = msg.color
	state.endsAt = msg.endsAt
	state.lastSecond = -1
	state.options = {}
	showPlayerList(false)
	closeAllModals()
	hideRoundUi()
	bannerHolder.Visible = false
	introBand.BackgroundColor3 = msg.color
	countdownLabel.TextColor3 = msg.color
	introStep.Text = (msg.gameTotal and msg.gameTotal > 1) and ("GAME " .. msg.gameIndex .. " DARI " .. msg.gameTotal) or "GAME"
	introName.Text = msg.modeName
	introDesc.Text = msg.desc
	introInfo.Text = "Topik: " .. msg.topicName .. "   ·   " .. msg.total .. " soal"
	if state.adventure and #state.adventure.games > 1 then
		stepRow.Visible = true
		fillSteps(stepRow, state.adventure.games, msg.gameIndex, 145)
		introHolder.Size = UDim2.fromOffset(660, 320)
	else
		stepRow.Visible = false
		introHolder.Size = UDim2.fromOffset(660, 250)
	end
	introHolder.Visible = true
	Ui.pop(introHolder, 0.7)
	play("Question")
end

local function beginQuestion(msg)
	state.questionId = msg.id
	state.options = msg.options or {}
	state.kind = msg.kind
	state.myPad = nil
	state.locked = false
	state.hintUsed = false
	state.hiddenPads = {}
	restoreLocalPads()
	closeAllModals()
	bannerHolder.Visible = false
	explainHolder.Visible = false
	introHolder.Visible = false
	breakHolder.Visible = false
end

function handlers.Question(msg)
	beginQuestion(msg)
	state.mode = "question"
	state.endsAt = msg.endsAt
	state.duration = msg.duration
	state.lastSecond = -1
	state.clickable = msg.clickable == true
	state.sandiDone = false
	showQuestionCard(msg, "Soal " .. msg.index .. " dari " .. msg.total)

	if msg.kind == "ISIAN" then
		optionsHolder.Visible = false
		sandiHolder.Visible = true
		alphabet.Visible = msg.isCipher == true
		sandiBox.Text = ""
		sandiHint.Text = ""
		sandiInfo.TextColor3 = T.InkSoft
		sandiInfo.Text = "Kamu punya " .. (msg.attempts or 3) .. " kesempatan. Tekan Enter atau KIRIM."
		setSandiEnabled(true)
		choiceHint.Text = msg.isCipher and "Geser setiap huruf MUNDUR untuk membaca kata aslinya." or "Ketik jawaban singkat di kotak bawah."
		choiceHint.TextColor3 = T.InkSoft
	else
		sandiHolder.Visible = false
		setupCards(state.options, state.clickable)
		optionsHolder.Visible = true
		Ui.pop(optionsHolder, 0.9)
		if state.clickable then
			choiceHint.Text = "Tekan jawaban di bawah secepat mungkin!"
			choiceHint.TextColor3 = T.Primary
		end
	end
	updateHud()
	play("Question")
	if msg.isBoss then
		showToast("SOAL BOS", "Poin dikali " .. Config.BossMultiplier .. ". Fokus!", T.Gold, 2)
	end
end

function handlers.Race(msg)
	state.mode = "race"
	state.raceEndsAt = msg.endsAt
	state.raceDuration = math.max(1, msg.endsAt - serverNow())
	state.lastSecond = -1
	closeAllModals()
	hideRoundUi()
	bannerHolder.Visible = false
	showToast("BALAPAN DIMULAI!", "Masuk ke pintu jawaban yang benar.", T.Gold, 2.5)
	play("Correct")
end

function handlers.Gate(msg)
	beginQuestion(msg)
	state.mode = "race"
	state.gate = msg.index
	state.clickable = false
	showQuestionCard(msg, "Gerbang " .. msg.index .. " dari " .. msg.total)
	choiceHint.Text = "Masuk ke PINTU jawaban yang benar. Pintu salah membuatmu jatuh!"
	choiceHint.TextColor3 = T.InkSoft
	sandiHolder.Visible = false
	setupCards(state.options, false)
	optionsHolder.Visible = true
	updateHud()
end

function handlers.GateDone()
	state.gate = nil
	state.options = {}
	questionText.Text = "Semua gerbang sudah kamu lewati. Lompat terus ke FINISH!"
	counterLabel.Text = "Menuju finish"
	choiceHint.Text = ""
	optionsHolder.Visible = false
	updateHud()
end

function handlers.Finished(msg)
	showFeed(msg.name .. " mencapai finish urutan ke-" .. msg.place)
end

function handlers.RaceEnd(msg)
	state.mode = "explain"
	state.gate = nil
	hideRoundUi()
	local top = {}
	for i = 1, math.min(3, #msg.finishers) do
		table.insert(top, msg.finishers[i])
	end
	showToast("BALAPAN SELESAI", #top > 0 and table.concat(top, "   ") or "Belum ada yang mencapai finish.", T.Gold, 3)
end

function handlers.AnswerLocked(msg)
	state.locked = true
	for i, option in ipairs(state.options) do
		local card = cards[i]
		if option.pad == msg.pad then
			card.ring.Thickness = 4
			card.you.Text = "PILIHANMU"
			card.you.Visible = true
			card.face.Position = UDim2.fromOffset(0, 3)
			choiceHint.Text = "Jawabanmu terkunci: " .. option.letter .. ". " .. option.text
			choiceHint.TextColor3 = T.Good
		else
			dimCard(card)
		end
	end
	updateHud()
end

function handlers.Stats(msg)
	state.score, state.streak, state.hints = msg.score, msg.streak, msg.hints
	updateHud()
end

local cheers = { "BENAR!", "MANTAP!", "HEBAT!", "KEREN!", "JENIUS!" }
function handlers.Result(msg)
	state.score, state.streak, state.hints = msg.score, msg.streak, msg.hints
	if state.mode == "question" and state.kind ~= "ISIAN" then
		state.mode = "explain"
	end
	if msg.correct then
		local sub = "+" .. msg.gained .. " poin"
		if msg.streak >= 2 then
			sub ..= "   ·   streak " .. msg.streak
		end
		if msg.earnedHint then
			sub ..= "   ·   dapat bantuan"
			task.delay(0.4, function()
				play("Hint")
			end)
		end
		showToast(cheers[math.random(1, #cheers)], sub, Color3.fromRGB(110, 240, 160), 2.2)
		flashScreen(T.Good)
		play("Correct")
	elseif msg.answered then
		showToast("BELUM TEPAT", msg.gate and "Kamu jatuh. Coba pintu lain!" or "Tidak apa-apa, baca penjelasannya ya.",
			Color3.fromRGB(255, 130, 140), 2.2)
		flashScreen(T.Bad)
		play("Wrong")
	else
		showToast("WAKTU HABIS", "Kamu belum menjawab soal ini.", T.Gold, 2.2)
		play("Wrong")
	end
	if msg.gate and msg.explanation then
		local answer = msg.correctLetter .. ". " .. msg.correctText
		showExplain(msg.correct and ("Gerbang " .. msg.gate .. " benar: " .. answer) or ("Jawaban gerbang " .. msg.gate .. ": " .. answer),
			msg.correct, msg.explanation, serverNow() + (msg.correct and 4 or 6), 18)
	end
	Ui.pop(scoreHolder, 1.08)
	updateHud()
end

function handlers.Bonus(msg)
	state.score = msg.score
	showToast("+" .. msg.amount .. " BONUS", msg.reason, T.Gold, 3)
	play("Fanfare")
	updateHud()
end

function handlers.Reveal(msg)
	state.mode = "explain"
	restoreLocalPads()
	choiceHint.Text = ""
	timerNumber.Text = "–"
	if state.kind == "ISIAN" then
		-- kotak ketik tidak diperlukan lagi; penjelasan menempati posisinya
		setSandiEnabled(false)
		sandiHolder.Visible = false
		showExplain("Jawaban: " .. msg.correctText .. "   ·   " .. (msg.solved or 0) .. " siswa berhasil", true, msg.explanation, msg.explainEndsAt)
	else
		for i, option in ipairs(state.options) do
			local card = cards[i]
			card.count.Text = (msg.counts[option.pad] or 0) .. " pemain"
			card.count.Visible = true
			if option.pad == msg.correctPad then
				card.ring.Thickness = 4
				card.face.BackgroundTransparency = 0
				Ui.pop(card.button, 1.08)
			else
				dimCard(card)
			end
		end
		local prefix = state.kind == "PG" and (msg.correctLetter .. ". ") or ""
		showExplain("Jawaban benar: " .. prefix .. msg.correctText, true, msg.explanation, msg.explainEndsAt,
			state.clickable and (18 + 118 + 12) or 18)
	end
	updateHud()
end

function handlers.GameEnd(msg)
	state.mode = "break"
	state.endsAt = msg.endsAt
	state.lastSecond = -1
	state.nextName = msg.nextName
	hideRoundUi()
	closeAllModals()
	breakBand.BackgroundColor3 = msg.color
	breakStep.Text = "HASIL GAME " .. msg.gameIndex .. " DARI " .. msg.gameTotal
	breakTitle.Text = msg.modeName
	Ui.clear(breakLeft)
	Ui.clear(breakRight)
	for i = 1, math.min(5, #msg.gameRanking) do
		local row = msg.gameRanking[i]
		rankRow(breakLeft, i, row, row.userId == player.UserId, 38)
	end
	for i = 1, math.min(5, #msg.totalRanking) do
		local row = msg.totalRanking[i]
		rankRow(breakRight, i, row, row.userId == player.UserId, 38)
	end
	breakMine.Text = ""
	breakNext.Text = "Berikutnya: " .. msg.nextName
	breakHolder.Visible = true
	Ui.pop(breakHolder, 0.8)
	play("Fanfare")
end

function handlers.GameScore(msg)
	breakMine.Text = "Kamu: +" .. Ui.number(msg.gameScore) .. " poin di game ini (" .. msg.correct .. "/" .. msg.answered .. " benar)   ·   Total "
		.. Ui.number(msg.totalScore)
end

function handlers.RoundEnd(msg)
	state.mode = "results"
	state.options = {}
	state.gate = nil
	hideRoundUi()
	bannerHolder.Visible = false
	closeAllModals()
	hideToast() -- bonus tamat sudah tercantum di rapor
	resultsTitle.Text = "Hasil Akhir  ·  " .. (msg.modeName or "")
	showRanking(msg.ranking)
	Ui.clear(personal)
	personalLine(1, "Kamu belum ikut menjawab di sesi ini. Ikut sesi berikutnya ya!", T.InkSoft)
	resultsHolder.Visible = true
	Ui.pop(resultsHolder, 0.85)
	play("Fanfare")
end

function handlers.Summary(msg)
	showSummary(msg)
end

function handlers.Stopped()
	state.mode = "idle"
	state.options = {}
	state.gate = nil
	state.adventure = nil
	restoreLocalPads()
	hideRoundUi()
	showPlayerList(true)
	showToast("SESI DIHENTIKAN", "Guru menghentikan sesi ini.", T.Gold, 3)
end

remotes.QuizEvent.OnClientEvent:Connect(function(msg)
	local handler = type(msg) == "table" and handlers[msg.type]
	if handler then
		handler(msg)
	end
end)

---------------------------------------------------------------------
-- TOMBOL JAWABAN (Kuis Kilat)
---------------------------------------------------------------------
onCardClicked = function(index)
	if state.mode ~= "question" or not state.clickable or state.locked then
		return
	end
	local option = state.options[index]
	if not option or state.hiddenPads[option.pad] then
		return
	end
	state.locked = true
	play("Hint")
	remotes.Answer:FireServer(state.questionId, option.pad)
end

---------------------------------------------------------------------
-- BANTUAN (50:50 / petunjuk huruf)
---------------------------------------------------------------------
useHint = function()
	if not hintUsable() then
		if state.hints <= 0 then
			showToast("Bantuan habis", "Jawab benar " .. Config.HintEveryStreak .. "x berturut-turut untuk mendapatkannya.", T.White, 2)
		else
			showToast("Belum bisa", "Bantuan dipakai saat soal sedang berlangsung.", T.White, 2)
		end
		return
	end
	local ok, result, info = pcall(function()
		return remotes.UseHint:InvokeServer()
	end)
	if not ok or type(result) ~= "table" then
		showToast("Bantuan", (ok and info) or "Coba lagi.", T.White, 2.2)
		return
	end
	state.hints = info
	state.hintUsed = true
	play("Hint")
	if result.type == "huruf" then
		sandiHint.Text = "Petunjuk:  " .. result.text
		showToast("PETUNJUK", result.text, Color3.fromRGB(200, 170, 255), 2)
	else
		for _, padIndex in ipairs(result.pads) do
			state.hiddenPads[padIndex] = true
			local card = cardForPad(padIndex)
			if card then
				dimCard(card)
				card.letter.Text = "×"
			end
			if result.gate then
				local sign = arenaChild("LintasanFirewall/Gerbang" .. result.gate .. "/Tanda" .. padIndex)
				if sign then
					sign.Color = Color3.fromRGB(55, 55, 60)
					local answer = sign:FindFirstChild("Gui") and sign.Gui:FindFirstChild("Jawaban")
					if answer then
						answer.Text = "SALAH"
					end
				end
			else
				local pad = arenaChild("KotakJawaban/Pad" .. padIndex)
				if pad then
					state.savedPadColors[padIndex] = state.savedPadColors[padIndex] or pad.Color
					pad.Color = Color3.fromRGB(55, 55, 60)
				end
			end
		end
		showToast("50:50", "Dua jawaban salah sudah dihapus.", Color3.fromRGB(200, 170, 255), 2)
	end
	updateHud()
end

---------------------------------------------------------------------
-- LOOP PER FRAME: timer, hitung mundur, posisi pemain
---------------------------------------------------------------------
local lastPositionCheck = 0
local function setTimer(left, total)
	local ratio = math.clamp(left / math.max(total, 0.01), 0, 1)
	timerFill.Size = UDim2.fromScale(ratio, 1)
	local color = ratio < 0.3 and T.Bad or state.modeColor
	timerFill.BackgroundColor3 = color
	timerStroke.Color = color
	local seconds = math.ceil(left)
	if seconds ~= state.lastSecond then
		state.lastSecond = seconds
		timerNumber.Text = formatTime(left)
		return seconds
	end
	return nil
end

RunService.RenderStepped:Connect(function()
	local t = serverNow()
	local left = math.max(0, state.endsAt - t)

	if state.mode == "question" then
		local changed = setTimer(left, state.duration)
		if changed and changed <= 5 and changed > 0 then
			play("Tick")
			Ui.pop(timerCircle, 1.2)
		end
		if not state.clickable and state.kind ~= "ISIAN" and os.clock() - lastPositionCheck > 0.1 then
			lastPositionCheck = os.clock()
			local pad = padUnderMe()
			if pad ~= state.myPad then
				state.myPad = pad
				for _, card in ipairs(cards) do
					card.you.Visible = false
					card.ring.Thickness = 0
				end
				local card = pad and cardForPad(pad)
				if card then
					card.you.Text = "POSISIMU"
					card.you.Visible = true
					card.ring.Thickness = 4
					Ui.pop(card.button, 1.06)
				end
			end
			if pad then
				local option
				for _, o in ipairs(state.options) do
					if o.pad == pad then
						option = o
					end
				end
				local letter = state.kind == "PG" and (option.letter .. ". ") or ""
				choiceHint.Text = "Jawabanmu: " .. letter .. option.text
				choiceHint.TextColor3 = state.hiddenPads[pad] and T.Bad or T.Primary
			elseif left <= 5 then
				choiceHint.Text = (math.floor(t * 3) % 2 == 0) and "CEPAT! Berdiri di kotak jawaban!" or ""
				choiceHint.TextColor3 = T.Bad
			else
				choiceHint.Text = "Lari ke kotak jawaban pilihanmu."
				choiceHint.TextColor3 = T.InkSoft
			end
		end
	elseif state.mode == "race" then
		local changed = setTimer(math.max(0, state.raceEndsAt - t), state.raceDuration)
		if changed and changed <= 10 and changed > 0 then
			play("Tick")
		end
	elseif state.mode == "intermission" then
		bannerTitle.Text = "Petualangan dimulai dalam " .. math.ceil(left) .. " detik"
	elseif state.mode == "intro" then
		local seconds = math.ceil(left)
		if seconds ~= state.lastSecond then
			state.lastSecond = seconds
			countdownLabel.Text = seconds > 0 and tostring(seconds) or "GO"
			Ui.pop(countCircle, 1.25)
			if seconds <= 3 then
				play(seconds > 0 and "Tick" or "Correct")
			end
		end
	elseif state.mode == "break" then
		local seconds = math.ceil(left)
		if seconds ~= state.lastSecond then
			state.lastSecond = seconds
			breakNext.Text = "Berikutnya: " .. state.nextName .. "   ·   mulai dalam " .. seconds .. " detik"
		end
	end

	if explainHolder.Visible then
		local explainLeft = state.explainEndsAt - t
		explainFill.Size = UDim2.fromScale(math.clamp(explainLeft / state.explainDuration, 0, 1), 1)
		if explainLeft <= -0.5 and state.mode ~= "explain" then
			explainHolder.Visible = false
		end
	end
end)

workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(updatePixelScales)
if workspace.CurrentCamera then
	workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(updatePixelScales)
end
updatePixelScales()
updateHud()
remotes.ClientReady:FireServer()
]]></string>
        </Properties>
        <Item class="ModuleScript" referent="20">
          <Properties>
            <string name="Name">Pets</string>
            <string name="Source"><![CDATA[--[[
	Pets (client): menggambar pet yang mengikuti setiap pemain, menu koleksi pet,
	dan jendela "PET BARU TERBUKA!".
	Pet digambar di setiap layar secara lokal (ringan, tidak membebani server).
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local PetCatalog = require(ReplicatedStorage:WaitForChild("QuizShared"):WaitForChild("PetCatalog"))

local Pets = {}

local localPlayer = Players.LocalPlayer
local active = {} -- [Player] = { model, petId, character, cframe }
local petFolder = Instance.new("Folder")
petFolder.Name = "PetLokal"
petFolder.Parent = workspace

---------------------------------------------------------------------
-- PET MENGIKUTI PEMAIN
---------------------------------------------------------------------
local function removePet(player)
	local entry = active[player]
	if entry then
		entry.model:Destroy()
		active[player] = nil
	end
end

local function refresh(player)
	local petId = player:GetAttribute("Pet")
	local character = player.Character
	local entry = active[player]
	if entry and (entry.petId ~= petId or entry.character ~= character) then
		removePet(player)
		entry = nil
	end
	if entry or not petId or petId == "" or not character or not PetCatalog.Get(petId) then
		return
	end
	local root = character:FindFirstChild("HumanoidRootPart")
	local model = PetCatalog.Build(petId)
	local start = root and root.CFrame * CFrame.new(3, 0, 3) or CFrame.new()
	model:PivotTo(start)
	model.Parent = petFolder
	active[player] = { model = model, petId = petId, character = character, cframe = start, seed = math.random() * 10 }
end

local function watchPlayer(player)
	player:GetAttributeChangedSignal("Pet"):Connect(function()
		refresh(player)
	end)
	player.CharacterAdded:Connect(function(character)
		character:WaitForChild("HumanoidRootPart", 10)
		refresh(player)
	end)
	player.CharacterRemoving:Connect(function()
		removePet(player)
	end)
	refresh(player)
end

for _, player in ipairs(Players:GetPlayers()) do
	watchPlayer(player)
end
Players.PlayerAdded:Connect(watchPlayer)
Players.PlayerRemoving:Connect(removePet)

RunService.RenderStepped:Connect(function(dt)
	local camera = workspace.CurrentCamera
	local cameraPos = camera and camera.CFrame.Position or Vector3.zero
	local t = os.clock()
	for player, entry in pairs(active) do
		local root = entry.character and entry.character:FindFirstChild("HumanoidRootPart")
		if not root or not entry.model.Parent then
			removePet(player)
		elseif (root.Position - cameraPos).Magnitude < 160 then
			local info = PetCatalog.Get(entry.petId)
			local look = root.CFrame.LookVector * Vector3.new(1, 0, 1)
			if look.Magnitude < 0.1 then
				look = Vector3.new(0, 0, -1)
			end
			local base = CFrame.lookAt(root.Position, root.Position + look.Unit)
			local moving = root.AssemblyLinearVelocity.Magnitude > 2
			local bob
			if info.flying then
				bob = 1.6 + math.sin(t * 2.5 + entry.seed) * 0.5
			else
				bob = -1.95 + (moving and math.abs(math.sin(t * 9 + entry.seed)) * 0.6 or 0)
			end
			local target = base * CFrame.new(3, bob, 3)
			entry.cframe = entry.cframe:Lerp(target, math.clamp(dt * 7, 0, 1))
			entry.model:PivotTo(entry.cframe)
		end
	end
end)


---------------------------------------------------------------------
-- PRATINJAU PET (ViewportFrame)
---------------------------------------------------------------------
local function viewport(parent, petId, props)
	local frame = Instance.new("ViewportFrame")
	frame.BackgroundTransparency = 1
	frame.Ambient = Color3.fromRGB(200, 200, 210)
	frame.LightColor = Color3.new(1, 1, 1)
	frame.LightDirection = Vector3.new(-1, -1, 1)
	for key, value in pairs(props or {}) do
		frame[key] = value
	end
	local model = PetCatalog.Build(petId)
	model:PivotTo(CFrame.new())
	model.Parent = frame
	local camera = Instance.new("Camera")
	camera.FieldOfView = 40
	camera.CFrame = CFrame.lookAt(Vector3.new(3.2, 1.8, -6.5), Vector3.new(0, 0.3, 0))
	camera.Parent = frame
	frame.CurrentCamera = camera
	frame.Parent = parent
	return frame, camera
end

---------------------------------------------------------------------
-- MENU KOLEKSI & JENDELA PET BARU
---------------------------------------------------------------------
function Pets.Init(ctx)
	local Ui = ctx.Ui
	local T, F = Ui.Theme, Ui.Font
	local LOCKED_TINT = Color3.fromRGB(44, 48, 78)

	-- MENU KOLEKSI (920 x 580; area konten 516 tinggi)
	local menu, _, menuContent = ctx.makeModal("ModalPet", "Koleksi Pet", 920, 580)

	local strip = Ui.new("Frame", { Name = "Ringkasan", Position = UDim2.fromOffset(24, 16), Size = UDim2.new(1, -48, 0, 72),
		BackgroundColor3 = T.Paper2, BorderSizePixel = 0, ZIndex = 5, Parent = menuContent })
	Ui.corner(strip, 16)
	Ui.text({ Position = UDim2.fromOffset(20, 12), Size = UDim2.fromOffset(200, 16), Text = "POIN RANK KAMU", Font = F.Black, TextSize = 13,
		TextColor3 = T.InkSoft, TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 5, Parent = strip })
	local xpLabel = Ui.text({ Position = UDim2.fromOffset(20, 28), Size = UDim2.fromOffset(200, 34), Text = "0", Font = F.Display, TextSize = 30,
		TextColor3 = T.Ink, TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 5, Parent = strip })
	local nextLabel = Ui.text({ Position = UDim2.fromOffset(240, 14), Size = UDim2.new(1, -460, 0, 18), Text = "", Font = F.Bold, TextSize = 15,
		TextColor3 = T.Ink, TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd, ZIndex = 5, Parent = strip })
	local nextBack, nextFill = Ui.bar({ Position = UDim2.fromOffset(240, 42), Size = UDim2.new(1, -460, 0, 10), ZIndex = 5 }, T.Pink, T.Line)
	nextBack.Parent = strip
	nextFill.ZIndex = 5
	local remainLabel = Ui.text({ AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -20, 0.5, 0), Size = UDim2.fromOffset(190, 40),
		Text = "", Font = F.Black, TextSize = 16, TextColor3 = T.Pink, TextXAlignment = Enum.TextXAlignment.Right, ZIndex = 5, Parent = strip })

	local grid = Ui.new("ScrollingFrame", { Position = UDim2.fromOffset(24, 104), Size = UDim2.new(1, -48, 1, -116), BackgroundTransparency = 1,
		BorderSizePixel = 0, ScrollBarThickness = 5, ScrollBarImageColor3 = T.InkSoft, CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y, ZIndex = 5, Parent = menuContent })
	Ui.new("UIGridLayout", { CellSize = UDim2.fromOffset(164, 192), CellPadding = UDim2.fromOffset(10, 12), SortOrder = Enum.SortOrder.LayoutOrder,
		Parent = grid })

	local cards = {}
	for order, pet in ipairs(PetCatalog.List) do
		local rarityColor = PetCatalog.Rarities[pet.rarity]
		local card = Ui.new("Frame", { Name = pet.id, LayoutOrder = order, BackgroundColor3 = T.Paper, BorderSizePixel = 0, ZIndex = 5,
			Parent = grid })
		Ui.corner(card, 16)
		local stroke = Ui.stroke(card, T.Line, 1.5)
		local stage = Ui.new("Frame", { Name = "Panggung", Position = UDim2.fromOffset(8, 8), Size = UDim2.new(1, -16, 0, 96),
			BackgroundColor3 = rarityColor, BackgroundTransparency = 0.78, BorderSizePixel = 0, ZIndex = 5, Parent = card })
		Ui.corner(stage, 12)
		local view = viewport(stage, pet.id, { Size = UDim2.fromScale(1, 1), ZIndex = 5 })
		Ui.chip({ Position = UDim2.fromOffset(6, 6), Size = UDim2.fromOffset(0, 20), Text = string.upper(pet.rarity), TextSize = 11, ZIndex = 6,
			Parent = stage }, Ui.darker(rarityColor, 0.3))
		local name = Ui.text({ Position = UDim2.fromOffset(10, 110), Size = UDim2.new(1, -20, 0, 22), Text = pet.name, Font = F.Display,
			TextSize = 17, Scaled = true, MaxTextSize = 17, TextColor3 = T.Ink, TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 5,
			Parent = card })
		local requirement = Ui.text({ Position = UDim2.fromOffset(10, 132), Size = UDim2.new(1, -20, 0, 16), Text = "", Font = F.Medium,
			TextSize = 13, TextColor3 = T.InkSoft, TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 5, Parent = card })
		local button = Ui.button({ Position = UDim2.new(0, 8, 1, -38), Size = UDim2.new(1, -16, 0, 30), Text = "", TextSize = 14, Radius = 10,
			ZIndex = 6 }, function()
			local xp = localPlayer:GetAttribute("PoinRank") or 0
			if PetCatalog.IsUnlocked(pet.id, xp) then
				ctx.remotes.EquipPet:FireServer(pet.id)
				ctx.play("Hint")
			else
				ctx.showToast("Masih terkunci", "Kumpulkan " .. Ui.number(pet.xp - xp) .. " Poin Rank lagi untuk membuka pet ini.", T.Gold, 2.5)
			end
		end)
		button.Parent = card
		cards[pet.id] = { view = view, stage = stage, name = name, requirement = requirement, button = button, stroke = stroke, pet = pet,
			color = rarityColor }
	end

	local function refreshMenu()
		local xp = localPlayer:GetAttribute("PoinRank") or 0
		local equipped = localPlayer:GetAttribute("Pet")
		local nextPet = PetCatalog.Next(xp)
		xpLabel.Text = Ui.number(xp)
		if nextPet then
			local previous = 0
			for _, pet in ipairs(PetCatalog.List) do
				if pet.xp <= xp then
					previous = pet.xp
				end
			end
			nextLabel.Text = "Pet berikutnya: " .. nextPet.name
			nextFill.Size = UDim2.fromScale(math.clamp((xp - previous) / math.max(1, nextPet.xp - previous), 0, 1), 1)
			remainLabel.Text = Ui.number(nextPet.xp - xp) .. " poin lagi"
		else
			nextLabel.Text = "Semua pet sudah terbuka. Hebat!"
			nextFill.Size = UDim2.fromScale(1, 1)
			remainLabel.Text = "KOLEKSI LENGKAP"
		end
		for id, card in pairs(cards) do
			local unlocked = PetCatalog.IsUnlocked(id, xp)
			-- pet terkunci tampil sebagai siluet
			card.view.ImageColor3 = unlocked and Color3.new(1, 1, 1) or LOCKED_TINT
			card.view.ImageTransparency = unlocked and 0 or 0.15
			card.stage.BackgroundColor3 = unlocked and card.color or T.Line
			card.name.Text = unlocked and card.pet.name or "???"
			card.requirement.Text = card.pet.xp == 0 and "Pet awal" or (Ui.number(card.pet.xp) .. " Poin Rank")
			card.stroke.Color = id == equipped and T.Good or T.Line
			card.stroke.Thickness = id == equipped and 2.5 or 1.5
			if id == equipped then
				card.button.Text = "DIPAKAI"
				card.button.BackgroundColor3 = T.Good
				card.button.TextColor3 = T.White
			elseif unlocked then
				card.button.Text = "PAKAI"
				card.button.BackgroundColor3 = T.Primary
				card.button.TextColor3 = T.White
			else
				card.button.Text = "TERKUNCI"
				card.button.BackgroundColor3 = T.Paper2
				card.button.TextColor3 = T.InkSoft
			end
		end
	end
	localPlayer:GetAttributeChangedSignal("PoinRank"):Connect(refreshMenu)
	localPlayer:GetAttributeChangedSignal("Pet"):Connect(refreshMenu)
	refreshMenu()

	function Pets.OpenMenu()
		ctx.closeAllModals()
		refreshMenu()
		menu.Visible = true
		Ui.pop(menu, 0.9)
	end

	-- JENDELA PET BARU (520 x 540; area konten 476 tinggi)
	local popup, _, popupContent = ctx.makeModal("ModalPetBaru", "Pet Baru Terbuka!", 520, 540, T.Pink)
	popup.ZIndex = 7 -- tampil di atas jendela Hasil Akhir; menutupnya kembali ke hasil
	local popupStage = Ui.new("Frame", { Name = "Panggung", Position = UDim2.fromOffset(24, 20), Size = UDim2.new(1, -48, 0, 250),
		BackgroundColor3 = T.White, BorderSizePixel = 0, ZIndex = 5, Parent = popupContent })
	Ui.corner(popupStage, 18)
	local popupGradient = Ui.new("UIGradient", { Rotation = 90, Parent = popupStage })
	local popupView = Ui.new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, ZIndex = 5, Parent = popupStage })
	local popupChip = Ui.chip({ Position = UDim2.fromOffset(14, 14), Text = "", TextSize = 12, ZIndex = 6, Parent = popupStage }, T.Primary)
	local popupName = Ui.text({ Position = UDim2.fromOffset(24, 284), Size = UDim2.new(1, -48, 0, 40), Text = "", Font = F.Display, TextSize = 32,
		Scaled = true, MaxTextSize = 32, TextColor3 = T.Ink, ZIndex = 5, Parent = popupContent })
	local popupDesc = Ui.text({ Position = UDim2.fromOffset(40, 326), Size = UDim2.new(1, -80, 0, 44), Text = "", Font = F.Medium, TextSize = 17,
		TextColor3 = T.InkSoft, ZIndex = 5, Parent = popupContent })
	local equipNow
	local collection = Ui.button({ AnchorPoint = Vector2.new(0, 1), Position = UDim2.new(0, 24, 1, -24), Size = UDim2.new(0.5, -30, 0, 52),
		Text = "LIHAT KOLEKSI", TextSize = 17, ZIndex = 6 }, function()
		Pets.OpenMenu()
	end, "neutral")
	collection.Parent = popupContent
	equipNow = Ui.button({ AnchorPoint = Vector2.new(1, 1), Position = UDim2.new(1, -24, 1, -24), Size = UDim2.new(0.5, -30, 0, 52),
		Text = "PAKAI SEKARANG", TextSize = 17, ZIndex = 6 }, nil, "success")
	equipNow.Parent = popupContent

	local popupCamera, spinStart, popupPetId = nil, 0, nil
	equipNow.Activated:Connect(function()
		if popupPetId then
			ctx.remotes.EquipPet:FireServer(popupPetId)
			ctx.play("Hint")
		end
		popup.Visible = false
	end)
	RunService.RenderStepped:Connect(function()
		if popup.Visible and popupCamera then
			local angle = (os.clock() - spinStart) * 0.8
			popupCamera.CFrame = CFrame.lookAt(Vector3.new(math.sin(angle) * 7, 2, -math.cos(angle) * 7), Vector3.new(0, 0.3, 0))
		end
	end)

	local queue = {}
	local showing = false
	local function showNext()
		local pet = table.remove(queue, 1)
		if not pet then
			showing = false
			return
		end
		showing = true
		local catalogPet = PetCatalog.Get(pet.id)
		if not catalogPet then
			showNext()
			return
		end
		local rarityColor = PetCatalog.Rarities[catalogPet.rarity]
		Ui.clear(popupView)
		local _, camera = viewport(popupView, catalogPet.id, { Size = UDim2.fromScale(1, 1), ZIndex = 5 })
		popupCamera = camera
		spinStart = os.clock()
		popupPetId = catalogPet.id
		popupGradient.Color = ColorSequence.new(rarityColor:Lerp(T.White, 0.55), rarityColor:Lerp(T.White, 0.85))
		popupChip.Text = string.upper(catalogPet.rarity)
		popupChip.BackgroundColor3 = Ui.darker(rarityColor, 0.3)
		popupName.Text = catalogPet.name
		popupDesc.Text = catalogPet.desc
		popup.Visible = true
		Ui.pop(popup, 0.6)
		ctx.play("Fanfare")
		if #queue > 0 then
			task.delay(4, showNext)
		else
			showing = false
		end
	end

	function Pets.ShowUnlocked(list)
		for _, pet in ipairs(list) do
			table.insert(queue, pet)
		end
		if not showing then
			showNext()
		end
	end
end

return Pets
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="21">
          <Properties>
            <string name="Name">Registration</string>
            <string name="Source"><![CDATA[--[[
	Registration (client): formulir pendaftaran siswa (nama lengkap, nomor absen, kelas).
	Muncul saat siswa masuk. Siswa belum bisa bergerak sebelum menekan "MULAI BELAJAR".
]]

local Players = game:GetService("Players")

local Registration = {}

local player = Players.LocalPlayer

local WIDTH = 460
local HEADER = 140

function Registration.Init(ctx)
	local Ui = ctx.Ui
	local T, F = Ui.Theme, Ui.Font

	local overlay = Ui.new("Frame", { Name = "Pendaftaran", Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.fromRGB(14, 18, 40),
		BackgroundTransparency = 0.25, BorderSizePixel = 0, Active = true, ZIndex = 20, Visible = false, Parent = ctx.gui })
	local formHolder, form = Ui.card({ Name = "Formulir", AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(WIDTH, 560), ZIndex = 21, Parent = overlay }, { radius = 24, clip = true, shadow = 8 })
	ctx.addPixelScale(formHolder)

	-- kepala berwarna
	local header = Ui.band({ Name = "Kepala", Size = UDim2.new(1, 0, 0, HEADER), BackgroundColor3 = T.Primary, ZIndex = 21, Parent = form }, 24)
	Ui.chip({ Position = UDim2.fromOffset(28, 24), Text = "INFORMATIKA · KELAS 7", TextSize = 12, ZIndex = 21, Parent = header },
		Color3.fromRGB(255, 255, 255), T.Primary)
	Ui.text({ Position = UDim2.fromOffset(28, 54), Size = UDim2.new(1, -56, 0, 48), Text = "NET QUEST", Font = F.Display, TextSize = 46,
		TextColor3 = T.White, TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 21, Parent = header })
	Ui.text({ Position = UDim2.fromOffset(28, 102), Size = UDim2.new(1, -56, 0, 20), Text = "Kuis Jaringan Komputer dan Internet",
		Font = F.Bold, TextSize = 16, TextColor3 = T.White, TextTransparency = 0.12, TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 21,
		Parent = header })

	local bodyArea = Ui.new("Frame", { Name = "Isian", Position = UDim2.fromOffset(0, HEADER), Size = UDim2.new(1, 0, 1, -HEADER),
		BackgroundTransparency = 1, ZIndex = 21, Parent = form })
	Ui.padding(bodyArea, 22, 28, 22, 28)
	Ui.list(bodyArea, Enum.FillDirection.Vertical, 14)

	Ui.text({ LayoutOrder = 1, Size = UDim2.new(1, 0, 0, 40), Text = "Isi data dirimu dulu, ya. Guru memakai data ini untuk melihat nilaimu.",
		Font = F.Medium, TextSize = 16, TextColor3 = T.InkSoft, TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Top, ZIndex = 21, Parent = bodyArea })

	local function field(parent, props, labelText, placeholder)
		local group = Ui.new("Frame", { LayoutOrder = props.LayoutOrder, Position = props.Position, Size = props.Size, BackgroundTransparency = 1,
			ZIndex = 21, Parent = parent })
		Ui.text({ Size = UDim2.new(1, 0, 0, 18), Text = labelText, Font = F.Black, TextSize = 13, TextColor3 = T.InkSoft,
			TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 21, Parent = group })
		local box = Ui.new("TextBox", { Position = UDim2.fromOffset(0, 24), Size = UDim2.new(1, 0, 0, 48), BackgroundColor3 = T.Paper2,
			TextColor3 = T.Ink, PlaceholderText = placeholder, PlaceholderColor3 = Color3.fromRGB(160, 166, 190), Font = F.Bold, TextSize = 20,
			Text = "", TextXAlignment = Enum.TextXAlignment.Left, ClearTextOnFocus = false, BorderSizePixel = 0, ZIndex = 21, Parent = group })
		Ui.corner(box, 12)
		Ui.padding(box, 0, 14, 0, 14)
		local stroke = Ui.stroke(box, T.Line, 1.5)
		box.Focused:Connect(function()
			stroke.Color, stroke.Thickness = T.Primary, 2
			box.BackgroundColor3 = T.Paper
		end)
		box.FocusLost:Connect(function()
			stroke.Color, stroke.Thickness = T.Line, 1.5
			box.BackgroundColor3 = T.Paper2
		end)
		return box, group
	end

	local nameBox = field(bodyArea, { LayoutOrder = 2, Size = UDim2.new(1, 0, 0, 72) }, "NAMA LENGKAP", "contoh: Budi Santoso")

	-- absen & kelas berdampingan; jika kelas tidak ditanyakan, absen memakai lebar penuh
	local row = Ui.new("Frame", { LayoutOrder = 3, Size = UDim2.new(1, 0, 0, 72), BackgroundTransparency = 1, ZIndex = 21, Parent = bodyArea })
	local absenBox, absenGroup = field(row, { Size = UDim2.new(0.5, -8, 1, 0) }, "NOMOR ABSEN", "contoh: 5")
	local classBox, classGroup = field(row, { Position = UDim2.new(0.5, 8, 0, 0), Size = UDim2.new(0.5, -8, 1, 0) }, "KELAS", "contoh: 7A")

	local message = Ui.text({ LayoutOrder = 4, Size = UDim2.new(1, 0, 0, 20), Text = "", Font = F.Bold, TextSize = 15, TextColor3 = T.Bad,
		TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd, ZIndex = 21, Parent = bodyArea })

	local busy = false
	local submit
	local function send(skipAsTeacher)
		if busy then
			return
		end
		busy = true
		submit.Text = "MEMERIKSA..."
		message.TextColor3 = T.InkSoft
		message.Text = "Sebentar, datamu sedang diperiksa."
		local ok, success, info = pcall(function()
			return ctx.remotes.Register:InvokeServer(nameBox.Text, absenBox.Text, classBox.Text, skipAsTeacher)
		end)
		busy = false
		submit.Text = "MULAI BELAJAR"
		if ok and success then
			overlay.Visible = false
			ctx.onRegistered(info, skipAsTeacher)
		else
			message.TextColor3 = T.Bad
			message.Text = tostring(ok and info or "Koneksi bermasalah, coba lagi.")
			Ui.pop(formHolder, 1.02)
		end
	end
	submit = Ui.button({ LayoutOrder = 5, Size = UDim2.new(1, 0, 0, 54), Text = "MULAI BELAJAR", TextSize = 20, Radius = 14, ZIndex = 22 },
		function()
			send(false)
		end, "success")
	submit.Parent = bodyArea
	local teacherSkip = Ui.button({ LayoutOrder = 6, Size = UDim2.new(1, 0, 0, 36), Text = "Saya guru, lewati pendaftaran", TextSize = 15,
		Font = F.Bold, ZIndex = 22, Visible = false }, function()
		send(true)
	end, "ghost")
	teacherSkip.Parent = bodyArea

	local askClass = true
	local function layout()
		classGroup.Visible = askClass
		absenGroup.Size = askClass and UDim2.new(0.5, -8, 1, 0) or UDim2.new(1, 0, 1, 0)
		-- tinggi: kepala + padding + teks + 2 baris isian + pesan + tombol (+ tombol guru) + jarak antarbaris
		local height = HEADER + 22 + 40 + 72 + 72 + 20 + 54 + 22 + 14 * 4
		if teacherSkip.Visible then
			height += 36 + 14
		end
		formHolder.Size = UDim2.fromOffset(WIDTH, height)
	end

	local function onlyDigits()
		local digits = string.gsub(absenBox.Text, "%D", "")
		if digits ~= absenBox.Text then
			absenBox.Text = digits
		end
	end
	absenBox:GetPropertyChangedSignal("Text"):Connect(onlyDigits)
	nameBox.FocusLost:Connect(function(enter)
		if enter then
			absenBox:CaptureFocus()
		end
	end)
	absenBox.FocusLost:Connect(function(enter)
		if enter then
			if askClass then
				classBox:CaptureFocus()
			else
				send(false)
			end
		end
	end)
	classBox.FocusLost:Connect(function(enter)
		if enter then
			send(false)
		end
	end)

	local function updateTeacherButton()
		teacherSkip.Visible = player:GetAttribute("IsTeacher") == true
		layout()
	end
	player:GetAttributeChangedSignal("IsTeacher"):Connect(updateTeacherButton)
	updateTeacherButton()

	-- Pesan "Profile" dari server: isi otomatis dari data tersimpan
	function Registration.OnProfile(msg)
		askClass = msg.askClass ~= false
		layout()
		if nameBox.Text == "" then
			nameBox.Text = msg.nama or ""
		end
		if absenBox.Text == "" and msg.absen and msg.absen ~= "" then
			absenBox.Text = tostring(msg.absen)
		end
		if classBox.Text == "" then
			classBox.Text = msg.kelas or ""
		end
		absenBox.PlaceholderText = "1 sampai " .. tostring(msg.maxAbsen or 50)
		if msg.nama and msg.nama ~= "" and not msg.registered then
			message.TextColor3 = T.Good
			message.Text = "Selamat datang kembali! Periksa datamu lalu tekan MULAI."
		end
		local wasOpen = overlay.Visible
		overlay.Visible = not msg.registered and player:GetAttribute("SkipDaftar") ~= true
		if overlay.Visible and not wasOpen then
			Ui.pop(formHolder, 0.9)
		end
	end

	function Registration.IsOpen()
		return overlay.Visible
	end
end

return Registration
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="22">
          <Properties>
            <string name="Name">Ui</string>
            <string name="Source"><![CDATA[--[[
	Ui: design system kecil untuk seluruh antarmuka NET QUEST.
	- Kartu putih bersudut membulat dengan bayangan lembut
	- Font Builder Sans (font resmi Roblox) + Fredoka untuk angka/judul besar
	- Tombol dengan varian warna yang konsisten
]]

local TweenService = game:GetService("TweenService")

local Ui = {}

local function font(name, fallback)
	local ok, value = pcall(function()
		return Enum.Font[name]
	end)
	return ok and value or fallback
end

Ui.Font = {
	Display = Enum.Font.FredokaOne,
	Black = font("BuilderSansExtraBold", Enum.Font.GothamBlack),
	Bold = font("BuilderSansBold", Enum.Font.GothamBold),
	Medium = font("BuilderSansMedium", Enum.Font.GothamMedium),
	Mono = Enum.Font.RobotoMono,
}

Ui.Theme = {
	Ink = Color3.fromRGB(28, 32, 56), -- teks utama di atas kartu putih
	InkSoft = Color3.fromRGB(104, 112, 140), -- teks sekunder
	Paper = Color3.fromRGB(255, 255, 255),
	Paper2 = Color3.fromRGB(243, 245, 251), -- baris / latar sekunder
	Line = Color3.fromRGB(226, 230, 241),
	Night = Color3.fromRGB(24, 28, 52), -- kartu gelap (HUD)
	Night2 = Color3.fromRGB(40, 46, 80),
	Primary = Color3.fromRGB(92, 104, 245),
	Gold = Color3.fromRGB(255, 194, 48),
	Good = Color3.fromRGB(38, 186, 112),
	Bad = Color3.fromRGB(236, 78, 94),
	Orange = Color3.fromRGB(255, 140, 60),
	Pink = Color3.fromRGB(240, 100, 170),
	White = Color3.new(1, 1, 1),
}
local T = Ui.Theme

-- Membuat Instance dengan properti. props.Parent dipasang paling akhir.
function Ui.new(className, props)
	local inst = Instance.new(className)
	local parent = props.Parent
	for key, value in pairs(props) do
		if key ~= "Parent" then
			inst[key] = value
		end
	end
	inst.Parent = parent
	return inst
end

function Ui.corner(parent, radius)
	return Ui.new("UICorner", { CornerRadius = UDim.new(0, radius or 12), Parent = parent })
end

function Ui.stroke(parent, color, thickness, transparency)
	return Ui.new("UIStroke", {
		Color = color or T.Line,
		Thickness = thickness or 1,
		Transparency = transparency or 0,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
		Parent = parent,
	})
end

function Ui.padding(parent, top, right, bottom, left)
	right = right or top
	bottom = bottom or top
	left = left or right
	return Ui.new("UIPadding", {
		PaddingTop = UDim.new(0, top),
		PaddingRight = UDim.new(0, right),
		PaddingBottom = UDim.new(0, bottom),
		PaddingLeft = UDim.new(0, left),
		Parent = parent,
	})
end

function Ui.list(parent, direction, gap, hAlign, vAlign)
	return Ui.new("UIListLayout", {
		FillDirection = direction or Enum.FillDirection.Vertical,
		Padding = UDim.new(0, gap or 8),
		SortOrder = Enum.SortOrder.LayoutOrder,
		HorizontalAlignment = hAlign or Enum.HorizontalAlignment.Left,
		VerticalAlignment = vAlign or Enum.VerticalAlignment.Top,
		Parent = parent,
	})
end

function Ui.maxText(parent, max, min)
	return Ui.new("UITextSizeConstraint", { MaxTextSize = max, MinTextSize = min or 10, Parent = parent })
end

function Ui.sizeLimit(parent, minSize, maxSize)
	return Ui.new("UISizeConstraint", { MinSize = minSize, MaxSize = maxSize, Parent = parent })
end

-- Teks. Default: ukuran tetap (TextSize) agar rapi; gunakan Scaled = true untuk teks panjang yang harus muat.
function Ui.text(props)
	local max, scaled = props.MaxTextSize, props.Scaled
	props.MaxTextSize, props.Scaled = nil, nil
	if props.BackgroundTransparency == nil then
		props.BackgroundTransparency = 1
	end
	props.Font = props.Font or Ui.Font.Bold
	props.TextColor3 = props.TextColor3 or T.Ink
	props.TextSize = props.TextSize or 18
	props.TextScaled = scaled == true
	if props.TextWrapped == nil then
		-- teks yang dipotong "..." cukup satu baris
		props.TextWrapped = props.TextTruncate == nil
	end
	props.Text = props.Text or ""
	props.BorderSizePixel = 0
	local label = Ui.new("TextLabel", props)
	if scaled then
		Ui.maxText(label, max or props.TextSize, 11)
	end
	return label
end

-- Kartu: mengembalikan (holder, body). Atur posisi/ukuran/visibilitas pada holder, isi konten di body.
function Ui.card(props, style)
	style = style or {}
	local radius = style.radius or 18
	local holder = Ui.new("Frame", {
		Name = props.Name or "Kartu",
		AnchorPoint = props.AnchorPoint or Vector2.zero,
		Position = props.Position or UDim2.new(),
		Size = props.Size or UDim2.fromOffset(200, 100),
		BackgroundTransparency = 1,
		Visible = props.Visible ~= false,
		ZIndex = props.ZIndex or 1,
		Parent = props.Parent,
	})
	local shadow = Ui.new("Frame", {
		Name = "Bayangan",
		Position = UDim2.fromOffset(0, style.shadow or 5),
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Color3.new(0, 0, 0),
		BackgroundTransparency = style.dark and 0.55 or 0.8,
		BorderSizePixel = 0,
		ZIndex = props.ZIndex or 1,
		Parent = holder,
	})
	Ui.corner(shadow, radius)
	local body = Ui.new("Frame", {
		Name = "Isi",
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = style.color or (style.dark and T.Night or T.Paper),
		BackgroundTransparency = style.transparency or (style.dark and 0.06 or 0),
		BorderSizePixel = 0,
		ClipsDescendants = style.clip == true,
		ZIndex = props.ZIndex or 1,
		Parent = holder,
	})
	Ui.corner(body, radius)
	if not style.dark then
		Ui.stroke(body, T.Line, 1, 0.2)
	else
		Ui.stroke(body, Color3.new(1, 1, 1), 1, 0.88)
	end
	return holder, body
end

-- Pita warna di tepi atas kartu. ClipsDescendants di Roblox tidak mengikuti UICorner, jadi pita diberi
-- sudut sendiri (sama dengan kartu) + penutup di bagian bawahnya agar sisi bawahnya tetap lurus.
function Ui.band(props, radius)
	props.BorderSizePixel = 0
	local band = Ui.new("Frame", props)
	Ui.corner(band, radius)
	local filler = Ui.new("Frame", { Name = "Penutup", AnchorPoint = Vector2.new(0, 1), Position = UDim2.fromScale(0, 1),
		Size = UDim2.new(1, 0, 0, radius), BackgroundColor3 = band.BackgroundColor3, BorderSizePixel = 0, ZIndex = 0, Parent = band })
	band:GetPropertyChangedSignal("BackgroundColor3"):Connect(function()
		filler.BackgroundColor3 = band.BackgroundColor3
	end)
	return band
end

local VARIANTS = {
	primary = { bg = T.Primary, fg = T.White },
	success = { bg = T.Good, fg = T.White },
	danger = { bg = T.Bad, fg = T.White },
	gold = { bg = T.Gold, fg = T.Ink },
	neutral = { bg = T.Paper2, fg = T.Ink },
	dark = { bg = T.Night2, fg = T.White },
	ghost = { bg = T.Paper, fg = T.Primary },
}

-- Tombol dengan sudut membulat, efek hover & tekan
function Ui.button(props, onClick, variant)
	local v = VARIANTS[variant or "primary"] or VARIANTS.primary
	props.BackgroundColor3 = props.BackgroundColor3 or v.bg
	props.TextColor3 = props.TextColor3 or v.fg
	props.Font = props.Font or Ui.Font.Black
	props.TextSize = props.TextSize or 17
	props.TextWrapped = true
	props.AutoButtonColor = false
	props.BorderSizePixel = 0
	props.Text = props.Text or ""
	local radius = props.Radius or 12
	props.Radius = nil
	local button = Ui.new("TextButton", props)
	Ui.corner(button, radius)
	local scale = Ui.new("UIScale", { Name = "Skala", Parent = button })
	-- warna "diam" mengikuti perubahan BackgroundColor3 dari luar, jadi hover tidak mengembalikan warna lama
	local resting, hovered, applied = props.BackgroundColor3, false, props.BackgroundColor3
	local function apply()
		applied = hovered and resting:Lerp(Color3.new(1, 1, 1), 0.12) or resting
		button.BackgroundColor3 = applied
	end
	button:GetPropertyChangedSignal("BackgroundColor3"):Connect(function()
		if button.BackgroundColor3 ~= applied then
			resting = button.BackgroundColor3
			if hovered then
				apply()
			end
		end
	end)
	button.MouseEnter:Connect(function()
		hovered = true
		Ui.tween(scale, 0.12, { Scale = 1.03 })
		apply()
	end)
	button.MouseLeave:Connect(function()
		hovered = false
		Ui.tween(scale, 0.12, { Scale = 1 })
		apply()
	end)
	button.MouseButton1Down:Connect(function()
		Ui.tween(scale, 0.06, { Scale = 0.97 })
	end)
	button.MouseButton1Up:Connect(function()
		Ui.tween(scale, 0.1, { Scale = 1 })
	end)
	if onClick then
		button.Activated:Connect(onClick)
	end
	return button
end

-- Label kecil berbentuk pil
function Ui.chip(props, color, textColor)
	props.BackgroundColor3 = color
	props.BackgroundTransparency = 0
	props.TextColor3 = textColor or T.White
	props.Font = props.Font or Ui.Font.Black
	props.TextSize = props.TextSize or 13
	props.Size = props.Size or UDim2.fromOffset(0, 24)
	props.AutomaticSize = props.AutomaticSize or Enum.AutomaticSize.X
	props.TextWrapped = false
	local chip = Ui.text(props)
	Ui.corner(chip, 12)
	Ui.padding(chip, 0, 10, 0, 10)
	return chip
end

-- Bilah progres: mengembalikan (latar, isi)
function Ui.bar(props, color, track)
	props.BackgroundColor3 = track or T.Line
	props.BorderSizePixel = 0
	local back = Ui.new("Frame", props)
	Ui.corner(back, 6)
	local fill = Ui.new("Frame", { Name = "Isi", Size = UDim2.fromScale(0, 1), BackgroundColor3 = color or T.Primary, BorderSizePixel = 0,
		Parent = back })
	Ui.corner(fill, 6)
	return back, fill
end

function Ui.tween(inst, time, goal, style, direction)
	local tween = TweenService:Create(inst, TweenInfo.new(time, style or Enum.EasingStyle.Quad,
		direction or Enum.EasingDirection.Out), goal)
	tween:Play()
	return tween
end

-- Animasi "muncul" (membesar sedikit lalu normal).
-- Satu GuiObject hanya memakai satu UIScale, jadi UIScale yang sudah ada (skala layar / hover) dipakai ulang;
-- atribut "Dasar" menyimpan skala normalnya.
function Ui.pop(inst, from)
	local scale = inst:FindFirstChildOfClass("UIScale") or Ui.new("UIScale", { Name = "PopScale", Parent = inst })
	local base = scale:GetAttribute("Dasar") or 1
	scale.Scale = base * (from or 0.7)
	Ui.tween(scale, 0.35, { Scale = base }, Enum.EasingStyle.Back)
end

function Ui.clear(container)
	for _, child in ipairs(container:GetChildren()) do
		if child:IsA("GuiObject") then
			child:Destroy()
		end
	end
end

-- 12345 -> "12.345"
function Ui.number(n)
	local s = tostring(math.floor(n or 0))
	local negative = string.sub(s, 1, 1) == "-"
	if negative then
		s = string.sub(s, 2)
	end
	local out = string.reverse((string.gsub(string.reverse(s), "(%d%d%d)", "%1.")))
	if string.sub(out, 1, 1) == "." then
		out = string.sub(out, 2)
	end
	return (negative and "-" or "") .. out
end

-- warna lebih gelap untuk sisi bawah tombol 3D
function Ui.darker(color, amount)
	return color:Lerp(Color3.new(0, 0, 0), amount or 0.25)
end

return Ui
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
