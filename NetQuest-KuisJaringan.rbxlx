local feedToken = 0
local function showFeed(text)
	feedToken += 1
	local token = feedToken
	feedLabel.Text = text
	feedHolder.Visible = true
	task.delay(4, function()
		if feedToken == token then
			feedHolder.Visible = false
		end
	end)
end

