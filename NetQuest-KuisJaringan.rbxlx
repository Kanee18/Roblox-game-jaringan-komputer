      <Item class="ModuleScript" referent="2">
        <Properties>
          <string name="Name">Config</string>
          <string name="Source"><![CDATA[--[[
	KONFIGURASI GAME "NET QUEST: Kuis Jaringan Komputer & Internet"
	Ubah angka/teks di file ini untuk menyesuaikan game dengan kelas Anda.
	Tidak perlu menyentuh script lain.
]]

local Config = {}

---------------------------------------------------------------------
-- PENDAFTARAN SISWA (muncul saat siswa pertama kali masuk)
---------------------------------------------------------------------
Config.AskClass = true -- true = siswa juga mengisi kelas (contoh: 7A). false = hanya nama & absen
Config.MaxAbsen = 50 -- nomor absen maksimal
Config.MinNameLength = 3
Config.MaxNameLength = 30

---------------------------------------------------------------------
-- MODE PERMAINAN
-- "petualangan" = keempat game dimainkan berurutan dan poinnya DIJUMLAHKAN (poin total).
-- Guru juga bisa memilih satu game saja di Panel Guru.
---------------------------------------------------------------------
Config.Modes = {
	{ id = "petualangan", name = "Petualangan 4 Game", icon = "", color = Color3.fromRGB(150, 110, 255),
		desc = "Mainkan keempat game berurutan. Poin semua game dijumlahkan menjadi POIN TOTAL." },
	{ id = "kotak", name = "Lari & Pilih", icon = "", color = Color3.fromRGB(64, 140, 240),
		desc = "Lari dan berdiri di kotak jawaban yang benar. Kotak yang salah akan jatuh ke kolam!" },
	{ id = "kilat", name = "Kuis Kilat", icon = "", color = Color3.fromRGB(245, 180, 40),
		desc = "Tekan tombol jawaban secepat mungkin. Jawaban tidak bisa diganti, makin cepat makin besar poinnya." },
	{ id = "firewall", name = "Lintasan Firewall", icon = "", color = Color3.fromRGB(240, 100, 70),
		desc = "Balapan di lintasan langit. Masuk ke pintu jawaban yang benar, pintu yang salah membuatmu jatuh!" },
	{ id = "sandi", name = "Pecahkan Sandi", icon = "", color = Color3.fromRGB(60, 180, 130),
		desc = "Ketik jawaban yang benar dan pecahkan kode rahasia Caesar Cipher." },
}
Config.DefaultMode = "petualangan"
Config.AdventureOrder = { "kotak", "kilat", "firewall", "sandi" } -- urutan game di Petualangan
Config.CompletionBonus = 200 -- bonus untuk siswa yang ikut menjawab di keempat game
Config.GameBreakTime = 10 -- detik menampilkan hasil tiap game sebelum lanjut ke game berikutnya

function Config.GetMode(id)
	for _, mode in ipairs(Config.Modes) do
		if mode.id == id then
			return mode
		end
	end
	return Config.Modes[1]
end

---------------------------------------------------------------------
-- PENGATURAN KUIS
---------------------------------------------------------------------
Config.QuestionsPerRound = 5 -- jumlah soal PER GAME (Lintasan Firewall selalu FirewallGates soal)
Config.QuestionTime = 20 -- detik soal pilihan ganda (mode Lari & Pilih)
Config.TrueFalseTime = 12 -- detik soal Benar/Salah (mode Lari & Pilih)
Config.KilatTime = 10 -- detik per soal mode Kuis Kilat
Config.SandiTime = 35 -- detik per soal mode Pecahkan Sandi
Config.SandiAttempts = 3 -- kesempatan mengetik per soal
Config.FirewallGates = 6 -- jumlah gerbang (soal) di Lintasan Firewall
Config.FirewallTime = 240 -- batas waktu Lintasan Firewall (detik)
Config.RevealTime = 3 -- detik animasi jawaban benar
Config.ExplanationTime = 7 -- detik menampilkan penjelasan materi
Config.IntermissionTime = 30 -- detik jeda sebelum ronde dimulai
Config.ModeIntroTime = 6 -- detik penjelasan cara main mode sebelum ronde
Config.RoundEndTime = 15 -- detik menampilkan hasil akhir ronde
Config.MinPlayers = 1 -- minimal siswa terdaftar agar ronde otomatis dimulai
Config.AutoStart = true -- true = ronde mulai otomatis; false = tunggu guru menekan "Mulai"

---------------------------------------------------------------------
-- GURU (bisa membuka Panel Guru)
-- Pemilik game otomatis menjadi guru. Tambahkan akun guru lain di sini.
---------------------------------------------------------------------
Config.TeacherUserIds = {
	-- 12345678,
}
Config.TeacherNames = {
	-- "NamaAkunGuru",
}
Config.GroupTeacherMinRank = 254 -- jika game milik Grup: rank minimal untuk jadi guru
Config.StudioEveryoneTeacher = true -- saat dites di Roblox Studio, semua pemain jadi guru

---------------------------------------------------------------------
-- SKOR
---------------------------------------------------------------------
Config.BasePoints = 100 -- poin jawaban benar
Config.MaxSpeedBonus = 50 -- bonus maksimal jika menjawab cepat
Config.KilatSpeedBonus = 100 -- bonus kecepatan maksimal di Kuis Kilat
Config.StreakBonus = 10 -- bonus per jawaban benar berturut-turut
Config.MaxStreakBonus = 50 -- batas bonus streak
Config.BossMultiplier = 2 -- soal terakhir (SOAL BOS) poinnya dikali angka ini
Config.SandiRetryPenalty = 30 -- poin berkurang tiap salah ketik sebelum benar
Config.FinishBonus = { 300, 200, 100 } -- bonus juara 1/2/3 yang mencapai finish Lintasan Firewall
Config.FinishAllBonus = 50 -- bonus untuk semua yang berhasil mencapai finish
Config.HintEveryStreak = 3 -- tiap benar 3x berturut-turut dapat 1 bantuan
Config.MaxHints = 2 -- maksimal bantuan yang bisa disimpan
Config.StartingHints = 1 -- bantuan yang dimiliki saat ronde dimulai

---------------------------------------------------------------------
-- PENYIMPANAN (DataStore) untuk data siswa, Poin Rank & Pet
-- Agar berfungsi: Game Settings > Security > Enable Studio Access to API Services
-- dan game sudah dipublikasikan. Jika gagal, game tetap berjalan tanpa simpan.
---------------------------------------------------------------------
Config.UseDataStore = true
Config.DataStoreName = "NetQuest_KuisJaringan_v1"

-- Gelar berdasarkan total POIN RANK (Poin Rank = total poin dari semua ronde)
Config.Ranks = {
	{ xp = 0, name = "Kabel Pemula", color = Color3.fromRGB(200, 200, 200) },
	{ xp = 1000, name = "Hub Junior", color = Color3.fromRGB(120, 220, 255) },
	{ xp = 3000, name = "Switch Cekatan", color = Color3.fromRGB(110, 255, 150) },
	{ xp = 6000, name = "Router Hebat", color = Color3.fromRGB(255, 220, 90) },
	{ xp = 10000, name = "Server Master", color = Color3.fromRGB(255, 140, 70) },
	{ xp = 16000, name = "Legenda Internet", color = Color3.fromRGB(255, 90, 220) },
}
-- Daftar pet & syarat Poin Rank-nya ada di QuizShared > PetCatalog

---------------------------------------------------------------------
-- TOPIK MATERI (Informatika Kelas 7 - Jaringan Komputer & Internet)
---------------------------------------------------------------------
Config.Topics = {
	{ id = "campuran", name = "Campuran (Semua Materi)", color = Color3.fromRGB(180, 120, 255) },
	{ id = "konsep", name = "Konsep Jaringan Komputer", color = Color3.fromRGB(80, 170, 255) },
	{ id = "topologi", name = "Topologi Jaringan", color = Color3.fromRGB(255, 160, 60) },
	{ id = "perangkat", name = "Perangkat Jaringan", color = Color3.fromRGB(90, 220, 140) },
	{ id = "internet", name = "Internet & Cara Kerjanya", color = Color3.fromRGB(60, 210, 230) },
	{ id = "koneksi", name = "Koneksi Kabel & Nirkabel", color = Color3.fromRGB(255, 210, 70) },
	{ id = "keamanan", name = "Keamanan & Proteksi Data", color = Color3.fromRGB(255, 90, 110) },
}

function Config.GetTopic(id)
	for _, topic in ipairs(Config.Topics) do
		if topic.id == id then
			return topic
		end
	end
	return Config.Topics[1]
end

---------------------------------------------------------------------
-- WARNA KOTAK / PINTU JAWABAN (A, B, C, D)
---------------------------------------------------------------------
Config.PadColors = {
	Color3.fromRGB(235, 64, 82), -- A merah
	Color3.fromRGB(45, 125, 245), -- B biru
	Color3.fromRGB(245, 185, 30), -- C kuning
	Color3.fromRGB(40, 190, 95), -- D hijau
}
Config.PadLetters = { "A", "B", "C", "D" }
Config.TrueColor = Color3.fromRGB(40, 190, 95)
Config.FalseColor = Color3.fromRGB(235, 64, 82)

---------------------------------------------------------------------
-- SUARA (boleh diganti dengan ID audio dari Toolbox, contoh "rbxassetid://123")
-- Kosongkan ("") untuk mematikan suara tertentu.
---------------------------------------------------------------------
Config.Sounds = {
	Tick = "rbxasset://sounds/clickfast.wav",
	Correct = "rbxasset://sounds/electronicpingshort.wav",
	Wrong = "rbxasset://sounds/uuhhh.mp3",
	Question = "rbxasset://sounds/button.wav",
	Fanfare = "rbxasset://sounds/electronicpingshort.wav",
	Hint = "rbxasset://sounds/snap.wav",
}
Config.MusicId = "" -- isi dengan ID musik latar dari Toolbox jika ingin ada musik

---------------------------------------------------------------------
-- TAMPILAN DUNIA
---------------------------------------------------------------------
Config.ClockTime = 14.5 -- waktu langit (0-24). 14 = siang cerah, 17.5 = senja
Config.GameTitle = "NET QUEST"
Config.GameSubtitle = "Kuis Jaringan Komputer & Internet • Informatika Kelas 7"

return Config
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="3">
        <Properties>
          <string name="Name">Materi</string>
          <string name="Source"><![CDATA[--[[
	RINGKASAN MATERI untuk papan "Zona Materi" di lobi.
	Siswa bisa membaca papan ini saat jeda sebelum kuis dimulai.
	Setiap topik: judul + daftar poin singkat (usahakan maksimal 7 poin agar terbaca).
]]

return {
	konsep = {
		"Jaringan komputer = 2 perangkat atau lebih yang saling terhubung untuk berbagi data dan sumber daya.",
		"Manfaat: berbagi file, printer, dan koneksi internet, serta berkomunikasi (chat, email, video call).",
		"PAN (Personal Area Network): jangkauan sangat dekat ±10 m, contoh HP ke earphone Bluetooth.",
		"LAN (Local Area Network): dalam satu ruangan/gedung, contoh lab komputer sekolah.",
		"MAN (Metropolitan Area Network): mencakup satu kota.",
		"WAN (Wide Area Network): antarkota, antarnegara, bahkan antarbenua. Internet adalah WAN terbesar.",
		"Client-Server: ada komputer pusat (server) yang melayani. Peer-to-Peer: semua komputer setara.",
	},
	topologi = {
		"Topologi = bentuk atau susunan cara perangkat dihubungkan dalam jaringan.",
		"BUS: semua komputer di satu kabel utama (backbone). Kabel utama putus = jaringan mati.",
		"STAR (bintang): semua terhubung ke pusat (switch/hub). Paling banyak dipakai.",
		"RING (cincin): komputer membentuk lingkaran, data berputar dari satu komputer ke komputer berikutnya.",
		"MESH: setiap komputer terhubung ke semua komputer lain. Paling andal tapi butuh banyak kabel.",
		"Rumus kabel mesh: n x (n - 1) / 2. Contoh 4 komputer = 4 x 3 / 2 = 6 kabel.",
		"TREE (pohon): gabungan beberapa topologi star yang bertingkat seperti cabang pohon.",
	},
	perangkat = {
		"NIC (Network Interface Card): kartu jaringan di komputer; setiap NIC punya MAC Address unik.",
		"Kabel UTP + konektor RJ-45: kabel jaringan yang paling umum di LAN.",
		"HUB: meneruskan data ke SEMUA komputer yang terhubung.",
		"SWITCH: lebih pintar dari hub, mengirim data HANYA ke komputer tujuan.",
		"ROUTER: menghubungkan jaringan yang berbeda dan memilih jalur (rute) terbaik untuk data.",
		"MODEM: Modulator-Demodulator, mengubah sinyal digital <-> analog agar bisa terhubung ke internet.",
		"ACCESS POINT: memancarkan sinyal WiFi. REPEATER: memperkuat sinyal agar jangkauan lebih jauh.",
	},
	internet = {
		"Internet = Interconnected Network, jaringan komputer global yang menghubungkan seluruh dunia.",
		"Berawal dari ARPANET (1969), proyek Departemen Pertahanan Amerika Serikat.",
		"ISP (Internet Service Provider) = perusahaan penyedia layanan akses internet.",
		"IP Address = alamat unik perangkat di jaringan. Contoh IPv4: 192.168.1.10 (4 angka 0-255).",
		"DNS = penerjemah nama domain (www.contoh.sch.id) menjadi IP Address, seperti buku telepon.",
		"Data dikirim dalam potongan kecil bernama PAKET. Aturan komunikasinya disebut PROTOKOL (TCP/IP).",
		"HTTPS = HTTP yang aman (terenkripsi), ditandai ikon gembok. Browser = aplikasi untuk membuka web.",
	},
	koneksi = {
		"KABEL: UTP (umum di LAN), koaksial, dan serat optik (fiber optic).",
		"Fiber optic mengirim data dengan CAHAYA: sangat cepat dan jarak jauh, dipakai kabel bawah laut.",
		"WiFi: nirkabel memakai gelombang radio dari router/access point. Nama jaringan WiFi = SSID.",
		"Bluetooth: nirkabel jarak dekat (±10 m), untuk earphone, speaker, atau kirim file.",
		"Seluler (4G/5G): internet dari menara BTS operator. Hotspot/tethering = HP membagi internet.",
		"Kabel: stabil & cepat, tapi kurang fleksibel. Nirkabel: fleksibel, tapi bisa terganggu jarak/penghalang.",
		"Kecepatan internet diukur dalam bps (bit per second), misalnya Mbps (megabit per detik).",
	},
	keamanan = {
		"Data pribadi (NIK, alamat, tanggal lahir, password, kode OTP) jangan dibagikan sembarangan!",
		"Password kuat: minimal 8 karakter, campuran huruf besar, kecil, angka, dan simbol.",
		"ENKRIPSI: mengubah data menjadi kode acak agar tak terbaca tanpa kunci. DEKRIPSI = kebalikannya.",
		"Caesar Cipher: enkripsi dengan menggeser huruf. Geser 1: A->B, B->C, jadi ABC -> BCD.",
		"PHISHING: penipuan lewat pesan/link palsu untuk mencuri data. MALWARE: virus, worm, trojan, ransomware.",
		"Aktifkan verifikasi 2 langkah (2FA). Hati-hati login akun penting di WiFi publik.",
		"Cloud storage (contoh Google Drive) = simpan data di internet, bisa diakses dari mana saja.",
	},
}
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="4">
        <Properties>
          <string name="Name">PetCatalog</string>
          <string name="Source"><![CDATA[--[[
	KATALOG PET - hadiah untuk siswa yang mengumpulkan Poin Rank.
	Poin Rank = total poin dari semua jawaban benar di semua ronde.
	Semakin banyak Poin Rank, semakin keren pet yang terbuka!

	Ubah angka "xp" untuk mengatur syarat membuka pet.
	Semua pet dibuat dari Part (tidak memerlukan aset dari Toolbox).
]]

local PetCatalog = {}

PetCatalog.Rarities = {
	Biasa = Color3.fromRGB(200, 205, 215),
	Langka = Color3.fromRGB(80, 170, 255),
	Epik = Color3.fromRGB(190, 100, 255),
	Legendaris = Color3.fromRGB(255, 200, 50),
	Mitos = Color3.fromRGB(255, 80, 160),
}

PetCatalog.List = {
	{ id = "slime", name = "Bit si Slime", xp = 0, rarity = "Biasa", flying = false,
		desc = "Pet pertamamu! Lahir dari 1 bit data." },
	{ id = "cat", name = "Kucing Kabel", xp = 600, rarity = "Biasa", flying = false,
		desc = "Ekornya kabel UTP yang menyala." },
	{ id = "dog", name = "Anjing Router", xp = 1500, rarity = "Langka", flying = false,
		desc = "Selalu tahu rute tercepat menuju tuannya." },
	{ id = "bird", name = "Burung WiFi", xp = 3000, rarity = "Langka", flying = true,
		desc = "Terbang memancarkan sinyal ke mana-mana." },
	{ id = "robot", name = "Robot Server", xp = 5000, rarity = "Epik", flying = true,
		desc = "Melayani tuannya 24 jam tanpa lelah." },
	{ id = "dragon", name = "Naga Firewall", xp = 8000, rarity = "Epik", flying = true,
		desc = "Semburan apinya memblokir semua virus!" },
	{ id = "unicorn", name = "Unicorn Cloud", xp = 12000, rarity = "Legendaris", flying = true,
		desc = "Menyimpan semua datamu di atas awan." },
	{ id = "phoenix", name = "Phoenix Fiber Optik", xp = 17000, rarity = "Legendaris", flying = true,
		desc = "Secepat cahaya di dalam kabel serat optik." },
	{ id = "galaxy", name = "Galaksi Internet", xp = 25000, rarity = "Mitos", flying = true,
		desc = "Pet terkuat! Menghubungkan seluruh jaringan di alam semesta." },
}

function PetCatalog.Get(id)
	for _, pet in ipairs(PetCatalog.List) do
		if pet.id == id then
			return pet
		end
	end
	return nil
end

function PetCatalog.IsUnlocked(id, xp)
	local pet = PetCatalog.Get(id)
	return pet ~= nil and (xp or 0) >= pet.xp
end

-- Pet terbaik yang sudah terbuka
function PetCatalog.Best(xp)
	local best = PetCatalog.List[1]
	for _, pet in ipairs(PetCatalog.List) do
		if (xp or 0) >= pet.xp then
			best = pet
		end
	end
	return best
end

-- Pet yang baru terbuka saat Poin Rank naik dari oldXp ke newXp
function PetCatalog.NewlyUnlocked(oldXp, newXp)
	local list = {}
	for _, pet in ipairs(PetCatalog.List) do
		if pet.xp > oldXp and pet.xp <= newXp then
			table.insert(list, pet)
		end
	end
	return list
end

-- Pet berikutnya yang belum terbuka
function PetCatalog.Next(xp)
	for _, pet in ipairs(PetCatalog.List) do
		if (xp or 0) < pet.xp then
			return pet
		end
	end
	return nil
end

---------------------------------------------------------------------
-- PEMBUAT MODEL PET
-- Semua pet memakai gaya "chibi" yang sama: badan bulat, mata besar mengilap,
-- pipi merona, kaki kecil, lalu ciri khas masing-masing. Model menghadap -Z.
--
-- ASET TOOLBOX (opsional): taruh model di ReplicatedStorage > AsetPet dengan nama
-- sesuai id pet (slime, cat, dog, ...). Model itu akan dipakai menggantikan pet bawaan.
---------------------------------------------------------------------
local SMOOTH = Enum.Material.SmoothPlastic
local NEON = Enum.Material.Neon
local WHITE = Color3.new(1, 1, 1)
local INK = Color3.fromRGB(30, 30, 44)
local BLUSH = Color3.fromRGB(255, 140, 160)

local function setup(part, model, size, cframe, color, material)
	part.Size = size
	part.CFrame = cframe
	part.Color = color
	part.Material = material or SMOOTH
	part.Anchored = true
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.CastShadow = false
	part.Massless = true
	part.Parent = model
	return part
end

local function newPart(model, size, cframe, color, material)
	local part = Instance.new("Part")
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	return setup(part, model, size, cframe, color, material)
end

-- elips (bola yang bisa lonjong)
local function blob(model, size, cframe, color, material)
	local part = newPart(model, size, cframe, color, material)
	local mesh = Instance.new("SpecialMesh")
	mesh.MeshType = Enum.MeshType.Sphere
	mesh.Parent = part
	return part
end

-- silinder tegak (sumbu Y)
local function rod(model, length, thickness, cframe, color, material)
	local part = newPart(model, Vector3.new(length, thickness, thickness), cframe * CFrame.Angles(0, 0, math.rad(90)), color, material)
	part.Shape = Enum.PartType.Cylinder
	return part
end

-- segitiga sama kaki di bidang X-Y (dibuat dari dua WedgePart), ujung lancip ke atas (+Y)
local function triangle(model, width, height, thickness, cframe, color, material)
	for _, side in ipairs({ -1, 1 }) do
		local wedge = Instance.new("WedgePart")
		setup(wedge, model, Vector3.new(thickness, height, width / 2),
			cframe * CFrame.new(side * width / 4, 0, 0) * CFrame.Angles(0, math.rad(-90 * side), 0), color, material)
	end
end

local BODY = Vector3.new(2.4, 2.2, 2.2) -- ukuran badan standar
local function frontZ(x, y)
	local a, b, c = BODY.X / 2, BODY.Y / 2, BODY.Z / 2
	local inside = 1 - (x / a) ^ 2 - (y / b) ^ 2
	return -c * math.sqrt(math.max(inside, 0))
end

-- badan + perut + mata + pipi + kaki; mengembalikan part badan
local function chibi(model, opts)
	local body = blob(model, BODY, CFrame.new(), opts.color, opts.material)
	if opts.transparency then
		body.Transparency = opts.transparency
	end
	if opts.belly then
		blob(model, Vector3.new(1.5, 1.25, 0.5), CFrame.new(0, -0.38, frontZ(0, -0.38) + 0.16), opts.belly)
	end
	local eyeY = opts.eyeY or 0.22
	for _, side in ipairs({ -1, 1 }) do
		local x = side * 0.43
		local z = frontZ(x, eyeY)
		if opts.visor then
			newPart(model, Vector3.new(0.34, 0.2, 0.05), CFrame.new(x, eyeY, z - 0.02), opts.eyeColor or Color3.fromRGB(90, 240, 255), NEON)
		else
			blob(model, Vector3.new(0.5, 0.62, 0.22), CFrame.new(x, eyeY, z + 0.02), WHITE)
			blob(model, Vector3.new(0.36, 0.48, 0.16), CFrame.new(x, eyeY - 0.03, z - 0.05), opts.eyeColor or INK)
			blob(model, Vector3.new(0.13, 0.13, 0.06), CFrame.new(x + 0.07, eyeY + 0.1, z - 0.12), WHITE, NEON)
			local cheek = blob(model, Vector3.new(0.34, 0.18, 0.06), CFrame.new(side * 0.74, eyeY - 0.36, frontZ(side * 0.74, eyeY - 0.36) - 0.01), BLUSH)
			cheek.Transparency = 0.2
		end
	end
	if opts.mouth ~= false then
		blob(model, Vector3.new(0.16, 0.08, 0.05), CFrame.new(0, eyeY - 0.34, frontZ(0, eyeY - 0.34) - 0.01), INK)
	end
	if opts.feet ~= false then
		for _, side in ipairs({ -1, 1 }) do
			blob(model, Vector3.new(0.6, 0.36, 0.72), CFrame.new(side * 0.52, -1.02, -0.28), opts.feetColor or opts.color)
		end
	end
	return body
end

local function addEffect(attach, kind, color)
	if kind == "sparkle" then
		local sparkles = Instance.new("Sparkles")
		sparkles.SparkleColor = color
		sparkles.Parent = attach
	elseif kind == "fire" then
		local fire = Instance.new("Fire")
		fire.Size = 1.2
		fire.Heat = 3
		fire.Color = color
		fire.SecondaryColor = Color3.fromRGB(255, 230, 120)
		fire.Parent = attach
	end
	local light = Instance.new("PointLight")
	light.Range = 7
	light.Brightness = 0.8
	light.Color = color
	light.Parent = attach
end

local builders = {}

function builders.slime(model)
	local mint = Color3.fromRGB(120, 230, 160)
	local body = chibi(model, { color = mint, transparency = 0.1, feet = false })
	blob(model, Vector3.new(0.9, 0.9, 0.9), CFrame.new(0, 1.15, 0.1), mint).Transparency = 0.1
	blob(model, Vector3.new(0.5, 0.3, 0.3), CFrame.new(-0.55, 0.7, -0.75), WHITE, NEON).Transparency = 0.4
	blob(model, Vector3.new(2.6, 0.5, 2.4), CFrame.new(0, -0.95, 0), mint).Transparency = 0.1
	return body
end

function builders.cat(model)
	local fur = Color3.fromRGB(255, 166, 82)
	local body = chibi(model, { color = fur, belly = Color3.fromRGB(255, 232, 200) })
	for _, side in ipairs({ -1, 1 }) do
		local ear = CFrame.new(side * 0.62, 1.12, 0.05) * CFrame.Angles(0, 0, math.rad(-side * 18))
		triangle(model, 0.75, 0.75, 0.24, ear, fur)
		triangle(model, 0.42, 0.45, 0.25, ear * CFrame.new(0, -0.08, -0.03), Color3.fromRGB(255, 170, 180))
	end
	-- ekor melengkung, ujungnya "kabel" menyala
	local tail = { { 0, -0.4, 1.2, 0.5 }, { 0.15, 0, 1.45, 0.45 }, { 0.3, 0.45, 1.55, 0.4 }, { 0.42, 0.9, 1.5, 0.38 } }
	for i, t in ipairs(tail) do
		blob(model, Vector3.new(t[4], t[4], t[4]), CFrame.new(t[1], t[2], t[3]), i == #tail and Color3.fromRGB(90, 190, 255) or fur,
			i == #tail and NEON or SMOOTH)
	end
	return body
end

function builders.dog(model)
	local fur = Color3.fromRGB(196, 146, 100)
	local body = chibi(model, { color = fur, belly = Color3.fromRGB(245, 226, 200), eyeY = 0.3 })
	blob(model, Vector3.new(0.8, 0.5, 0.45), CFrame.new(0, -0.06, frontZ(0, -0.06) + 0.08), Color3.fromRGB(245, 226, 200))
	blob(model, Vector3.new(0.26, 0.18, 0.14), CFrame.new(0, 0.06, frontZ(0, 0.06) - 0.1), INK)
	for _, side in ipairs({ -1, 1 }) do
		blob(model, Vector3.new(0.45, 1, 0.6), CFrame.new(side * 1.12, 0.35, 0.1) * CFrame.Angles(0, 0, math.rad(side * 20)),
			Color3.fromRGB(140, 96, 64))
	end
	-- antena router di kepala
	rod(model, 0.8, 0.12, CFrame.new(0.45, 1.35, 0.35), Color3.fromRGB(60, 60, 72))
	blob(model, Vector3.new(0.26, 0.26, 0.26), CFrame.new(0.45, 1.8, 0.35), Color3.fromRGB(90, 255, 140), NEON)
	blob(model, Vector3.new(0.4, 0.4, 0.4), CFrame.new(0, 0.1, 1.15), fur)
	return body
end

function builders.bird(model)
	local feather = Color3.fromRGB(96, 176, 255)
	local body = chibi(model, { color = feather, belly = Color3.fromRGB(225, 242, 255), feetColor = Color3.fromRGB(255, 176, 60), mouth = false })
	triangle(model, 0.42, 0.36, 0.3, CFrame.new(0, -0.05, frontZ(0, -0.05) - 0.08) * CFrame.Angles(math.rad(180), 0, 0),
		Color3.fromRGB(255, 176, 60))
	for _, side in ipairs({ -1, 1 }) do
		blob(model, Vector3.new(0.3, 1, 1.3), CFrame.new(side * 1.2, -0.05, 0.15) * CFrame.Angles(0, 0, math.rad(side * -25)),
			Color3.fromRGB(70, 140, 230))
	end
	for i, a in ipairs({ -20, 0, 20 }) do
		blob(model, Vector3.new(0.2, 0.6, 0.2), CFrame.new(0, 1.2, 0.1) * CFrame.Angles(0, 0, math.rad(a)) * CFrame.new(0, 0.2, 0),
			i == 2 and Color3.fromRGB(120, 255, 255) or feather, i == 2 and NEON or SMOOTH)
	end
	return body
end

function builders.robot(model)
	local metal = Color3.fromRGB(196, 204, 222)
	local body = newPart(model, Vector3.new(2.2, 2, 2), CFrame.new(), metal, Enum.Material.SmoothPlastic)
	newPart(model, Vector3.new(1.7, 0.85, 0.1), CFrame.new(0, 0.3, -1.02), Color3.fromRGB(28, 34, 52))
	for _, side in ipairs({ -1, 1 }) do
		newPart(model, Vector3.new(0.38, 0.22, 0.06), CFrame.new(side * 0.4, 0.32, -1.08), Color3.fromRGB(90, 240, 255), NEON)
		rod(model, 0.25, 0.6, CFrame.new(side * 1.15, 0.2, 0) * CFrame.Angles(0, 0, math.rad(90)), Color3.fromRGB(120, 130, 156))
	end
	for i = 1, 3 do
		newPart(model, Vector3.new(0.3, 0.1, 0.05), CFrame.new(-0.6 + i * 0.3, -0.45, -1.02), i == 2 and Color3.fromRGB(90, 255, 140)
			or Color3.fromRGB(255, 200, 70), NEON)
	end
	rod(model, 0.6, 0.1, CFrame.new(0, 1.3, 0), Color3.fromRGB(110, 118, 140))
	blob(model, Vector3.new(0.3, 0.3, 0.3), CFrame.new(0, 1.65, 0), Color3.fromRGB(255, 90, 90), NEON)
	local jet = rod(model, 0.3, 1.1, CFrame.new(0, -1.15, 0), Color3.fromRGB(90, 200, 255), NEON)
	jet.Transparency = 0.3
	addEffect(jet, "none", Color3.fromRGB(90, 200, 255))
	return body
end

function builders.dragon(model)
	local scale = Color3.fromRGB(235, 80, 70)
	local body = chibi(model, { color = scale, belly = Color3.fromRGB(255, 214, 120) })
	for _, side in ipairs({ -1, 1 }) do
		blob(model, Vector3.new(0.22, 0.75, 0.3), CFrame.new(side * 0.45, 1.25, 0.25) * CFrame.Angles(math.rad(-25), 0, math.rad(side * -15)),
			Color3.fromRGB(255, 228, 170))
		local wing = CFrame.new(side * 1.05, 0.55, 0.75) * CFrame.Angles(0, math.rad(side * 25), math.rad(side * -35))
		blob(model, Vector3.new(0.18, 1.2, 1.3), wing, Color3.fromRGB(190, 50, 60))
	end
	local tail = blob(model, Vector3.new(0.5, 0.5, 0.9), CFrame.new(0, -0.6, 1.3) * CFrame.Angles(math.rad(-20), 0, 0), scale)
	local tip = blob(model, Vector3.new(0.3, 0.3, 0.3), tail.CFrame * CFrame.new(0, 0.15, 0.5), Color3.fromRGB(255, 180, 60), NEON)
	addEffect(tip, "fire", Color3.fromRGB(255, 120, 40))
	return body
end

function builders.unicorn(model)
	local body = chibi(model, { color = Color3.fromRGB(252, 250, 255), belly = Color3.fromRGB(255, 236, 246), eyeColor = Color3.fromRGB(90, 60, 140),
		feet = false })
	-- tanduk bertingkat warna emas
	for i = 0, 2 do
		rod(model, 0.32, 0.36 - i * 0.1, CFrame.new(0, 1.2 + i * 0.28, -0.25) * CFrame.Angles(math.rad(-15), 0, 0), Color3.fromRGB(255, 214, 90),
			i == 2 and NEON or SMOOTH)
	end
	local mane = { Color3.fromRGB(255, 120, 150), Color3.fromRGB(255, 200, 90), Color3.fromRGB(120, 220, 160), Color3.fromRGB(120, 170, 255) }
	for i, color in ipairs(mane) do
		blob(model, Vector3.new(0.5, 0.5, 0.5), CFrame.new(0.25, 1.05 - i * 0.22, 0.45 + i * 0.18), color)
	end
	for _, side in ipairs({ -1, 1 }) do
		triangle(model, 0.4, 0.5, 0.2, CFrame.new(side * 0.6, 1.1, 0.1), Color3.fromRGB(252, 250, 255))
	end
	-- awan tempat berpijak
	for i, p in ipairs({ { -0.8, 0.1 }, { 0, -0.2 }, { 0.8, 0.1 }, { 0.2, 0.6 } }) do
		blob(model, Vector3.new(1.2, 0.8, 1.1), CFrame.new(p[1], -1.15, p[2]), Color3.fromRGB(235, 244, 255))
	end
	addEffect(body, "sparkle", Color3.fromRGB(255, 170, 255))
	return body
end

function builders.phoenix(model)
	local gold = Color3.fromRGB(255, 176, 60)
	local body = chibi(model, { color = gold, belly = Color3.fromRGB(255, 236, 160), feet = false, mouth = false })
	triangle(model, 0.4, 0.34, 0.3, CFrame.new(0, -0.05, frontZ(0, -0.05) - 0.08) * CFrame.Angles(math.rad(180), 0, 0),
		Color3.fromRGB(255, 240, 200))
	for i, a in ipairs({ -28, 0, 28 }) do
		blob(model, Vector3.new(0.24, 0.8, 0.24), CFrame.new(0, 1.15, 0.15) * CFrame.Angles(0, 0, math.rad(a)) * CFrame.new(0, 0.3, 0),
			i == 2 and Color3.fromRGB(255, 90, 60) or Color3.fromRGB(255, 140, 60), NEON)
	end
	for _, side in ipairs({ -1, 1 }) do
		blob(model, Vector3.new(0.22, 1.1, 1.6), CFrame.new(side * 1.15, 0.25, 0.3) * CFrame.Angles(0, math.rad(side * 15), math.rad(side * -40)),
			Color3.fromRGB(255, 110, 50))
	end
	local tail
	for i, a in ipairs({ -18, 0, 18 }) do
		tail = blob(model, Vector3.new(0.3, 0.3, 1.5), CFrame.new(0, -0.4, 1.4) * CFrame.Angles(math.rad(25), math.rad(a), 0) * CFrame.new(0, 0, 0.4),
			i == 2 and Color3.fromRGB(255, 220, 90) or Color3.fromRGB(255, 120, 60), NEON)
	end
	addEffect(tail, "fire", Color3.fromRGB(255, 150, 40))
	return body
end

function builders.galaxy(model)
	local body = chibi(model, { color = Color3.fromRGB(70, 50, 150), eyeColor = Color3.fromRGB(20, 10, 60), feet = false })
	local stars = { { -0.6, 0.8, -0.3 }, { 0.7, 0.75, 0.1 }, { 0.2, 1.0, 0.5 }, { -0.9, -0.2, 0.5 }, { 0.95, -0.3, 0.4 }, { -0.3, 0.5, 0.9 } }
	for _, s in ipairs(stars) do
		blob(model, Vector3.new(0.14, 0.14, 0.14), CFrame.new(s[1], s[2], s[3]), Color3.fromRGB(255, 255, 210), NEON)
	end
	local ring = newPart(model, Vector3.new(0.08, 3.6, 3.6), CFrame.new(0, -0.1, 0) * CFrame.Angles(math.rad(14), 0, math.rad(90)),
		Color3.fromRGB(90, 230, 255), NEON)
	ring.Shape = Enum.PartType.Cylinder
	ring.Transparency = 0.45
	blob(model, Vector3.new(0.5, 0.5, 0.5), CFrame.new(1.7, 0.6, 0.4), Color3.fromRGB(255, 170, 230), NEON)
	addEffect(body, "sparkle", Color3.fromRGB(170, 140, 255))
	return body
end

local function customAsset(id)
	local folder = game:GetService("ReplicatedStorage"):FindFirstChild("AsetPet")
	local template = folder and folder:FindFirstChild(id)
	if template and template:IsA("Model") then
		local model = template:Clone()
		for _, d in ipairs(model:GetDescendants()) do
			if d:IsA("BasePart") then
				d.Anchored = true
				d.CanCollide = false
				d.CanQuery = false
				d.CanTouch = false
			end
		end
		model.PrimaryPart = model.PrimaryPart or model:FindFirstChildWhichIsA("BasePart", true)
		return model
	end
	return nil
end

-- Membuat model pet. Model menghadap -Z dengan titik pusat di badan pet.
function PetCatalog.Build(id)
	local pet = PetCatalog.Get(id) or PetCatalog.List[1]
	local custom = customAsset(pet.id)
	if custom then
		custom.Name = "Pet_" .. pet.id
		return custom
	end
	local model = Instance.new("Model")
	model.Name = "Pet_" .. pet.id
	local body = builders[pet.id](model)
	body.Name = "Badan"
	model.PrimaryPart = body
	model:ScaleTo(0.85)
	return model
end

return PetCatalog
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="5">
        <Properties>
          <string name="Name">Questions</string>
          <string name="Source"><![CDATA[--[[
	BANK SOAL - Jaringan Komputer & Internet (Informatika Kelas 7 SMP)

	CARA MENAMBAH SOAL:
	1) Pilihan ganda (4 pilihan):
	   { topik = "konsep", lv = 1, q = "Pertanyaan?", c = { "JAWABAN BENAR", "salah", "salah", "salah" }, e = "Penjelasan." },
	   -> Jawaban BENAR selalu ditulis PERTAMA. Urutan pilihan diacak otomatis di dalam game.
	2) Benar / Salah:
	   { topik = "konsep", lv = 1, bs = true, q = "Pernyataan.", jawab = true, e = "Penjelasan." },
	   -> jawab = true jika pernyataan BENAR, false jika SALAH.

	topik : konsep / topologi / perangkat / internet / koneksi / keamanan
	lv    : tingkat kesulitan 1 (mudah), 2 (sedang), 3 (sulit). Soal diurutkan dari mudah ke sulit.
	e     : penjelasan singkat yang muncul setelah jawaban diungkap (penting untuk belajar!)

	3) Isian / ketik jawaban (dipakai mode "Pecahkan Sandi"), ada di Questions.Isian di bawah:
	   { topik = "perangkat", lv = 1, q = "Perangkat pemilih rute data disebut ...", jawab = { "Router" }, e = "Penjelasan." },
	   -> jawab boleh berisi beberapa jawaban yang diterima. Huruf besar/kecil & spasi diabaikan.
	4) Kata untuk teka-teki Caesar Cipher ada di Questions.CipherWords (huruf A-Z saja).
]]

local Questions = {}

Questions.List = {
	---------------------------------------------------------------
	-- KONSEP JARINGAN KOMPUTER
	---------------------------------------------------------------
	{ topik = "konsep", lv = 1, q = "Apa yang dimaksud dengan jaringan komputer?",
		c = { "Dua atau lebih perangkat yang terhubung untuk berbagi data", "Satu komputer yang memiliki banyak aplikasi", "Kumpulan kabel listrik di rumah", "Program untuk mengetik dokumen" },
		e = "Jaringan komputer adalah dua atau lebih perangkat yang saling terhubung sehingga bisa berbagi data dan sumber daya." },
	{ topik = "konsep", lv = 1, q = "Jaringan komputer di dalam satu lab komputer sekolah termasuk jenis...",
		c = { "LAN", "WAN", "MAN", "Internet" },
		e = "LAN (Local Area Network) mencakup area kecil seperti satu ruangan, gedung, atau sekolah." },
	{ topik = "konsep", lv = 1, q = "Menghubungkan HP ke earphone Bluetooth adalah contoh jaringan...",
		c = { "PAN", "LAN", "MAN", "WAN" },
		e = "PAN (Personal Area Network) adalah jaringan pribadi jarak sangat dekat, sekitar 10 meter." },
	{ topik = "konsep", lv = 2, q = "Jaringan yang mencakup satu kota, misalnya jaringan CCTV milik pemerintah kota, disebut...",
		c = { "MAN", "PAN", "LAN", "Peer-to-Peer" },
		e = "MAN (Metropolitan Area Network) mencakup wilayah satu kota." },
	{ topik = "konsep", lv = 2, q = "Jaringan dengan jangkauan paling LUAS adalah...",
		c = { "WAN", "MAN", "LAN", "PAN" },
		e = "Urutan dari yang paling sempit: PAN < LAN < MAN < WAN. WAN bisa mencakup antarnegara." },
	{ topik = "konsep", lv = 1, bs = true, q = "Internet adalah contoh jaringan WAN yang paling besar di dunia.", jawab = true,
		e = "Benar! Internet menghubungkan jaringan di seluruh dunia, sehingga termasuk WAN terbesar." },
	{ topik = "konsep", lv = 1, bs = true, q = "Salah satu manfaat jaringan komputer adalah satu printer bisa dipakai bersama oleh banyak komputer.", jawab = true,
		e = "Benar! Berbagi printer, file, dan koneksi internet adalah manfaat utama jaringan komputer." },
	{ topik = "konsep", lv = 2, q = "Jaringan di mana semua komputer memiliki kedudukan setara (tanpa server pusat) disebut...",
		c = { "Peer-to-Peer", "Client-Server", "Topologi Bus", "Router" },
		e = "Pada Peer-to-Peer semua komputer setara. Pada Client-Server ada server pusat yang melayani client." },
	{ topik = "konsep", lv = 2, bs = true, q = "Pada jaringan Client-Server, komputer yang melayani permintaan disebut client.", jawab = false,
		e = "Salah! Komputer yang MELAYANI disebut SERVER. Client adalah komputer yang MEMINTA layanan." },
	{ topik = "konsep", lv = 3, q = "Bank yang menghubungkan kantor cabangnya di Jakarta, Medan, dan Makassar menggunakan jaringan...",
		c = { "WAN", "LAN", "PAN", "MAN" },
		e = "Karena menghubungkan beberapa kota yang berjauhan (antarpulau), jaringannya adalah WAN." },
	{ topik = "konsep", lv = 3, q = "Berikut ini yang BUKAN manfaat jaringan komputer adalah...",
		c = { "Membuat komputer kebal dari virus", "Berbagi file dengan cepat", "Berbagi koneksi internet", "Berkomunikasi lewat email" },
		e = "Jaringan justru bisa menjadi jalan masuk virus. Karena itu keamanan jaringan tetap harus dijaga." },

	---------------------------------------------------------------
	-- TOPOLOGI JARINGAN
	---------------------------------------------------------------
	{ topik = "topologi", lv = 1, q = "Bentuk atau susunan hubungan antar perangkat dalam jaringan disebut...",
		c = { "Topologi", "Protokol", "Bandwidth", "Domain" },
		e = "Topologi adalah bentuk/susunan cara perangkat-perangkat dihubungkan dalam jaringan." },
	{ topik = "topologi", lv = 1, q = "Topologi di mana semua komputer terhubung ke satu titik pusat (switch/hub) adalah...",
		c = { "Star", "Bus", "Ring", "Mesh" },
		e = "Topologi Star (bintang) memiliki pusat berupa switch atau hub, bentuknya seperti bintang." },
	{ topik = "topologi", lv = 1, q = "Topologi yang memakai satu kabel utama (backbone) untuk semua komputer adalah...",
		c = { "Bus", "Star", "Tree", "Mesh" },
		e = "Topologi Bus memakai satu kabel utama. Ujung kabelnya dipasang terminator." },
	{ topik = "topologi", lv = 1, q = "Topologi yang bentuknya melingkar seperti cincin adalah...",
		c = { "Ring", "Star", "Bus", "Tree" },
		e = "Pada topologi Ring, komputer membentuk lingkaran dan data berputar dari satu komputer ke komputer berikutnya." },
	{ topik = "topologi", lv = 2, q = "Pada topologi Star, apa yang terjadi jika switch pusatnya rusak?",
		c = { "Seluruh jaringan terganggu", "Hanya satu komputer yang terganggu", "Jaringan menjadi lebih cepat", "Tidak terjadi apa-apa" },
		e = "Switch/hub adalah pusat topologi Star. Jika pusatnya rusak, semua komputer tidak bisa saling terhubung." },
	{ topik = "topologi", lv = 2, bs = true, q = "Pada topologi Star, jika satu kabel komputer putus, maka seluruh jaringan ikut mati.", jawab = false,
		e = "Salah! Pada topologi Star, kabel yang putus hanya mengganggu satu komputer itu saja." },
	{ topik = "topologi", lv = 2, bs = true, q = "Pada topologi Bus, jika kabel utama (backbone) putus maka jaringan akan terganggu.", jawab = true,
		e = "Benar! Semua komputer bergantung pada kabel utama, jadi kabel utama putus = jaringan terganggu." },
	{ topik = "topologi", lv = 2, q = "Topologi yang setiap komputernya terhubung langsung ke SEMUA komputer lain adalah...",
		c = { "Mesh", "Star", "Bus", "Ring" },
		e = "Topologi Mesh sangat andal karena banyak jalur cadangan, tetapi membutuhkan banyak kabel." },
	{ topik = "topologi", lv = 2, q = "Topologi gabungan beberapa topologi star yang bertingkat seperti cabang disebut...",
		c = { "Tree", "Ring", "Bus", "Mesh" },
		e = "Topologi Tree (pohon) tersusun bertingkat, cocok untuk gedung dengan banyak lantai/ruangan." },
	{ topik = "topologi", lv = 3, q = "Berapa jumlah kabel yang dibutuhkan untuk menghubungkan 4 komputer dengan topologi Mesh?",
		c = { "6", "4", "8", "12" },
		e = "Rumus Mesh: n x (n - 1) / 2 = 4 x 3 / 2 = 6 kabel." },
	{ topik = "topologi", lv = 3, q = "Berapa kabel yang dibutuhkan untuk menghubungkan 5 komputer dengan topologi Mesh?",
		c = { "10", "5", "20", "25" },
		e = "Rumus Mesh: n x (n - 1) / 2 = 5 x 4 / 2 = 10 kabel." },
	{ topik = "topologi", lv = 3, q = "Kekurangan utama topologi Mesh adalah...",
		c = { "Membutuhkan kabel yang sangat banyak", "Jika satu kabel putus semua mati", "Tidak bisa dipakai berbagi data", "Hanya bisa 2 komputer" },
		e = "Mesh paling andal, tetapi mahal dan rumit karena setiap komputer harus terhubung ke semua komputer lain." },

	---------------------------------------------------------------
	-- PERANGKAT JARINGAN
	---------------------------------------------------------------
	{ topik = "perangkat", lv = 1, q = "Perangkat yang menghubungkan dua jaringan berbeda dan menentukan jalur data adalah...",
		c = { "Router", "Hub", "Mouse", "Speaker" },
		e = "Router menghubungkan jaringan berbeda (misal jaringan rumah ke internet) dan memilih rute terbaik." },
	{ topik = "perangkat", lv = 1, q = "Konektor yang dipasang di ujung kabel UTP adalah...",
		c = { "RJ-45", "USB", "HDMI", "VGA" },
		e = "Kabel UTP menggunakan konektor RJ-45 untuk dipasang ke komputer, switch, atau router." },
	{ topik = "perangkat", lv = 1, q = "Kartu jaringan yang dipasang di komputer agar bisa terhubung ke jaringan disebut...",
		c = { "NIC (Network Interface Card)", "VGA Card", "Sound Card", "RAM" },
		e = "NIC atau LAN Card adalah kartu jaringan. Setiap NIC memiliki alamat fisik unik bernama MAC Address." },
	{ topik = "perangkat", lv = 2, q = "Apa perbedaan SWITCH dengan HUB?",
		c = { "Switch mengirim data hanya ke komputer tujuan", "Switch mengirim data ke semua komputer", "Hub lebih pintar daripada switch", "Switch tidak memakai kabel" },
		e = "Hub meneruskan data ke SEMUA port, sedangkan switch lebih pintar karena hanya mengirim ke port TUJUAN." },
	{ topik = "perangkat", lv = 2, q = "Modem adalah singkatan dari...",
		c = { "Modulator - Demodulator", "Modern Demo", "Mode Memori", "Monitor Demodulasi" },
		e = "Modem = Modulator-Demodulator, mengubah sinyal digital menjadi analog dan sebaliknya." },
	{ topik = "perangkat", lv = 2, q = "Perangkat yang memancarkan sinyal WiFi agar laptop dan HP bisa terhubung tanpa kabel adalah...",
		c = { "Access Point", "Hub", "Printer", "Kabel UTP" },
		e = "Access Point memancarkan sinyal WiFi. Router WiFi di rumah biasanya sudah memiliki fungsi access point." },
	{ topik = "perangkat", lv = 2, bs = true, q = "Repeater berfungsi untuk memperkuat sinyal agar jangkauan jaringan menjadi lebih jauh.", jawab = true,
		e = "Benar! Repeater menerima sinyal yang melemah lalu memancarkannya kembali agar lebih kuat." },
	{ topik = "perangkat", lv = 1, bs = true, q = "Mouse dan keyboard termasuk perangkat jaringan.", jawab = false,
